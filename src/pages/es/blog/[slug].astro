---
import Post from '@/views/Post.astro';
import { getPosts, postSlug, type Post as PostEntry } from '@/lib/blog';
export async function getStaticPaths() {
  const posts = await getPosts('es');
  return posts.map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}
const { post } = Astro.props as { post: PostEntry };
---
<Post lang="es" post={post} />
