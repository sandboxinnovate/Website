---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import { HOME } from '@/i18n/home';
import type { Lang } from '@/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const f = HOME.faq;
---
<section class="fq section-y" id="faq" aria-labelledby="fq-title">
  <div class="container-x fq__grid">
    <div class="fq__head">
      <SectionHeading id="fq-title" index={f.index} eyebrow={f.eyebrow[lang]} title={f.title[lang]} />
    </div>
    <div class="fq__list" data-faq>
      {f.items.map((it, i) => (
        <details class="fq__item" data-reveal style={`--reveal-delay:${i * 60}`} name="home-faq">
          <summary>
            <span class="fq__n mono-label">{String(i + 1).padStart(2, '0')}</span>
            <span class="fq__q">{it.q[lang]}</span>
            <span class="fq__icon" aria-hidden="true"><Icon name="plus" size={16} stroke={2} /></span>
          </summary>
          <div class="fq__a"><p>{it.a[lang]}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .fq__grid { display: grid; gap: 40px; }
  @media (min-width: 1000px) { .fq__grid { grid-template-columns: 5fr 7fr; gap: 64px; } .fq__head { position: sticky; top: calc(var(--nav-h) + 40px); align-self: start; } }
  .fq__list { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
  .fq__item { border-bottom: 1px solid var(--line); }
  .fq__item summary { list-style: none; display: grid; grid-template-columns: 36px 1fr 36px; align-items: center; gap: 12px; padding: 22px 0; cursor: pointer; }
  .fq__item summary::-webkit-details-marker { display: none; }
  .fq__q { font-family: var(--font-display); font-size: clamp(1.02rem, 1.4vw, 1.2rem); letter-spacing: -.02em; line-height: 1.3; transition: color .2s; }
  .fq__item summary:hover .fq__q { color: var(--color-flame-400); }
  .fq__icon { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; background: rgb(245 131 39 / .12); color: var(--color-flame-400); transition: transform .5s var(--ease-out-expo), background-color .3s; }
  .fq__item[open] .fq__icon { transform: rotate(45deg); background: var(--color-flame-500); color: #1a0d03; }
  .fq__a { overflow: hidden; }
  .fq__a p { padding: 0 48px 24px 48px; color: var(--color-mist); max-width: 680px; }
  @media (max-width: 600px) { .fq__a p { padding: 0 0 22px 48px; } }
  /* Smooth open animation where supported */
  @supports (interpolate-size: allow-keywords) {
    .fq__item { interpolate-size: allow-keywords; }
    .fq__item::details-content { height: 0; overflow: clip; transition: height .5s var(--ease-out-expo), content-visibility .5s allow-discrete; }
    .fq__item[open]::details-content { height: auto; }
  }
</style>
