---
/**
 * Compact post card (home "Field notes", unit pages "Related reading", post "Keep reading").
 * Cover on top, then unit · reading time · date, title and (optionally) the dek.
 * Stretched-link card: the link is the title (clean accessible name); its ::after covers the card.
 */
import Icon from '@/components/ui/Icon.astro';
import PostCover from './PostCover.astro';
import { BLOG } from '@/i18n/blog';
import { postHref, readingMinutes, unitOf, formatDate, isoDate, type Post } from '@/lib/blog';
import type { Lang } from '@/i18n';

interface Props {
  post: Post;
  lang: Lang;
  as?: 'h2' | 'h3';
  dek?: boolean;
  class?: string;
  style?: string;
}
const { post, lang, as: H = 'h3', dek = true, class: cls = '', style } = Astro.props;
const u = unitOf(post);
const d = post.data;
---
<article class:list={['pcard', cls]} style={style} data-card data-reveal>
  <PostCover seed={d.translationKey} unit={d.unit} variant="card" class="pcard__cover" />
  <p class="pcard__meta">
    <span class="pcard__unit">{u.name[lang]}</span>
    <span class="pcard__dot" aria-hidden="true">·</span>
    <span>{BLOG.post.minRead[lang](readingMinutes(post))}</span>
    <span class="pcard__dot" aria-hidden="true">·</span>
    <time datetime={isoDate(d.date)}>{formatDate(d.date, lang, 'short')}</time>
  </p>
  <H class="pcard__title"><a href={postHref(post)} class="pcard__link">{d.title}</a></H>
  {dek && <p class="pcard__dek">{d.dek}</p>}
  <span class="pcard__go" aria-hidden="true"><Icon name="arrow-up-right" size={16} /></span>
</article>

<style>
  .pcard { position: relative; display: flex; flex-direction: column; gap: 12px; min-width: 0; padding: 10px 10px 24px; border-radius: 22px;
    border: 1px solid var(--line); background: linear-gradient(180deg, rgb(255 255 255 / .03), rgb(255 255 255 / .008)), var(--color-ink-900);
    transition: border-color .4s; }
  .pcard:hover { border-color: rgb(245 131 39 / .35); }
  .pcard:has(.pcard__link:focus-visible) { outline: 2px solid var(--color-flame-400); outline-offset: 3px; }
  .pcard__link:focus-visible { outline: none; }
  .pcard__link::after { content: ''; position: absolute; inset: 0; border-radius: inherit; z-index: 2; }
  .pcard :global(.pcard__cover) { border-radius: 14px; margin-bottom: 6px; }
  .pcard__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; padding: 0 10px; font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--color-smoke); }
  .pcard__unit { color: var(--color-flame-400); }
  .pcard__dot { opacity: .6; }
  .pcard__title { padding: 0 46px 0 10px; font-size: clamp(1.08rem, 1.5vw, 1.26rem); line-height: 1.22; letter-spacing: -.025em; transition: color .3s; }
  .pcard:hover .pcard__title { color: var(--color-flame-400); }
  .pcard__dek { padding: 0 10px; font-size: 15px; line-height: 1.55; color: var(--color-mist); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .pcard__go { position: absolute; right: 18px; bottom: 22px; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 99px; border: 1px solid var(--line-strong); color: var(--color-mist); transition: transform .5s var(--ease-out-expo), color .3s, border-color .3s; }
  .pcard:has(.pcard__dek) .pcard__go { display: none; }
  .pcard:has(.pcard__dek) .pcard__title { padding-right: 10px; }
  .pcard:hover .pcard__go { transform: rotate(45deg); color: var(--color-flame-400); border-color: rgb(245 131 39 / .5); }
  @media (prefers-reduced-motion: reduce) { .pcard__go { transition: none; } }
</style>
