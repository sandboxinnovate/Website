---
/**
 * Share a post: copy link (JS), LinkedIn, X, WhatsApp, email (plain links, work without JS).
 *   variant="rail": vertical icon stack (sticky desktop rail)
 *   variant="row": labelled row at the end of the article
 */
import { BLOG } from '@/i18n/blog';
import type { Lang } from '@/i18n';

interface Props { lang: Lang; url: string; title: string; dek: string; variant?: 'rail' | 'row' }
const { lang, url, title, dek, variant = 'row' } = Astro.props;
const P = BLOG.post;
const e = encodeURIComponent;
const links = [
  { id: 'linkedin', name: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${e(url)}`, label: P.shareOn[lang]('LinkedIn'),
    icon: '<path d="M6.5 9.5v8M6.5 6.2v.1"/><path d="M10.5 17.5v-8M10.5 13c0-2 1.2-3.6 3.2-3.6s3 1.3 3 3.6v4.5"/><rect x="3" y="3" width="18" height="18" rx="4"/>' },
  { id: 'x', name: 'X', href: `https://x.com/intent/post?text=${e(title)}&url=${e(url)}`, label: P.shareOn[lang]('X'),
    icon: '<path d="M4.5 4.5 19.5 19.5M19.5 4.5l-6.3 6.6M10.8 13l-6.3 6.5"/>' },
  { id: 'whatsapp', name: 'WhatsApp', href: `https://wa.me/?text=${e(`${title} ${url}`)}`, label: P.shareOn[lang]('WhatsApp'),
    icon: '<path d="M20.5 12a8.5 8.5 0 0 1-12.6 7.4L3.5 20.5l1.2-4.3A8.5 8.5 0 1 1 20.5 12Z"/><path d="M9 8.6c.2-.4.5-.5.8-.5h.5c.2 0 .4.1.5.4l.7 1.6c.1.2 0 .5-.1.7l-.5.6c.6 1.2 1.6 2.2 2.8 2.8l.6-.5c.2-.2.5-.2.7-.1l1.6.7c.3.1.4.3.4.5v.5c0 .3-.1.6-.5.8-.6.4-1.5.5-2.3.2a9 9 0 0 1-5-5c-.3-.8-.2-1.7.2-2.3Z"/>' },
  { id: 'email', name: 'Email', href: `mailto:?subject=${e(title)}&body=${e(`${dek}\n\n${url}`)}`, label: P.shareEmail[lang],
    icon: '<rect x="3.5" y="5.5" width="17" height="13" rx="2.5"/><path d="m4 7 8 6 8-6"/>' },
];
const linkIcon = '<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/>';
const svg = (paths: string) => `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${paths}</svg>`;
---
<div class:list={['shr', `shr--${variant}`]} role="group" aria-label={P.shareTitle[lang]} data-share>
  <span class="mono-label shr__label" aria-hidden="true">{P.share[lang]}</span>
  <button type="button" class="shr__btn shr__copy" data-share-copy data-url={url} data-ok={P.copied[lang]} data-fail={P.copyFailed[lang]} aria-label={variant === 'rail' ? P.copyLink[lang] : undefined}>
    <Fragment set:html={svg(linkIcon)} />
    {variant === 'row' && <span>{P.copyLink[lang]}</span>}
  </button>
  {links.map((l) => (
    <a class="shr__btn" href={l.href} target={l.id === 'email' ? undefined : '_blank'} rel={l.id === 'email' ? undefined : 'noopener noreferrer'} aria-label={variant === 'rail' ? l.label : undefined} title={variant === 'rail' ? l.label : undefined}>
      <Fragment set:html={svg(l.icon)} />
      {variant === 'row' && <span>{l.name}</span>}
    </a>
  ))}
  <span class="shr__status" role="status" aria-live="polite" data-share-status></span>
</div>

<style>
  .shr { position: relative; display: flex; align-items: center; gap: 8px; }
  .shr--row { flex-wrap: wrap; }
  .shr--rail { flex-direction: column; align-items: flex-start; gap: 6px; }
  .shr__label { margin-right: 6px; }
  .shr--rail .shr__label { margin: 0 0 6px; }
  .shr__btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 40px; min-width: 40px; padding: 0 14px 0 12px; border-radius: 99px;
    border: 1px solid var(--line-strong); background: rgb(255 255 255 / .02); color: var(--color-mist); font-size: 14px; cursor: pointer;
    transition: color .25s, border-color .25s, background-color .25s; }
  .shr--rail .shr__btn { width: 40px; padding: 0; }
  .shr__btn:hover { color: var(--color-bone); border-color: rgb(245 131 39 / .5); background: rgb(245 131 39 / .06); }
  .shr__btn :global(svg) { flex: none; }
  :global(.no-js) .shr__copy { display: none; }
  .shr__copy.is-done { color: var(--color-ok); border-color: rgb(122 209 155 / .5); }
  .shr__status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .shr--row .shr__status:not(:empty) { position: static; width: auto; height: auto; clip: auto; overflow: visible; font-size: 13.5px; color: var(--color-ok); margin-left: 4px; }
</style>
