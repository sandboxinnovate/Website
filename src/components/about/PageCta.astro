---
/**
 * Closing call to action shared by the About and Work pages.
 * `title` accepts HTML (<em> for the flame accent).
 */
import Icon from '@/components/ui/Icon.astro';

interface Link { href: string; label: string }
interface Props { title: string; body: string; primary: Link; secondary?: Link; id?: string }
const { title, body, primary, secondary, id = 'page-cta' } = Astro.props;
---
<section class="pc" aria-labelledby={id}>
  <div class="container-x">
    <div class="pc__card" data-reveal>
      <div class="pc__glow glow-ember" aria-hidden="true"></div>
      <div class="pc__grid bg-grid" aria-hidden="true"></div>
      <div class="pc__copy">
        <h2 id={id} class="pc__title display-lg" set:html={title} />
        <p class="lede pc__body">{body}</p>
      </div>
      <div class="pc__ctas">
        <a href={primary.href} class="btn btn-primary">
          <span>{primary.label}</span><span class="btn-chip"><Icon name="arrow-up-right" size={16} stroke={1.8} /></span>
        </a>
        {secondary && (
          <a href={secondary.href} class="btn btn-ghost">
            <span>{secondary.label}</span><span class="btn-chip"><Icon name="arrow-right" size={16} stroke={1.8} /></span>
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .pc { padding-block: clamp(40px, 6vw, 80px) clamp(80px, 10vw, 140px); }
  .pc__card { position: relative; isolation: isolate; overflow: hidden; display: grid; gap: 36px; align-items: end;
    padding: clamp(32px, 6vw, 72px); border-radius: var(--radius-xl2); border: 1px solid var(--line);
    background: linear-gradient(180deg, rgb(255 255 255 / .03), transparent), var(--color-ink-900); box-shadow: inset 0 1px 0 rgb(255 255 255 / .06); }
  @media (min-width: 960px) { .pc__card { grid-template-columns: minmax(0, 1.4fr) auto; } }
  .pc__glow { z-index: -1; width: 70%; height: 140%; right: -20%; bottom: -70%; opacity: .6; }
  .pc__grid { position: absolute; inset: 0; z-index: -1; opacity: .5; }
  .pc__copy { display: flex; flex-direction: column; gap: 20px; }
  .pc__title { max-width: 16ch; }
  .pc__title :global(em) { font-style: normal; background: var(--grad-text); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .pc__body { max-width: 520px; }
  .pc__ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (min-width: 960px) { .pc__ctas { flex-direction: column; align-items: stretch; } .pc__ctas .btn { justify-content: space-between; } }
</style>
