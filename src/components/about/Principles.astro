---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { ABOUT } from '@/i18n/about';
import type { Lang } from '@/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = ABOUT.principles;
---
<section class="pr section-y" aria-label={p.eyebrow[lang]}>
  <div class="container-x pr__grid">
    <div class="pr__head">
      <SectionHeading index={p.index} eyebrow={p.eyebrow[lang]} title={p.title[lang]} lede={p.lede[lang]} />
      <p class="pr__count mono-label" aria-hidden="true"><span>{String(p.items.length).padStart(2, '0')}</span> {lang === 'en' ? 'rules · no exceptions' : 'reglas · sin excepciones'}</p>
    </div>

    <ol class="pr__list">
      {p.items.map((it, i) => (
        <li class="pr__item" data-reveal style={`--reveal-delay:${(i % 3) * 90}`}>
          <span class="pr__no mono-label" aria-hidden="true">P/{String(i + 1).padStart(2, '0')}</span>
          <h3 class="pr__title">{it.title[lang]}</h3>
          <p class="pr__body">{it.body[lang]}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .pr { position: relative; border-top: 1px solid var(--line); }
  .pr__grid { display: grid; gap: 56px; }
  @media (min-width: 1024px) { .pr__grid { grid-template-columns: minmax(0, .9fr) minmax(0, 1.4fr); gap: 80px; align-items: start; } }
  .pr__head { display: flex; flex-direction: column; gap: 32px; }
  @media (min-width: 1024px) { .pr__head { position: sticky; top: calc(var(--nav-h) + 40px); } }
  .pr__count span { color: var(--color-flame-400); }

  .pr__list { display: flex; flex-direction: column; counter-reset: pr; }
  .pr__item { position: relative; display: grid; gap: 10px 32px; padding: 30px 0 32px; border-top: 1px solid var(--line); grid-template-columns: 1fr; }
  .pr__item:last-child { border-bottom: 1px solid var(--line); }
  @media (min-width: 720px) {
    .pr__item { grid-template-columns: 64px minmax(0, 1.15fr) minmax(0, 1fr); align-items: baseline; padding: 36px 0 38px; }
  }
  /* Ember line that ignites along the top hairline on hover */
  .pr__item::before { content: ""; position: absolute; left: 0; right: 0; top: -1px; height: 1px; background: linear-gradient(90deg, var(--color-sun), var(--color-flame-500) 40%, transparent); transform: scaleX(0); transform-origin: left; transition: transform 1s var(--ease-out-expo); }
  .pr__item:hover::before { transform: scaleX(1); }
  .pr__no { transition: color .3s; }
  .pr__item:hover .pr__no { color: var(--color-flame-400); }
  .pr__title { font-size: clamp(1.25rem, 1.9vw, 1.6rem); line-height: 1.12; letter-spacing: -.03em; }
  .pr__body { color: var(--color-mist); font-size: 16px; }
  @media (prefers-reduced-motion: reduce) { .pr__item::before { transition: none; } }
</style>
