---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { ABOUT } from '@/i18n/about';
import { UNITS } from '@/data/site';
import type { Lang } from '@/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = ABOUT.story;
const d = s.diagram;
const pad = (n: number) => String(n).padStart(2, '0');

/* ---- Diagram geometry (viewBox 560 × 560, centre 280/280) ---- */
const C = 280;
const diag = [[-1, -1], [1, -1], [1, 1], [-1, 1]] as const; // services sit on the diagonals
const services = d.services[lang].map((label, i) => {
  const [dx, dy] = diag[i];
  return { label, x: C + dx * 99, y: C + dy * 99, ax: C + dx * 161, ay: C + dy * 161, ai: d.ai[lang][i], dx, dy };
});
const axes = [[0, -1], [1, 0], [0, 1], [-1, 0]] as const; // client systems sit on the axes
const clients = axes.map(([dx, dy], i) => ({ x: C + dx * 226, y: C + dy * 226, dx, dy, i }));
const units = UNITS.map((u, k) => {
  const a = (-90 + k * 60) * (Math.PI / 180);
  return { code: u.code, name: u.name[lang], x: C + Math.cos(a) * 178, y: C + Math.sin(a) * 178 };
});
const gid = 'st-cube';
---
<section class="st section-y" id="story" aria-label={s.eyebrow[lang]} data-story>
  <div class="container-x">
    <SectionHeading index={s.index} eyebrow={s.eyebrow[lang]} title={s.title[lang]} lede={s.lede[lang]} />

    <div class="st__layout">
      <!-- Sticky panel (desktop): a map of the company that rewires itself as you scroll -->
      <div class="st__panel-wrap" aria-hidden="true">
        <div class="st__panel card" data-panel data-phase="4">
          <div class="st__panel-head">
            <span class="mono-label">{s.phaseWord[lang]} <b class="st__ph-num" data-ph-num>04</b> / 04</span>
            <span class="st__ph-tag" data-ph-tag>{s.phases[3].tag[lang]}</span>
          </div>

          <svg class="st__svg" viewBox="0 0 560 560" role="presentation">
            <defs>
              <linearGradient id={gid} x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#FFD21F" /><stop offset=".42" stop-color="#F7921E" /><stop offset="1" stop-color="#E2540C" />
              </linearGradient>
              <radialGradient id="st-core-glow">
                <stop offset="0" stop-color="#d94c00" stop-opacity=".55" /><stop offset="1" stop-color="#d94c00" stop-opacity="0" />
              </radialGradient>
            </defs>

            <!-- Blueprint guides -->
            <g class="st-guides">
              <circle cx={C} cy={C} r="99" /><circle cx={C} cy={C} r="178" /><circle cx={C} cy={C} r="250" />
              <line x1={C} y1="16" x2={C} y2="544" /><line x1="16" y1={C} x2="544" y2={C} />
            </g>

            <!-- Phase 1 · services around the agency -->
            <g class="st-p st-p1">
              {services.map((sv) => (
                <line class="st-edge" x1={C + sv.dx * 36} y1={C + sv.dy * 36} x2={sv.x - sv.dx * 30} y2={sv.y - sv.dy * 12} />
              ))}
              {services.map((sv) => (
                <g class="st-node" transform={`translate(${sv.x} ${sv.y})`}>
                  <rect x="-46" y="-17" width="92" height="34" rx="17" />
                  <text y="4" text-anchor="middle">{sv.label}</text>
                </g>
              ))}
            </g>

            <!-- Phase 2 · AI helpers on our own desk -->
            <g class="st-p st-p2">
              <circle class="st-ring" cx={C} cy={C} r="62" />
              {services.map((sv) => (
                <line class="st-edge st-edge--ai" x1={sv.x + sv.dx * 20} y1={sv.y + sv.dy * 20} x2={sv.ax - sv.dx * 22} y2={sv.ay - sv.dy * 10} />
              ))}
              {services.map((sv) => (
                <g class="st-chip" transform={`translate(${sv.ax} ${sv.ay})`}>
                  <rect x="-50" y="-13" width="100" height="26" rx="6" />
                  <circle cx="-38" cy="0" r="3" class="st-chip-dot" />
                  <text x="6" y="4" text-anchor="middle">{sv.ai}</text>
                </g>
              ))}
            </g>

            <!-- Phase 3 · systems built inside client companies -->
            <g class="st-p st-p3">
              {clients.map((c) => (
                <line class="st-edge st-edge--flow" x1={C + c.dx * 64} y1={C + c.dy * 64} x2={c.x - c.dx * 50} y2={c.y - c.dy * 32} style={`--k:${c.i}`} />
              ))}
              {clients.map((c) => (
                <g class="st-client" transform={`translate(${c.x} ${c.y})`}>
                  <rect x="-50" y="-32" width="100" height="64" rx="10" />
                  <text class="st-client-l" x="-44" y="-14">{d.client[lang]}·{String.fromCharCode(65 + c.i)}</text>
                  <rect class="st-mini" x="-44" y="-4" width="42" height="24" rx="5" />
                  <text class="st-mini-t" x="-23" y="12" text-anchor="middle">{d.clientParts[lang][0]}</text>
                  <rect class="st-mini" x="2" y="-4" width="42" height="24" rx="5" />
                  <text class="st-mini-t" x="23" y="12" text-anchor="middle">{d.clientParts[lang][1]}</text>
                </g>
              ))}
            </g>

            <!-- Phase 4 · six units -->
            <g class="st-p st-p4">
              <circle class="st-orbit" cx={C} cy={C} r="178" />
              {units.map((u) => (
                <line class="st-edge st-edge--unit" x1={C} y1={C} x2={u.x} y2={u.y} />
              ))}
              {units.map((u) => (
                <g class="st-unit" transform={`translate(${u.x} ${u.y})`}>
                  <rect x="-60" y="-17" width="120" height="34" rx="17" />
                  <text class="st-unit-code" x="-44" y="4">{u.code}</text>
                  <text class="st-unit-name" x="-24" y="4.5">{u.name}</text>
                </g>
              ))}
            </g>

            <!-- Core: always on -->
            <g class="st-core">
              <circle cx={C} cy={C} r="90" fill="url(#st-core-glow)" class="st-core-glow" />
              <circle cx={C} cy={C} r="36" class="st-core-disc" />
              <path transform={`translate(${C} ${C}) scale(.4) translate(-50 -50)`} fill={`url(#${gid})`} fill-rule="evenodd"
                d="M50 6L88.11 28L88.11 72L50 94L11.89 72L11.89 28ZM50 44.28L78.2 28L65.62 20.74L50 25.36L34.38 20.74L21.8 28ZM47.14 54.07L16.85 36.58L16.85 49.78L32.09 58.58L32.09 77.94L47.14 86.63ZM52.86 54.07L83.15 36.58L83.15 49.78L67.91 58.58L67.91 77.94L52.86 86.63Z" />
            </g>
          </svg>

          <div class="st__bar">
            {s.phases.map((_, i) => <span class="st__seg" style={`--i:${i}`}></span>)}
          </div>
        </div>
      </div>

      <!-- Steps -->
      <div class="st__steps" data-steps>
        <span class="st__rail" aria-hidden="true"><span class="st__rail-fill"></span></span>
        <ol class="st__list">
        {s.phases.map((p, i) => (
          <li class="st__step" data-step={i + 1} data-tag={p.tag[lang]}>
            <span class="st__dot" aria-hidden="true"></span>
            <div class="st__step-meta">
              <span class="mono-label st__step-num">{s.phaseWord[lang]} {pad(i + 1)}</span>
              <span class="st__step-tag">{p.tag[lang]}</span>
            </div>
            <h3 class="st__step-title">{p.title[lang]}</h3>
            <p class="st__step-body">{p.body[lang]}</p>
            <ul class="st__notes" aria-label={p.tag[lang]}>
              {p.notes[lang].map((n) => <li>{n}</li>)}
            </ul>
          </li>
        ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-story]').forEach((root) => {
    const panel = root.querySelector<HTMLElement>('[data-panel]')!;
    const num = root.querySelector<HTMLElement>('[data-ph-num]')!;
    const tag = root.querySelector<HTMLElement>('[data-ph-tag]')!;
    const list = root.querySelector<HTMLElement>('[data-steps]')!;
    const steps = Array.from(root.querySelectorAll<HTMLElement>('[data-step]'));
    root.classList.add('is-live');

    let active = 0;
    const setActive = (n: number) => {
      if (n === active) return;
      active = n;
      panel.dataset.phase = String(n);
      num.textContent = String(n).padStart(2, '0');
      tag.textContent = steps[n - 1]?.dataset.tag ?? '';
      steps.forEach((s, i) => { s.classList.toggle('is-active', i === n - 1); s.classList.toggle('is-past', i < n - 1); });
    };
    setActive(1);

    // Which step is in the middle of the viewport?
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) setActive(Number((e.target as HTMLElement).dataset.step)); });
    }, { rootMargin: '-45% 0px -50% 0px' });
    steps.forEach((s) => io.observe(s));

    // Rail fill follows the scroll position (rAF-throttled, passive listener).
    let raf = 0;
    const measure = () => {
      raf = 0;
      const r = list.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight * 0.5 - r.top) / r.height));
      list.style.setProperty('--p', p.toFixed(4));
    };
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(measure); };

    // Only listen while the section is on screen; pause ambient animation off screen / in background tabs.
    let onScreen = false;
    const sync = () => root.classList.toggle('is-paused', !onScreen || document.hidden);
    new IntersectionObserver(([e]) => {
      onScreen = e.isIntersecting;
      if (onScreen) { addEventListener('scroll', onScroll, { passive: true }); measure(); }
      else removeEventListener('scroll', onScroll);
      sync();
    }).observe(root);
    document.addEventListener('visibilitychange', sync);
  });
</script>

<style>
  .st__layout { display: grid; gap: 48px; margin-top: clamp(48px, 7vw, 96px); }
  @media (min-width: 1024px) { .st__layout { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(48px, 6vw, 96px); } }

  /* ---------- Panel ---------- */
  .st__panel-wrap { display: none; }
  @media (min-width: 1024px) {
    .st__panel-wrap { display: block; }
    .st__panel { position: sticky; top: calc(var(--nav-h) + 28px); }
  }
  .st__panel { display: flex; flex-direction: column; gap: 8px; padding: 22px 22px 20px; overflow: hidden;
    background: radial-gradient(80% 60% at 50% 50%, rgb(217 76 0 / .08), transparent 70%), linear-gradient(180deg, rgb(255 255 255 / .03), rgb(255 255 255 / .005)), var(--color-ink-900); }
  .st__panel-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .st__ph-num { color: var(--color-flame-400); font-weight: 500; }
  .st__ph-tag { font-family: var(--font-mono); font-size: 12px; color: var(--color-bone); padding: 5px 10px; border-radius: 99px; border: 1px solid var(--line-strong); background: rgb(255 255 255 / .03); }
  .st__svg { display: block; width: 100%; height: auto; max-height: calc(100vh - var(--nav-h) - 170px); aspect-ratio: 1; margin-inline: auto; overflow: visible; }

  .st__bar { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
  .st__seg { height: 3px; border-radius: 3px; background: var(--color-ink-600); position: relative; overflow: hidden; }
  .st__seg::after { content: ""; position: absolute; inset: 0; background: var(--grad-cta); transform: scaleX(0); transform-origin: left; transition: transform .8s var(--ease-out-expo); }
  .st__panel[data-phase='1'] .st__seg:nth-child(-n+1)::after,
  .st__panel[data-phase='2'] .st__seg:nth-child(-n+2)::after,
  .st__panel[data-phase='3'] .st__seg:nth-child(-n+3)::after,
  .st__panel[data-phase='4'] .st__seg::after { transform: none; }

  /* ---------- SVG ---------- */
  .st__svg text { font-family: var(--font-mono); font-size: 11px; letter-spacing: .06em; fill: var(--color-mist); text-transform: uppercase; }
  .st-guides { fill: none; stroke: rgb(255 255 255 / .05); stroke-dasharray: 2 6; }
  .st-edge { stroke: rgb(255 255 255 / .22); stroke-width: 1; }
  .st-edge--ai { stroke: rgb(245 131 39 / .55); stroke-dasharray: 3 4; }
  .st-edge--flow { stroke: rgb(245 131 39 / .7); stroke-width: 1.25; stroke-dasharray: 6 8; animation: st-flow 1.6s linear infinite; animation-delay: calc(var(--k) * -.4s); }
  .st-edge--unit { stroke: rgb(255 132 66 / .45); }
  @keyframes st-flow { to { stroke-dashoffset: -28; } }

  .st-node rect { fill: var(--color-ink-800); stroke: var(--line-strong); }
  .st-node text { fill: var(--color-bone); }
  .st-ring { fill: none; stroke: rgb(245 131 39 / .6); stroke-dasharray: 2 5; transform-origin: 280px 280px; animation: st-spin 24s linear infinite; }
  @keyframes st-spin { to { transform: rotate(360deg); } }
  .st-chip rect { fill: rgb(245 131 39 / .08); stroke: rgb(245 131 39 / .45); }
  .st-chip text { fill: var(--color-flame-300); font-size: 10.5px; }
  .st-chip-dot { fill: var(--color-flame-400); }
  .st-client > rect:first-child { fill: var(--color-ink-900); stroke: rgb(255 255 255 / .2); stroke-dasharray: 4 3; }
  .st-client-l { font-size: 10px !important; fill: var(--color-smoke) !important; }
  .st-mini { fill: rgb(255 255 255 / .04); stroke: rgb(245 131 39 / .4); }
  .st-mini-t { font-size: 9.5px !important; fill: var(--color-flame-200) !important; letter-spacing: .02em !important; text-transform: none !important; }
  .st-orbit { fill: none; stroke: rgb(245 131 39 / .35); stroke-dasharray: 1 5; }
  .st-unit rect { fill: var(--color-ink-850); stroke: rgb(245 131 39 / .55); }
  .st-unit-code { fill: var(--color-flame-400) !important; font-size: 10px !important; }
  .st-unit-name { fill: var(--color-bone) !important; font-family: var(--font-sans) !important; font-size: 13px !important; letter-spacing: 0 !important; text-transform: none !important; font-weight: 500; }
  .st-core-disc { fill: var(--color-ink-950); stroke: rgb(245 131 39 / .5); }
  .st-core-glow { opacity: .7; }

  /* Phase visibility. Default (no JS) shows the full picture. */
  .st-p { transition: opacity .9s var(--ease-out-expo), transform 1.1s var(--ease-out-expo); transform-origin: 280px 280px; }
  .st__panel[data-phase='1'] .st-p2, .st__panel[data-phase='1'] .st-p3, .st__panel[data-phase='1'] .st-p4,
  .st__panel[data-phase='2'] .st-p3, .st__panel[data-phase='2'] .st-p4,
  .st__panel[data-phase='3'] .st-p4 { opacity: 0; transform: scale(.94); }
  .st__panel[data-phase='4'] .st-p1, .st__panel[data-phase='4'] .st-p2, .st__panel[data-phase='4'] .st-p3 { opacity: .13; }
  .st__panel[data-phase='1'] .st-core-glow { opacity: .25; }

  .st.is-paused .st-edge--flow, .st.is-paused .st-ring { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) {
    .st-edge--flow, .st-ring { animation: none; }
    .st-p, .st__seg::after { transition: none; }
  }

  /* ---------- Steps ---------- */
  .st__steps { position: relative; padding-left: 36px; --p: 0; }
  .st__list { display: flex; flex-direction: column; }
  .st__rail { position: absolute; left: 6px; top: 10px; bottom: 10px; width: 1px; background: var(--line-strong); }
  .st__rail-fill { position: absolute; inset: 0; background: linear-gradient(180deg, var(--color-sun), var(--color-flame-500) 50%, var(--color-ember)); transform-origin: top; transform: scaleY(1); }
  .st.is-live .st__rail-fill { transform: scaleY(var(--p)); }

  .st__step { position: relative; display: flex; flex-direction: column; gap: 14px; padding-bottom: clamp(56px, 8vw, 96px); }
  .st__step:last-child { padding-bottom: 0; }
  @media (min-width: 1024px) {
    .st__step { min-height: 62vh; justify-content: center; padding-bottom: 0; }
    .st__step:first-child { min-height: 50vh; justify-content: flex-start; padding-top: 8px; }
    .st__step:last-child { min-height: 56vh; }
  }
  .st__dot { position: absolute; left: -36px; top: 6px; width: 13px; height: 13px; border-radius: 99px; background: var(--color-ink-950); border: 1px solid var(--line-strong); transition: border-color .4s, background-color .4s, box-shadow .4s; }
  @media (min-width: 1024px) { .st__step:not(:first-child) .st__dot { top: calc(50% - 90px); } }
  .st__step-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .st__step-tag { font-family: var(--font-mono); font-size: 12px; color: var(--color-flame-400); }
  .st__step-title { font-size: clamp(1.5rem, 2.6vw, 2.25rem); max-width: 18ch; }
  .st__step-body { color: var(--color-mist); max-width: 52ch; }
  .st__notes { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
  .st__notes li { font-family: var(--font-mono); font-size: 11.5px; color: var(--color-mist); padding: 5px 10px; border-radius: 99px; border: 1px solid var(--line); background: rgb(255 255 255 / .02); }

  /* JS-on states: dim inactive steps on desktop, light the dots */
  .st.is-live .st__step { transition: opacity .6s var(--ease-out-expo); }
  @media (min-width: 1024px) { .st.is-live .st__step:not(.is-active) { opacity: .38; } }
  .st.is-live .st__step.is-active .st__dot, .st.is-live .st__step.is-past .st__dot { border-color: var(--color-flame-500); background: var(--color-flame-500); box-shadow: 0 0 0 4px rgb(245 131 39 / .16), 0 0 18px rgb(245 131 39 / .6); }
  .st.is-live .st__step.is-past .st__dot { box-shadow: none; }
</style>
