---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { ABOUT } from '@/i18n/about';
import { STATS, CLIENTS } from '@/data/site';
import type { Lang } from '@/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const n = ABOUT.numbers;
// Repeat the logos so the track is always wider than the viewport, then double it for a seamless -50% loop.
const half = [...CLIENTS, ...CLIENTS];
const loop = [...half, ...half];
---
<section class="nb section-y" aria-label={n.eyebrow[lang]} data-numbers>
  <div class="nb__glow glow-ember" aria-hidden="true"></div>
  <div class="container-x">
    <SectionHeading index={n.index} eyebrow={n.eyebrow[lang]} title={n.title[lang]} />

    <dl class="nb__stats">
      {STATS.map((s, i) => (
        <div class="nb__stat" data-idx={String(i + 1).padStart(2, '0')} data-reveal style={`--reveal-delay:${i * 90}`}>
          <dt class="nb__label">{s.label[lang]}</dt>
          <dd class="nb__value" data-count={s.value}>{s.value}</dd>
        </div>
      ))}
    </dl>
  </div>

  <div class="nb__brands">
    <div class="container-x nb__brands-head">
      <span class="mono-label">{n.brandsLabel[lang]}</span>
      <span class="nb__rule" aria-hidden="true"></span>
    </div>
    <div class="nb__viewport">
      <ul class="nb__track" aria-label={n.brandsLabel[lang]}>
        {loop.map((c, i) => {
          const dup = i >= CLIENTS.length;
          const tile = c.src.endsWith('.webp');
          return (
            <li class="nb__item" aria-hidden={dup ? 'true' : undefined}>
              {tile ? (
                <span class="nb__tile"><img src={c.src} alt={dup ? '' : c.name} width={c.w} height={c.h} loading="lazy" decoding="async" /></span>
              ) : (
                <img src={c.src} alt={dup ? '' : c.name} width={c.w} height={c.h} loading="lazy" decoding="async" />
              )}
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</section>

<script>
  // Count the numeric part of "15+", "200+", "3" up once, when the stats come into view.
  document.querySelectorAll<HTMLElement>('[data-numbers]').forEach((root) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    const els = root.querySelectorAll<HTMLElement>('[data-count]');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const m = (el.dataset.count || '').match(/^(\D*)(\d+)(\D*)$/);
        if (!m) return;
        const [, pre, num, post] = m;
        const target = Number(num);
        const t0 = performance.now();
        const step = (t: number) => {
          const k = Math.min(1, (t - t0) / 1600);
          el.textContent = `${pre}${Math.round(target * (1 - Math.pow(1 - k, 4)))}${post}`;
          if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      });
    }, { threshold: 0.7 });
    els.forEach((el) => io.observe(el));
  });
</script>

<style>
  .nb { position: relative; isolation: isolate; overflow: hidden; border-top: 1px solid var(--line); }
  .nb__glow { z-index: -1; width: 70vw; height: 420px; left: -20vw; top: 30%; opacity: .32; }

  .nb__stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: clamp(40px, 6vw, 72px); border-top: 1px solid var(--line); }
  @media (min-width: 960px) { .nb__stats { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .nb__stat { position: relative; display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 12px; padding: 28px 20px 30px 0; border-bottom: 1px solid var(--line); }
  .nb__stat:nth-child(odd) { padding-right: 20px; }
  .nb__stat:nth-child(even) { padding-left: 20px; border-left: 1px solid var(--line); }
  @media (min-width: 960px) {
    .nb__stat { padding: 36px 28px 40px; border-left: 1px solid var(--line); border-bottom: 0; }
    .nb__stat:first-child { border-left: 0; padding-left: 0; }
    .nb__stat:nth-child(even), .nb__stat:nth-child(odd) { padding-inline: 28px; }
    .nb__stat:first-child { padding-left: 0; }
  }
  .nb__value { font-family: var(--font-display); font-weight: 500; font-size: clamp(2.8rem, 6.4vw, 5.6rem); line-height: .95; letter-spacing: -.05em; font-variant-numeric: tabular-nums;
    background: linear-gradient(180deg, var(--color-bone) 30%, var(--color-flame-400) 130%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .nb__label { color: var(--color-mist); font-size: 15px; max-width: 22ch; }
  .nb__stat::after { content: attr(data-idx); position: absolute; top: 14px; right: 16px; font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em; color: var(--color-smoke); }
  @media (min-width: 960px) { .nb__stat::after { right: 28px; } }

  /* Brands */
  .nb__brands { margin-top: clamp(56px, 8vw, 104px); }
  .nb__brands-head { display: flex; align-items: center; gap: 20px; margin-bottom: 24px; }
  .nb__rule { flex: 1; height: 1px; background: linear-gradient(90deg, var(--line-strong), transparent); }
  .nb__viewport { overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .nb__track { --marquee-duration: 70s; display: flex; width: max-content; align-items: center; animation: var(--animate-marquee-reverse); }
  .nb__viewport:hover .nb__track { animation-play-state: paused; }
  .nb__item { flex: none; display: grid; place-items: center; height: 72px; padding-inline: clamp(28px, 4vw, 56px); border-left: 1px solid var(--line); }
  .nb__item img { height: 24px; width: auto; opacity: .62; transition: opacity .3s; }
  .nb__item:hover img { opacity: 1; }
  .nb__tile { display: grid; place-items: center; height: 44px; aspect-ratio: 240 / 310; padding: 4px; border-radius: 6px; background: #f4efe9; opacity: .8; transition: opacity .3s; }
  .nb__tile img { height: 100%; width: auto; opacity: 1; }
  .nb__item:hover .nb__tile { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .nb__track { animation: none; flex-wrap: wrap; width: auto; justify-content: center; }
    .nb__item[aria-hidden='true'] { display: none; }
  }
</style>
