---
import Logo from './ui/Logo.astro';
import Icon from './ui/Icon.astro';
import { UI } from '@/i18n/ui';
import { localize, type Lang } from '@/i18n';
import { UNITS, SITE } from '@/data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = <T,>(o: Record<Lang, T>) => o[lang];
const year = new Date().getFullYear();
const company = [
  { href: localize(lang, '/about'), label: t(UI.nav.about) },
  { href: localize(lang, '/work'), label: t(UI.nav.work) },
  { href: localize(lang, '/#method'), label: t(UI.nav.method) },
  { href: localize(lang, '/diagnostic'), label: t(UI.nav.diagnostic) },
  { href: localize(lang, '/contact'), label: t(UI.nav.contact) },
];
---
<footer class="ft">
  <div class="container-x ft__grid">
    <div class="ft__brand">
      <Logo href={localize(lang, '/')} size="lg" />
      <p class="ft__tagline">{t(UI.footer.tagline)}</p>
      <span class="ft__status"><span class="ft__status-dot" aria-hidden="true"></span>{t(UI.footer.status)}</span>
    </div>

    <nav class="ft__col" aria-label={t(UI.footer.services)}>
      <p class="mono-label">{t(UI.footer.services)}</p>
      <ul>
        {UNITS.map((u) => (
          <li><a href={localize(lang, `/services/${u.slug}`)}><span class="ft__code">{u.code}</span>{t(u.name)}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="ft__col" aria-label={t(UI.footer.company)}>
      <p class="mono-label">{t(UI.footer.company)}</p>
      <ul>{company.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>

    <div class="ft__col ft__news">
      <p class="mono-label">{t(UI.footer.newsletterTitle)}</p>
      <p class="ft__news-body">{t(UI.footer.newsletterBody)}</p>
      <form
        class="ft__form"
        data-newsletter
        data-lang={lang}
        data-msg-invalid={t(UI.footer.newsletterInvalid)}
        data-msg-fail={`${t(UI.footer.newsletterFail)}${SITE.email}.`}
        novalidate
      >
        <label class="sr-only" for="ft-email">{t(UI.footer.newsletterLabel)}</label>
        <input id="ft-email" type="email" name="email" required autocomplete="email" placeholder={t(UI.footer.newsletterPlaceholder)} aria-describedby="ft-email-msg" />
        <input type="text" name="company_fax" tabindex="-1" autocomplete="off" aria-hidden="true" class="ft__hp" />
        <button type="submit" aria-label={t(UI.footer.newsletterCta)}><Icon name="arrow-right" size={18} /></button>
      </form>
      <p id="ft-email-msg" class="ft__news-err" role="alert" hidden></p>
      <p class="ft__news-ok" data-newsletter-ok role="status" tabindex="-1" hidden>{t(UI.footer.newsletterOk)}</p>
      <p class="ft__news-legal">{t(UI.footer.newsletterLegal)}<a href={localize(lang, '/privacy')}>{t(UI.footer.privacy)}</a></p>
      <div class="ft__contact">
        <a href={`mailto:${SITE.email}`}><Icon name="mail" size={16} />{SITE.email}</a>
        <span><Icon name="globe" size={16} />{t(SITE.markets)}</span>
      </div>
    </div>
  </div>

  <div class="ft__giant" aria-hidden="true">SANDB<svg class="ft__cube" viewBox="11.89 6 76.21 88" aria-hidden="true"><defs><linearGradient id="ft-cube-g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f58327" stop-opacity=".24" /><stop offset="1" stop-color="#f58327" stop-opacity=".03" /></linearGradient></defs><path fill="url(#ft-cube-g)" fill-rule="evenodd" d="M50 6L88.11 28L88.11 72L50 94L11.89 72L11.89 28ZM50 44.28L78.2 28L65.62 20.74L50 25.36L34.38 20.74L21.8 28ZM47.14 54.07L16.85 36.58L16.85 49.78L32.09 58.58L32.09 77.94L47.14 86.63ZM52.86 54.07L83.15 36.58L83.15 49.78L67.91 58.58L67.91 77.94L52.86 86.63Z" /></svg>X</div>

  <div class="container-x ft__base">
    <span>© {year} {SITE.legalName}. {t(UI.footer.rights)} <a class="ft__legal" href={localize(lang, '/privacy')}>{t(UI.footer.privacy)}</a></span>
    <span class="mono-label">{SITE.location}</span>
  </div>
</footer>

<script>
  import { submitLead, isValidEmail } from '@/lib/leads';
  document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach((form) => {
    const input = form.querySelector<HTMLInputElement>('input[type="email"]')!;
    const hp = form.querySelector<HTMLInputElement>('input[name="company_fax"]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const box = form.parentElement!;
    const err = box.querySelector<HTMLElement>('.ft__news-err')!;
    const ok = box.querySelector<HTMLElement>('[data-newsletter-ok]')!;
    const showErr = (msg: string) => { err.textContent = msg; err.hidden = false; };
    input.addEventListener('input', () => { if (input.getAttribute('aria-invalid') && isValidEmail(input.value)) { input.removeAttribute('aria-invalid'); err.hidden = true; } });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (hp && hp.value) return; // bots fill every field
      if (button.disabled) return;
      if (!isValidEmail(input.value)) {
        input.setAttribute('aria-invalid', 'true');
        showErr(form.dataset.msgInvalid || '');
        input.focus();
        return;
      }
      input.removeAttribute('aria-invalid');
      err.hidden = true;
      button.disabled = true;
      form.setAttribute('aria-busy', 'true');
      const res = await submitLead({ kind: 'newsletter', email: input.value.trim(), lang: (form.dataset.lang as 'en' | 'es') ?? 'en', source: 'footer' });
      form.removeAttribute('aria-busy');
      if (!res.ok) {
        button.disabled = false;
        showErr(form.dataset.msgFail || '');
        return;
      }
      form.hidden = true;
      ok.hidden = false;
      ok.focus();
    });
  });
</script>

<style>
  .ft { position: relative; margin-top: 40px; border-top: 1px solid var(--line); overflow: hidden; background: linear-gradient(180deg, transparent, rgb(217 76 0 / .05)); }
  .ft__grid { display: grid; gap: 48px; padding-top: 80px; padding-bottom: 40px; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .ft__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1080px) { .ft__grid { grid-template-columns: 1.4fr .8fr .8fr 1.3fr; } }
  @media (max-width: 719px) { .ft__grid { grid-template-columns: 1fr 1fr; gap: 40px 24px; padding-top: 56px; } .ft__brand, .ft__news { grid-column: 1 / -1; } }
  .ft__brand { display: flex; flex-direction: column; gap: 20px; align-items: flex-start; }
  .ft__tagline { max-width: 340px; color: var(--color-mist); font-size: 16px; }
  .ft__status { display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 12px; color: var(--color-mist); padding: 7px 12px; border-radius: 99px; border: 1px solid var(--line); }
  .ft__status-dot { width: 7px; height: 7px; border-radius: 9px; background: var(--color-ok); box-shadow: 0 0 10px var(--color-ok); }
  .ft__col { display: flex; flex-direction: column; gap: 18px; }
  .ft__col ul { display: flex; flex-direction: column; gap: 10px; }
  .ft__col a { color: var(--color-mist); transition: color .2s; display: inline-flex; gap: 10px; align-items: baseline; }
  .ft__col a:hover { color: var(--color-bone); }
  @media (pointer: coarse) { .ft__col a { min-height: 40px; align-items: center; } .ft__col ul { gap: 2px; } }
  .ft__code { font-family: var(--font-mono); font-size: 11px; color: var(--color-smoke); }
  .ft__news-body { color: var(--color-mist); font-size: 15px; margin-top: -6px; }
  .ft__form { display: flex; align-items: center; height: 52px; padding: 5px 5px 5px 18px; border-radius: 99px; border: 1px solid var(--line-strong); background: rgb(255 255 255 / .02); transition: border-color .2s; }
  .ft__form:focus-within { border-color: rgb(245 131 39 / .6); }
  .ft__form input { flex: 1; min-width: 0; background: transparent; border: 0; outline: 0; color: var(--color-bone); font-size: 15px; }
  .ft__form input[aria-invalid='true'] { color: var(--color-err); }
  .ft__form input::placeholder { color: var(--color-smoke); }
  .ft__form button { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 99px; background: var(--grad-cta); color: #1a0d03; cursor: pointer; }
  .ft__form[aria-busy='true'] { opacity: .7; }
  .ft__form button:disabled { cursor: progress; }
  .ft__hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .ft__news-err { color: var(--color-err); font-size: 14px; margin-top: -8px; }
  .ft__news-ok { color: var(--color-ok); font-size: 15px; }
  .ft__news-ok:focus { outline: none; }
  .ft__news-legal { font-size: 13px; color: var(--color-smoke); margin-top: -8px; }
  .ft__news-legal a { color: var(--color-smoke); text-decoration: underline; text-underline-offset: 3px; }
  .ft__news-legal a:hover { color: var(--color-bone); }
  .ft__contact { display: flex; flex-direction: column; gap: 10px; margin-top: 8px; font-size: 14.5px; }
  .ft__contact a, .ft__contact span { display: inline-flex; align-items: center; gap: 10px; color: var(--color-mist); }
  .ft__giant { font-family: var(--font-display); font-weight: 600; font-size: clamp(56px, 15.6vw, 236px); line-height: .8; letter-spacing: -.055em; text-align: center;
    color: transparent; user-select: none; margin-top: 24px; white-space: nowrap;
    background: linear-gradient(180deg, rgb(245 131 39 / .22), rgb(245 131 39 / .02) 78%); -webkit-background-clip: text; background-clip: text; }
  /* The real mark: cube sized a touch over cap height (its vertices overshoot, like the logo) and centred on the caps. Same fade as the letters. */
  .ft__cube { display: inline-block; height: .84em; width: auto; margin: 0 .02em; vertical-align: -.045em; }
  .ft__legal { color: var(--color-mist); text-decoration: underline; text-underline-offset: 3px; margin-left: 10px; }
  .ft__legal:hover { color: var(--color-bone); }
  .ft__base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding-top: 24px; padding-bottom: 28px; font-size: 13px; color: var(--color-smoke); border-top: 1px solid var(--line); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
