---
/**
 * Sandbox wordmark: "SANDB" + cube mark + "X", set in Unbounded with the logo gradient.
 * The cube is a vector reconstruction of the brand icon (replace with the official SVG if available).
 */
interface Props {
  href?: string;
  size?: 'sm' | 'md' | 'lg';
  markOnly?: boolean;
  class?: string;
}
const { href, size = 'md', markOnly = false, class: cls = '' } = Astro.props;
const Tag = href ? 'a' : 'span';
const uid = `lg-${Math.random().toString(36).slice(2, 8)}`;
---
<Tag href={href} class:list={['sbx-logo', `sbx-logo--${size}`, cls]} aria-label="Sandbox">
  {!markOnly && <span class="sbx-logo__txt" aria-hidden="true">SANDB</span>}
  <svg class="sbx-logo__mark" viewBox="11.89 6 76.21 88" aria-hidden="true">
    <defs>
      <linearGradient id={uid} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#FFD21F" />
        <stop offset=".42" stop-color="#F7921E" />
        <stop offset="1" stop-color="#E2540C" />
      </linearGradient>
    </defs>
    <path
      fill={`url(#${uid})`}
      fill-rule="evenodd"
      d="M50 6L88.11 28L88.11 72L50 94L11.89 72L11.89 28ZM50 44.28L78.2 28L65.62 20.74L50 25.36L34.38 20.74L21.8 28ZM47.14 54.07L16.85 36.58L16.85 49.78L32.09 58.58L32.09 77.94L47.14 86.63ZM52.86 54.07L83.15 36.58L83.15 49.78L67.91 58.58L67.91 77.94L52.86 86.63Z"
    />
  </svg>
  {!markOnly && <span class="sbx-logo__txt" aria-hidden="true">X</span>}
</Tag>

<style>
  .sbx-logo {
    --h: 22px;
    display: inline-flex;
    align-items: center;
    gap: 0.04em;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--h);
    line-height: 1;
    letter-spacing: 0.02em;
    text-decoration: none;
  }
  .sbx-logo--sm { --h: 17px; }
  .sbx-logo--lg { --h: 34px; }
  .sbx-logo__txt {
    background: linear-gradient(180deg, #ffd21f 0%, #f7921e 55%, #e2540c 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .sbx-logo__mark {
    height: 1.02em;
    width: auto;
    margin-inline: 0.03em;
    transform: translateY(-0.02em);
    transition: transform 0.8s var(--ease-out-expo);
  }
  a.sbx-logo:hover .sbx-logo__mark { transform: translateY(-0.02em) rotate(-60deg); }
</style>
