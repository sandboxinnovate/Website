---
/**
 * A small "app tile" for a business tool (CRM, email, team chat...): tinted rounded square with a
 * generic line icon, optionally followed by its label. Same look as the React ToolBadge.
 *   <ToolBadge tool="crm" lang={lang} />            tile + label
 *   <ToolBadge tool="crm" lang={lang} label={false} />  tile only (label kept for screen readers)
 */
import type { Lang } from '@/i18n';
import { TOOL_ICONS, TOOL_TINTS, type ToolKey } from './tool-icons';

interface Props {
  tool: ToolKey;
  lang: Lang;
  label?: boolean | string;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}
const { tool, lang, label = true, size = 'md', class: cls = '' } = Astro.props;
const t = TOOL_ICONS[tool];
const [bg, fg] = TOOL_TINTS[t.tint];
const text = typeof label === 'string' ? label : t.label[lang];
---
<span class:list={['tb', `tb--${size}`, cls]} style={`--tb-bg:${bg};--tb-fg:${fg}`}>
  <span class="tb__tile" role={label === false ? 'img' : undefined} aria-label={label === false ? text : undefined}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={t.paths} />
  </span>
  {label !== false && <span class="tb__label">{text}</span>}
</span>

<style>
  .tb { display: inline-flex; align-items: center; gap: 8px; min-width: 0; }
  .tb__tile { flex: none; display: grid; place-items: center; width: var(--tb-s, 28px); height: var(--tb-s, 28px); border-radius: calc(var(--tb-s, 28px) * .3); background: var(--tb-bg); color: var(--tb-fg); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .06); }
  .tb__tile svg { width: 58%; height: 58%; }
  .tb__label { font-size: 13px; color: var(--color-bone); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tb--sm { --tb-s: 22px; } .tb--sm .tb__label { font-size: 12px; }
  .tb--lg { --tb-s: 36px; } .tb--lg .tb__label { font-size: 14px; }
</style>
