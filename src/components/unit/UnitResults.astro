---
/**
 * Published client results for this unit, as a ledger (same look as the Work hero index).
 * Data comes only from CASES in src/i18n/work.ts; renders nothing when the unit has no cases.
 * Each row deep-links to the case dialog on /work.
 */
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import { UNIT_COMMON } from '@/i18n/units';
import { CASES } from '@/i18n/work';
import type { UnitSlug } from '@/data/site';
import { localize, type Lang } from '@/i18n';

interface Props { lang: Lang; slug: UnitSlug; index: string }
const { lang, slug, index } = Astro.props;
const R = UNIT_COMMON.results;
const items = CASES.filter((c) => c.unit === slug);
const pad = (n: number) => String(n).padStart(2, '0');
---
{items.length > 0 && (
  <section class="ures" id="results" aria-labelledby="ures-title">
    <div class="container-x">
      <div class="ures__head">
        <SectionHeading id="ures-title" index={index} eyebrow={R.eyebrow[lang]} title={R.title[lang]} lede={R.lede[lang]} />
      </div>

      <ol class="ures__list" data-reveal>
        {items.map((c) => (
          <li>
            <a class="ures__row" href={localize(lang, `/work#case-${c.id}`)}>
              <span class="ures__no mono-label">{pad(CASES.indexOf(c) + 1)}</span>
              <span class="ures__client">{c.client[lang]}</span>
              <span class="ures__metric">{c.metrics[0].value}</span>
              <span class="ures__label">{c.metrics[0].label[lang]}</span>
              <Icon name="arrow-up-right" size={14} class="ures__arrow" />
            </a>
          </li>
        ))}
      </ol>

      <a class="ures__all" href={localize(lang, '/work')} data-reveal>{R.all[lang]} <Icon name="arrow-up-right" size={14} /></a>
    </div>
  </section>
)}

<style>
  .ures { padding-block: clamp(72px, 9vw, 128px); }
  .ures__head { margin-bottom: clamp(40px, 6vw, 64px); }

  .ures__list { border: 1px solid var(--line); border-radius: var(--radius-card); overflow: hidden;
    background: rgb(13 12 12 / .8); box-shadow: inset 0 1px 0 rgb(255 255 255 / .05); }
  .ures__list li + li .ures__row { border-top: 1px solid var(--line); }

  /* Mobile: number | client over label | metric */
  .ures__row { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto; align-items: center; column-gap: 12px; row-gap: 4px;
    min-height: 56px; padding: 16px clamp(16px, 2.4vw, 28px); transition: background-color .25s; }
  .ures__no { grid-column: 1; grid-row: 1 / span 2; }
  .ures__client { grid-column: 2; grid-row: 1; font-size: 16px; line-height: 1.3; color: var(--color-bone); }
  .ures__label { grid-column: 2; grid-row: 2; font-size: 14px; line-height: 1.4; color: var(--color-mist); }
  .ures__metric { grid-column: 3; grid-row: 1 / span 2; justify-self: end; white-space: nowrap;
    font-family: var(--font-display); font-weight: 500; font-size: 1.6rem; line-height: 1; letter-spacing: -.045em; padding-right: .04em;
    background: var(--grad-text); -webkit-background-clip: text; background-clip: text; color: transparent; font-variant-numeric: tabular-nums; }
  .ures__row :global(.ures__arrow) { display: none; color: var(--color-smoke); transition: transform .4s var(--ease-out-expo), color .25s; }

  /* Desktop ledger: number | client | metric | label | arrow, columns aligned across rows */
  @media (min-width: 900px) {
    .ures__row { grid-template-columns: 40px minmax(0, 1.2fr) 7.5rem minmax(0, 1fr) 16px; column-gap: 20px; padding-block: 14px; }
    .ures__no, .ures__client, .ures__label, .ures__metric { grid-row: 1; }
    .ures__metric { grid-column: 3; justify-self: start; }
    .ures__label { grid-column: 4; }
    .ures__row :global(.ures__arrow) { display: block; grid-column: 5; }
  }

  .ures__row:hover, .ures__row:focus-visible { background: rgb(245 131 39 / .05); }
  .ures__row:hover :global(.ures__arrow), .ures__row:focus-visible :global(.ures__arrow) { color: var(--color-flame-400); transform: translate(2px, -2px); }
  .ures__row:focus-visible { outline-offset: -2px; }

  .ures__all { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; margin-top: 24px; font-family: var(--font-display); font-size: 12px; font-weight: 600;
    letter-spacing: .05em; text-transform: uppercase; color: var(--color-flame-400); border-bottom: 1px solid rgb(245 131 39 / .35); transition: color .2s, border-color .2s; }
  .ures__all:hover { color: var(--color-bone); border-color: var(--color-bone); }
</style>
