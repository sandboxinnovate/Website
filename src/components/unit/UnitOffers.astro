---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import { UNIT_COMMON } from '@/i18n/units';
import type { UnitCopy } from '@/i18n/units';
import type { UnitSlug } from '@/data/site';
import { localize, type Lang } from '@/i18n';

interface Props { lang: Lang; slug: UnitSlug; copy: UnitCopy; index: string }
const { lang, slug, copy, index } = Astro.props;
const o = copy.offers;
const C = UNIT_COMMON.offers;
const n = o.items.length;
const LETTERS = 'ABCDEFGH';
const slugify = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---
<section class="uo" id="offers">
  <div class="uo__glow glow-ember" aria-hidden="true"></div>
  <div class="container-x">
    <div class="uo__head">
      <SectionHeading index={index} eyebrow={o.eyebrow} title={o.title} lede={o.lede} />
    </div>

    <ul class:list={['uo__grid', `uo__grid--${n}`]}>
      {o.items.map((it, i) => (
        <li class="uo__cell" data-reveal style={`--reveal-delay:${(i % 3) * 100}`}>
          <article class="uo__card card card-hover" aria-labelledby={`uo-${slug}-${i}`}>
            <div class="uo__top">
              <span class="uo__idx">[{LETTERS[i]}]</span>
              {it.tag && <span class="uo__tag"><span class="uo__tag-dot"></span>{it.tag}</span>}
            </div>
            <h3 class="uo__name" id={`uo-${slug}-${i}`}>{it.name}</h3>
            <p class="uo__what">{it.what}</p>

            <div class="uo__inc">
              <span class="mono-label">{C.included[lang]}</span>
              <ul>
                {it.includes.map((x) => (
                  <li><span class="uo__check"><Icon name="check" size={13} stroke={2.2} /></span>{x}</li>
                ))}
              </ul>
            </div>

            <dl class="uo__meta">
              <div class="uo__m">
                <dt class="mono-label">{C.timeline[lang]}</dt>
                <dd class="uo__time"><Icon name="calendar" size={15} />{it.timeline}</dd>
              </div>
              <div class="uo__m">
                <dt class="mono-label">{C.bestFor[lang]}</dt>
                <dd>{it.bestFor}</dd>
              </div>
            </dl>

            <a class="uo__ask" href={localize(lang, `/contact?service=${slug}&offer=${slugify(it.name)}`)} aria-label={`${C.ask[lang]}: ${it.name}`}>
              {C.ask[lang]}<Icon name="arrow-up-right" size={15} />
            </a>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .uo { padding-block: clamp(64px, 8vw, 112px); }
  .uo { position: relative; isolation: isolate; overflow-x: clip; }
  .uo__glow { z-index: -1; width: 70vw; height: 520px; left: 15vw; top: 30%; opacity: .14; }
  .uo__head { margin-bottom: clamp(40px, 6vw, 72px); }

  .uo__grid { display: grid; gap: 14px; grid-template-columns: 1fr; }
  @media (min-width: 760px) {
    .uo__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .uo__grid--3 .uo__cell:last-child, .uo__grid--5 .uo__cell:last-child { grid-column: span 2; }
  }
  @media (min-width: 1100px) {
    .uo__grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .uo__grid--3 .uo__cell:last-child { grid-column: auto; }
    .uo__grid--5 { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .uo__grid--5 .uo__cell { grid-column: span 2; }
    .uo__grid--5 .uo__cell:nth-child(n+4) { grid-column: span 3; }
    .uo__grid--5 .uo__cell:last-child { grid-column: span 3; }
  }
  .uo__cell { display: flex; }
  .uo__card { display: flex; flex-direction: column; gap: 18px; width: 100%; padding: clamp(24px, 2.6vw, 34px); }

  .uo__top { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 26px; }
  .uo__idx { font-family: var(--font-mono); font-size: 12px; color: var(--color-flame-400); }
  .uo__tag { display: inline-flex; align-items: center; gap: 7px; padding: 4px 10px; border-radius: 99px; border: 1px dashed rgb(245 131 39 / .55); font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--color-flame-400); }
  .uo__tag-dot { width: 6px; height: 6px; border-radius: 9px; background: var(--color-flame-500); }

  .uo__name { font-size: clamp(1.45rem, 2.1vw, 1.85rem); letter-spacing: -.04em; }
  .uo__what { color: var(--color-mist); font-size: 16px; line-height: 1.55; }

  .uo__inc { display: flex; flex-direction: column; gap: 12px; padding-top: 18px; border-top: 1px solid var(--line); }
  .uo__inc ul { display: flex; flex-direction: column; gap: 9px; }
  .uo__inc li { display: grid; grid-template-columns: 22px 1fr; gap: 10px; align-items: start; font-size: 15px; line-height: 1.45; color: var(--color-bone); }
  .uo__check { display: grid; place-items: center; width: 20px; height: 20px; margin-top: 1px; border-radius: 6px; color: var(--color-flame-400); background: rgb(245 131 39 / .1); }

  .uo__meta { display: grid; gap: 14px; margin-top: auto; padding: 16px; border-radius: 14px; background: rgb(255 255 255 / .025); border: 1px solid var(--line); }
  .uo__m { display: flex; flex-direction: column; gap: 6px; }
  .uo__m dd { font-size: 14.5px; line-height: 1.45; color: var(--color-mist); }
  .uo__time { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-display); font-size: 15px !important; letter-spacing: -.01em; color: var(--color-bone) !important; }
  .uo__time :global(svg) { color: var(--color-flame-400); flex: none; }

  .uo__ask { display: inline-flex; align-items: center; gap: 8px; align-self: flex-start; min-height: 40px; font-family: var(--font-display); font-size: 12px; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; color: var(--color-flame-400); border-bottom: 1px solid rgb(245 131 39 / .35); transition: color .2s, border-color .2s; }
  .uo__ask:hover { color: var(--color-bone); border-color: var(--color-bone); }
  .uo__ask :global(svg) { transition: transform .5s var(--ease-out-expo); }
  .uo__ask:hover :global(svg) { transform: rotate(45deg); }

  @media (min-width: 1100px) {
    .uo__grid--5 .uo__cell:nth-child(n+4) .uo__card { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 28px; align-content: start; }
    .uo__grid--5 .uo__cell:nth-child(n+4) .uo__top,
    .uo__grid--5 .uo__cell:nth-child(n+4) .uo__name,
    .uo__grid--5 .uo__cell:nth-child(n+4) .uo__what { grid-column: 1; }
    .uo__grid--5 .uo__cell:nth-child(n+4) .uo__inc { grid-column: 2; grid-row: 1 / span 4; border-top: 0; padding-top: 0; }
    .uo__grid--5 .uo__cell:nth-child(n+4) .uo__meta { grid-column: 1; }
    .uo__grid--5 .uo__cell:nth-child(n+4) .uo__ask { grid-column: 1; }
  }
</style>
