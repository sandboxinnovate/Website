---
/**
 * Academy hero: a friendly program card for one team: role tabs, four sessions with status,
 * and this week's practice (from the help desk to a weekly report) whose steps tick off in a loop.
 */
import VisualFrame from './VisualFrame.astro';
import ToolBadge from '@/components/ui/ToolBadge.astro';
import { VISUAL_COPY } from './copy';
import type { Lang } from '@/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = VISUAL_COPY[lang];
const t = c.academy;
const status = (i: number) => (i < 2 ? 'done' : i === 2 ? 'now' : 'next');
const statusLabel = { done: t.done, now: t.now, next: t.next };
const people = ['AM', 'JR', 'LC', 'DP'];
const check = '<path d="m5 12.5 4.5 4.5L19 7.5" />';
---
<VisualFrame title={t.title} label={c.illustrative} labelShort={c.illustrativeShort} class="av">
  <div class="av__wrap">
    <div class="av__tabs">
      {t.roles.map((r, i) => <span class:list={['av__tab', i === t.activeRole && 'is-on']}>{r}</span>)}
    </div>

    <ol class="av__mods">
      {t.modules.map((m, i) => {
        const s = status(i);
        return (
          <li class:list={['av__mod', `is-${s}`]} style={`--k:${i}`}>
            <span class="av__n">
              {s === 'done' ? <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" set:html={check} /> : i + 1}
            </span>
            <span class="av__t">
              <span class="av__title">{m.t}</span>
              <span class="av__meta">
                <span class="av__time">
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></svg>
                  {m.time}
                </span>
                <span class:list={['av__kind', `av__kind--${m.kind}`]}>{t.kinds[m.kind as 'live' | 'lab']}</span>
              </span>
              {s === 'now' && <span class="av__prog"><span></span></span>}
            </span>
            <span class="av__s">
              {s === 'now' && <span class="av__pulse"></span>}
              {statusLabel[s]}
            </span>
          </li>
        );
      })}
    </ol>

    <div class="av__lab">
      <div class="av__lab-head">
        <span class="av__lab-k">{t.lab}</span>
        <span class="av__lab-t">{t.labTask}</span>
        <span class="av__flow">
          <ToolBadge tool={t.labFrom.tool} lang={lang} label={t.labFrom.label} size="sm" />
          <svg class="av__arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          <ToolBadge tool={t.labTo.tool} lang={lang} label={t.labTo.label} size="sm" />
        </span>
      </div>
      <ul class="av__steps">
        {t.labSteps.map((s, i) => (
          <li class="av__step" style={`--k:${i}`}>
            <span class="av__box"><svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" set:html={check} /></span>
            <span>{s}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="av__cohort">
      <span class="av__faces">
        {people.map((p, i) => <span class="av__face" style={`--k:${i}`}>{p}</span>)}
        <span class="av__face av__face--more">+9</span>
      </span>
      <span class="av__people">{t.people}</span>
      <span class="av__when">
        <span class="av__week">{t.cohort}</span>
        <span class="av__wbar">{[0, 1, 2, 3].map((i) => <i class:list={[i < 2 && 'is-done', i === 2 && 'is-now']}></i>)}</span>
      </span>
    </div>
  </div>
</VisualFrame>

<style>
  .av__wrap { display: flex; flex-direction: column; gap: 16px; padding: 18px; }
  .av__tabs { display: flex; gap: 4px; padding: 4px; border-radius: 99px; background: rgb(255 255 255 / .03); border: 1px solid var(--line); align-self: flex-start; max-width: 100%; overflow: hidden; }
  .av__tab { padding: 6px 13px; border-radius: 99px; font-size: 13px; font-weight: 500; color: var(--color-mist); white-space: nowrap; }
  .av__tab.is-on { background: var(--color-flame-500); color: #1a0d03; font-weight: 700; }

  .av__mods { display: flex; flex-direction: column; gap: 8px; }
  .av__mod { display: grid; grid-template-columns: 30px minmax(0, 1fr) auto; align-items: center; gap: 12px; padding: 11px 12px; border-radius: 14px; border: 1px solid var(--line); background: rgb(255 255 255 / .02); }
  .av__n { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 99px; font-size: 13px; font-weight: 700; color: var(--color-mist); background: rgb(255 255 255 / .06); }
  .av__t { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
  .av__title { font-size: 15.5px; font-weight: 600; line-height: 1.25; color: var(--color-bone); }
  .av__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; font-size: 12.5px; color: var(--color-mist); }
  .av__time { display: inline-flex; align-items: center; gap: 5px; }
  .av__time svg { color: var(--color-smoke); }
  .av__kind { padding: 1px 8px; border-radius: 99px; background: rgb(255 255 255 / .05); }
  .av__kind--lab { color: var(--color-flame-300); background: rgb(245 131 39 / .1); }
  .av__s { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 99px; font-size: 12.5px; font-weight: 600; white-space: nowrap; border: 1px solid var(--line); color: var(--color-mist); }
  .is-done .av__n { color: #0d1f14; background: var(--color-ok); }
  .is-done .av__s { color: var(--color-ok); border-color: rgb(122 209 155 / .3); background: rgb(122 209 155 / .08); }
  .is-done .av__title { color: var(--color-mist); }
  .is-now { border-color: rgb(245 131 39 / .45); background: rgb(245 131 39 / .06); }
  .is-now .av__s { color: var(--color-flame-300); border-color: rgb(245 131 39 / .45); background: rgb(245 131 39 / .1); }
  .is-now .av__n { color: #1a0d03; background: var(--color-flame-500); }
  .is-next .av__title { color: var(--color-mist); }
  .av__pulse { width: 7px; height: 7px; border-radius: 9px; background: var(--color-flame-500); }
  .av__prog { display: block; height: 5px; margin-top: 4px; border-radius: 9px; background: rgb(255 255 255 / .08); overflow: hidden; max-width: 240px; }
  .av__prog span { display: block; height: 100%; width: 62%; border-radius: inherit; background: var(--grad-cta); }

  .av__lab { padding: 16px; border-radius: 16px; border: 1px solid rgb(245 131 39 / .3); background: linear-gradient(180deg, rgb(245 131 39 / .08), rgb(245 131 39 / .02)); }
  .av__lab-head { display: flex; flex-direction: column; gap: 6px; margin-bottom: 12px; }
  .av__lab-k { font-size: 12px; font-weight: 700; letter-spacing: .04em; color: var(--color-flame-300); }
  .av__lab-t { font-size: 15.5px; font-weight: 500; line-height: 1.35; color: var(--color-bone); }
  .av__flow { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 4px; }
  .av__arrow { color: var(--color-smoke); flex: none; }
  .av__steps { display: flex; flex-direction: column; gap: 8px; }
  .av__step { display: flex; align-items: center; gap: 10px; font-size: 14px; color: var(--color-bone); }
  .av__box { flex: none; display: grid; place-items: center; width: 18px; height: 18px; border-radius: 6px; border: 1.5px solid var(--line-strong); color: transparent; }
  .av__step:not(:last-child) .av__box { background: var(--color-flame-500); border-color: var(--color-flame-500); color: #1a0d03; }
  .av__step:last-child { color: var(--color-mist); }

  .av__cohort { display: flex; align-items: center; gap: 10px 12px; flex-wrap: wrap; }
  .av__faces { display: inline-flex; }
  .av__face { display: grid; place-items: center; width: 30px; height: 30px; margin-left: -8px; border-radius: 99px; font-size: 10.5px; font-weight: 700; color: var(--color-bone); background: var(--color-ink-700); border: 2px solid var(--color-ink-900); }
  .av__face:first-child { margin-left: 0; }
  .av__face:nth-child(2) { background: #3a2a1f; } .av__face:nth-child(3) { background: #2b2b26; } .av__face:nth-child(4) { background: #352320; }
  .av__face--more { color: var(--color-flame-300); background: rgb(245 131 39 / .16); }
  .av__people { font-size: 13px; color: var(--color-mist); }
  .av__when { display: inline-flex; align-items: center; gap: 10px; margin-left: auto; }
  .av__week { font-size: 13px; font-weight: 600; color: var(--color-bone); }
  .av__wbar { display: inline-flex; gap: 4px; }
  .av__wbar i { width: 20px; height: 6px; border-radius: 9px; background: rgb(255 255 255 / .1); }
  .av__wbar i.is-done { background: var(--color-flame-600); }
  .av__wbar i.is-now { background: linear-gradient(90deg, var(--color-flame-400) 50%, rgb(255 255 255 / .1) 50%); }
  @container (max-width: 420px) {
    .av__mod { grid-template-columns: 28px minmax(0, 1fr); }
    .av__s { display: none; }
    .av__n { width: 28px; height: 28px; }
    .av__tab { padding: 6px 10px; font-size: 12.5px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .av__mod { animation: av-in .9s var(--ease-out-expo) both; animation-delay: calc(var(--k) * 110ms + 200ms); }
    .av__pulse { animation: var(--animate-pulse-dot); }
    .av__prog span { animation: av-prog 8s var(--ease-out-expo) infinite; }
    .av__step:not(:last-child) .av__box { animation: av-check 8s infinite; animation-delay: calc(var(--k) * 1.2s); }
    .av__step:last-child { animation: av-last 8s infinite; }
  }
  @keyframes av-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @keyframes av-prog { 0% { width: 18%; } 70%, 100% { width: 74%; } }
  @keyframes av-check {
    0%, 6% { background: transparent; border-color: var(--line-strong); color: transparent; transform: scale(1); }
    10% { background: var(--color-flame-500); border-color: var(--color-flame-500); color: #1a0d03; transform: scale(1.18); }
    14%, 100% { background: var(--color-flame-500); border-color: var(--color-flame-500); color: #1a0d03; transform: scale(1); }
  }
  @keyframes av-last { 0%, 30% { opacity: .5; } 36%, 100% { opacity: 1; } }
</style>
