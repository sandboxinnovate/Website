---
/**
 * The ToolBadge "app tile" drawn inside an SVG (hero visuals are SVG drawings): a tinted rounded
 * square with the shared generic tool icon. Same icons and tints as ToolBadge.astro.
 */
import { TOOL_ICONS, TOOL_TINTS, type ToolKey } from '@/components/ui/tool-icons';

interface Props { tool: ToolKey; x: number; y: number; size?: number; class?: string }
const { tool, x, y, size = 28, class: cls } = Astro.props;
const t = TOOL_ICONS[tool];
const [bg, fg] = TOOL_TINTS[t.tint];
const pad = size * 0.21;
const r = (n: number) => Math.round(n * 10) / 10;
---
<g class:list={['svt', cls]}>
  <rect x={r(x)} y={r(y)} width={size} height={size} rx={r(size * 0.3)} style={`fill:var(--color-ink-900)`} />
  <rect x={r(x)} y={r(y)} width={size} height={size} rx={r(size * 0.3)} style={`fill:${bg};stroke:rgb(255 255 255 / .08)`} />
  <svg x={r(x + pad)} y={r(y + pad)} width={r(size - pad * 2)} height={r(size - pad * 2)} viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" style={`stroke:${fg}`} set:html={t.paths} />
</g>
