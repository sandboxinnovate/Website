---
/**
 * Brains hero: three isometric layers: sources (your tools) feed the brain, the brain powers agents.
 * Pulses rise through the layers; agents light up in turn; a log line cycles underneath.
 */
import VisualFrame from './VisualFrame.astro';
import { VISUAL_COPY } from './copy';
import type { Lang } from '@/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = VISUAL_COPY[lang];
const t = c.brains;

// Isometric plane geometry
const CX = 300, HW = 190, HH = 66, GAP = 140;
const CY = [92, 232, 372]; // agents, brain, sources
const iso = (a: number, b: number, cy: number) => ({ x: CX + (a - b) * HW, y: cy - HH + (a + b) * HH });
const plane = (cy: number) => `M${CX} ${cy - HH} L${CX + HW} ${cy} L${CX} ${cy + HH} L${CX - HW} ${cy} Z`;
const gridLines = (cy: number) =>
  [0.25, 0.5, 0.75].flatMap((k) => {
    const a0 = iso(k, 0, cy), a1 = iso(k, 1, cy), b0 = iso(0, k, cy), b1 = iso(1, k, cy);
    return [`M${a0.x} ${a0.y} L${a1.x} ${a1.y}`, `M${b0.x} ${b0.y} L${b1.x} ${b1.y}`];
  });

const SRC_AB: [number, number, 'l' | 'r'][] = [[0.2, 0.2, 'r'], [0.2, 0.76, 'l'], [0.76, 0.2, 'r'], [0.58, 0.88, 'l'], [0.9, 0.58, 'r']];
const sources = SRC_AB.map(([a, b, side], i) => ({ ...iso(a, b, CY[2]), side, label: t.sources[i] }));

const AG_AB: [number, number][] = [[0.22, 0.32], [0.74, 0.24], [0.3, 0.8], [0.8, 0.74]];
const agents = AG_AB.map(([a, b], i) => ({ ...iso(a, b, CY[0]), label: t.agents[i] }));

// Brain nodes: projections of sources + agent anchors + internal nodes
const INNER: [number, number][] = [[0.4, 0.4], [0.52, 0.22], [0.68, 0.42], [0.4, 0.62], [0.62, 0.64], [0.28, 0.52], [0.54, 0.8], [0.8, 0.52]];
const core = iso(0.5, 0.5, CY[1]);
const brainNodes = [
  ...SRC_AB.map(([a, b]) => iso(a, b, CY[1])),
  ...AG_AB.map(([a, b]) => iso(a, b, CY[1])),
  ...INNER.map(([a, b]) => iso(a, b, CY[1])),
];
// Edges: each node to its two nearest neighbours (deduplicated) + inner nodes to the core
const key = (i: number, j: number) => (i < j ? `${i}-${j}` : `${j}-${i}`);
const edgeSet = new Set<string>();
brainNodes.forEach((n, i) => {
  brainNodes
    .map((m, j) => ({ j, d: Math.hypot(m.x - n.x, (m.y - n.y) * 2) }))
    .filter((o) => o.j !== i)
    .sort((p, q) => p.d - q.d)
    .slice(0, 2)
    .forEach((o) => edgeSet.add(key(i, o.j)));
});
const edges = [...edgeSet].map((k) => k.split('-').map(Number) as [number, number]);
const innerStart = SRC_AB.length + AG_AB.length;

const pill = (s: string, fs: number) => s.length * fs * 0.62 + 16;
const r1 = (n: number) => Math.round(n * 10) / 10;
---
<VisualFrame file={t.file} label={c.illustrative} class="bv">
  <svg viewBox="0 0 560 460" class="bv__svg">
    <defs>
      <radialGradient id={`bv-core-${lang}`} cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="#f58327" stop-opacity=".55" />
        <stop offset=".5" stop-color="#d94c00" stop-opacity=".18" />
        <stop offset="1" stop-color="#d94c00" stop-opacity="0" />
      </radialGradient>
      <linearGradient id={`bv-plane-${lang}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#fff" stop-opacity=".045" />
        <stop offset="1" stop-color="#fff" stop-opacity=".01" />
      </linearGradient>
    </defs>

    {/* Planes (bottom → top so upper layers overlap) */}
    {[2, 1, 0].map((li) => (
      <g class:list={['bv__layer', `bv__layer--${li}`]}>
        <path d={plane(CY[li])} class="bv__plane" fill={`url(#bv-plane-${lang})`} />
        {gridLines(CY[li]).map((d) => <path d={d} class="bv__grid" />)}
        <path d={`M${CX - HW - 6} ${CY[li]} L${CX - HW - 26} ${CY[li]}`} class="bv__leader" />
        <text x="16" y={CY[li] - 3} class="bv__lname">{t.layers[li].name.toUpperCase()}</text>
        <text x="16" y={CY[li] + 13} class="bv__lsub">{t.layers[li].sub}</text>
      </g>
    ))}

    {/* Brain glow + graph */}
    <ellipse cx={core.x} cy={core.y} rx="150" ry="56" fill={`url(#bv-core-${lang})`} class="bv__glow" />
    <g class="bv__edges">
      {edges.map(([i, j]) => <line x1={r1(brainNodes[i].x)} y1={r1(brainNodes[i].y)} x2={r1(brainNodes[j].x)} y2={r1(brainNodes[j].y)} />)}
      {brainNodes.slice(innerStart).map((n) => <line x1={r1(n.x)} y1={r1(n.y)} x2={core.x} y2={core.y} class="bv__spoke" />)}
    </g>
    <g class="bv__bnodes">
      {brainNodes.map((n, i) => <circle cx={r1(n.x)} cy={r1(n.y)} r={i >= innerStart ? 2.6 : 3.4} style={`--k:${i}`} />)}
    </g>
    <circle cx={core.x} cy={core.y} r="7" class="bv__core" />
    <circle cx={core.x} cy={core.y} r="14" class="bv__core-ring" />

    {/* Vertical connectors: sources → brain, brain → agents */}
    <g class="bv__risers">
      {sources.map((s) => <path d={`M${r1(s.x)} ${r1(s.y)} L${r1(s.x)} ${r1(s.y - GAP)}`} />)}
      {agents.map((a) => <path d={`M${r1(a.x)} ${r1(a.y + GAP)} L${r1(a.x)} ${r1(a.y)}`} />)}
    </g>
    <g class="bv__pulses">
      {sources.map((s, i) => <path d={`M${r1(s.x)} ${r1(s.y)} L${r1(s.x)} ${r1(s.y - GAP)}`} pathLength="100" style={`--d:${i * 0.9}s`} />)}
      {agents.map((a, i) => <path d={`M${r1(a.x)} ${r1(a.y + GAP)} L${r1(a.x)} ${r1(a.y)}`} pathLength="100" style={`--d:${1.6 + i * 1.1}s`} class="bv__pulse--up" />)}
    </g>

    {/* Sources */}
    <g class="bv__sources">
      {sources.map((s) => {
        const w = pill(s.label, 12);
        const x = s.side === 'r' ? s.x + 10 : s.x - 10 - w;
        return (
          <g>
            <circle cx={r1(s.x)} cy={r1(s.y)} r="4" class="bv__snode" />
            <rect x={r1(x)} y={r1(s.y - 11)} width={r1(w)} height="22" rx="11" class="bv__spill" />
            <text x={r1(x + w / 2)} y={r1(s.y + 4)} text-anchor="middle" class="bv__stext">{s.label}</text>
          </g>
        );
      })}
    </g>

    {/* Agents */}
    <g class="bv__agents">
      {agents.map((a, i) => {
        const w = pill(a.label, 12.5) + 14;
        return (
          <g class="bv__agent" style={`--k:${i}`}>
            <rect x={r1(a.x - w / 2)} y={r1(a.y - 26)} width={r1(w)} height="26" rx="13" class="bv__apill" />
            <circle cx={r1(a.x - w / 2 + 13)} cy={r1(a.y - 13)} r="3.5" class="bv__adot" />
            <text x={r1(a.x - w / 2 + 23)} y={r1(a.y - 8.5)} class="bv__atext">{a.label}</text>
            <circle cx={r1(a.x)} cy={r1(a.y)} r="3" class="bv__anode" />
          </g>
        );
      })}
    </g>
  </svg>

  <div class="bv__log">
    <span class="bv__prompt">$</span>
    <span class="bv__lines">
      {t.log.map((l, i) => <span class="bv__line" style={`--k:${i}`}>{l}</span>)}
    </span>
  </div>
</VisualFrame>

<style>
  .bv__svg { display: block; width: 100%; height: auto; padding: 14px 10px 0; overflow: visible; }
  .bv__plane { stroke: rgb(255 255 255 / .16); stroke-width: 1; }
  .bv__layer--1 .bv__plane { stroke: rgb(245 131 39 / .45); }
  .bv__grid { stroke: rgb(255 255 255 / .05); stroke-width: 1; fill: none; }
  .bv__leader { stroke: rgb(255 255 255 / .2); stroke-width: 1; stroke-dasharray: 2 3; }
  .bv__lname { font-family: var(--font-mono); font-size: 12.5px; letter-spacing: .1em; fill: var(--color-bone); }
  .bv__layer--1 .bv__lname { fill: var(--color-flame-400); }
  .bv__lsub { font-family: var(--font-mono); font-size: 11px; fill: var(--color-smoke); }

  .bv__edges line { stroke: rgb(255 168 102 / .32); stroke-width: 1; }
  .bv__edges .bv__spoke { stroke: rgb(255 168 102 / .16); }
  .bv__bnodes circle { fill: var(--color-flame-300); }
  .bv__core { fill: var(--color-sun); filter: drop-shadow(0 0 8px #f58327); }
  .bv__core-ring { fill: none; stroke: rgb(255 210 31 / .5); stroke-width: 1; transform-box: fill-box; transform-origin: center; }

  .bv__risers path { stroke: rgb(255 255 255 / .14); stroke-width: 1; stroke-dasharray: 3 4; fill: none; }
  .bv__pulses path { stroke: var(--color-flame-400); stroke-width: 2; stroke-linecap: round; fill: none; stroke-dasharray: 0 100; opacity: 0; }

  .bv__snode { fill: var(--color-ink-950); stroke: var(--color-bone); stroke-width: 1.4; }
  .bv__spill { fill: rgb(10 10 10 / .85); stroke: rgb(255 255 255 / .16); }
  .bv__stext { font-family: var(--font-mono); font-size: 12px; fill: var(--color-mist); }

  .bv__apill { fill: var(--color-ink-800); stroke: rgb(245 131 39 / .45); }
  .bv__adot { fill: var(--color-ok); }
  .bv__atext { font-family: var(--font-mono); font-size: 12.5px; fill: var(--color-bone); }
  .bv__anode { fill: var(--color-flame-400); }

  .bv__log { display: flex; align-items: center; gap: 10px; margin: 6px 16px 16px; padding: 10px 14px; border-radius: 12px; border: 1px solid var(--line); background: rgb(10 10 10 / .6); font-family: var(--font-mono); font-size: 12px; color: var(--color-mist); }
  .bv__prompt { color: var(--color-flame-400); }
  .bv__lines { position: relative; display: grid; flex: 1; min-width: 0; height: 1.5em; overflow: hidden; }
  .bv__line { grid-area: 1 / 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; opacity: 0; }
  .bv__line:first-child { opacity: 1; }

  @media (prefers-reduced-motion: no-preference) {
    .bv__pulses path { animation: bv-rise 4.4s var(--ease-out-expo) infinite; animation-delay: var(--d); }
    .bv__glow { animation: bv-breathe 5s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
    .bv__core-ring { animation: bv-ring 2.6s var(--ease-out-expo) infinite; }
    .bv__bnodes circle { animation: bv-twinkle 3.2s ease-in-out infinite; animation-delay: calc(var(--k) * -0.37s); }
    .bv__adot { animation: bv-agent 4.4s ease-in-out infinite; animation-delay: calc(var(--k) * 1.1s + 1.6s); }
    .bv__agent .bv__apill { animation: bv-apill 4.4s ease-in-out infinite; animation-delay: calc(var(--k) * 1.1s + 1.6s); }
    .bv__line { animation: bv-log 12s infinite; animation-delay: calc(var(--k) * 3s); }
    .bv__line:first-child { opacity: 0; }
  }
  @keyframes bv-rise {
    0% { stroke-dasharray: 0 100; stroke-dashoffset: 0; opacity: 0; }
    8% { opacity: 1; }
    40% { stroke-dasharray: 18 100; stroke-dashoffset: -82; opacity: 1; }
    48%, 100% { stroke-dasharray: 18 100; stroke-dashoffset: -100; opacity: 0; }
  }
  @keyframes bv-breathe { 0%, 100% { opacity: .75; transform: scale(1); } 50% { opacity: 1; transform: scale(1.08); } }
  @keyframes bv-ring { 0% { transform: scale(.6); opacity: .9; } 100% { transform: scale(2.2); opacity: 0; } }
  @keyframes bv-twinkle { 0%, 100% { opacity: 1; } 50% { opacity: .45; } }
  @keyframes bv-agent { 0%, 30%, 100% { fill: var(--color-ok); } 8%, 22% { fill: var(--color-sun); } }
  @keyframes bv-apill { 0%, 34%, 100% { stroke: rgb(245 131 39 / .45); } 8%, 24% { stroke: rgb(255 210 31 / .95); } }
  @keyframes bv-log { 0% { opacity: 0; transform: translateY(8px); } 3%, 22% { opacity: 1; transform: none; } 25%, 100% { opacity: 0; transform: translateY(-8px); } }
</style>
