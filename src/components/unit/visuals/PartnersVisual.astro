---
/**
 * Partners hero: two-brand handoff. Modules leave Sandbox (builds & runs), cross a
 * white-label layer where they take the partner's brand, and arrive at the agency,
 * which delivers to its client under one brand.
 */
import VisualFrame from './VisualFrame.astro';
import { VISUAL_COPY } from './copy';
import type { Lang } from '@/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = VISUAL_COPY[lang];
const t = c.partners;

const LANES = [150, 196, 242];
const PW = 64; // packet width
---
<VisualFrame file={t.file} label={c.illustrative} class="ptv">
  <svg viewBox="0 0 560 430" class="ptv__svg">
    <defs>
      <pattern id={`ptv-hatch-${lang}`} width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="8" stroke="rgb(245 131 39 / .35)" stroke-width="1.2" />
      </pattern>
      <linearGradient id={`ptv-you-${lang}`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#2a2321" />
        <stop offset="1" stop-color="#1a1717" />
      </linearGradient>
    </defs>

    {/* Sandbox block (behind, dashed) */}
    <g class="ptv__sbx">
      <rect x="14" y="92" width="172" height="196" rx="18" class="ptv__sbx-box" />
      <text x="100" y="64" text-anchor="middle" class="ptv__top">{t.sbxSub}</text>
      <text x="34" y="128" class="ptv__name ptv__name--dim">{t.sbx.toUpperCase()}</text>
      {LANES.map((y, i) => (
        <g>
          <rect x="34" y={y + 2} width="132" height="26" rx="8" class="ptv__slot" />
          <text x="46" y={y + 19} class="ptv__slot-t">{t.packets[i]}</text>
        </g>
      ))}
    </g>

    {/* Wires */}
    {LANES.map((y) => <path d={`M186 ${y + 15} L374 ${y + 15}`} class="ptv__wire" />)}

    {/* White-label layer */}
    <g class="ptv__layer">
      <rect x="262" y="78" width="36" height="224" rx="10" fill={`url(#ptv-hatch-${lang})`} class="ptv__layer-box" />
      <text x="280" y="64" text-anchor="middle" class="ptv__layer-t">{t.layer}</text>
      <text x="460" y="64" text-anchor="middle" class="ptv__top ptv__top--you">{t.youSub}</text>
    </g>

    {/* Packets */}
    {LANES.map((y, i) => (
      <g class="ptv__pkt" style={`--k:${i}`}>
        <rect x="190" y={y + 4} width={PW} height="22" rx="7" class="ptv__pkt-box" />
        <text x={190 + PW / 2} y={y + 19} text-anchor="middle" class="ptv__pkt-t">{t.packets[i]}</text>
      </g>
    ))}

    {/* Your agency (front, solid) */}
    <g class="ptv__you">
      <rect x="374" y="82" width="172" height="216" rx="18" fill={`url(#ptv-you-${lang})`} class="ptv__you-box" />
      <rect x="394" y="104" width="26" height="26" rx="8" class="ptv__logo" />
      <path d="M401 121 L407 111 L413 121" class="ptv__logo-mark" />
      <text x="430" y="122" class="ptv__name">{t.you}</text>
      {LANES.map((y, i) => (
        <g class="ptv__got" style={`--k:${i}`}>
          <rect x="394" y={y + 2} width="132" height="26" rx="8" class="ptv__got-box" />
          <circle cx="408" cy={y + 15} r="3" class="ptv__got-dot" />
          <text x="418" y={y + 19} class="ptv__got-t">{t.packets[i]}</text>
        </g>
      ))}
    </g>

    {/* Client */}
    <path d="M460 298 L460 344" class="ptv__wire ptv__wire--down" />
    <path d="M460 298 L460 344" class="ptv__down-pulse" pathLength="100" />
    <g class="ptv__client">
      <rect x="374" y="344" width="172" height="62" rx="16" class="ptv__client-box" />
      <circle cx="396" cy="375" r="8" class="ptv__client-av" />
      <text x="414" y="371" class="ptv__name ptv__name--sm">{t.client}</text>
      <text x="414" y="388" class="ptv__sub">{t.clientSub}</text>
    </g>
  </svg>
</VisualFrame>

<style>
  .ptv__svg { display: block; width: 100%; height: auto; padding: 8px 6px 4px; }
  .ptv__name { font-family: var(--font-display); font-size: 15px; letter-spacing: -.02em; fill: var(--color-bone); }
  .ptv__name--dim { font-family: var(--font-mono); font-size: 12px; letter-spacing: .14em; fill: var(--color-mist); }
  .ptv__name--sm { font-size: 13.5px; }
  .ptv__sub { font-family: var(--font-mono); font-size: 10.5px; fill: var(--color-smoke); }
  .ptv__top { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; fill: var(--color-smoke); }
  .ptv__top--you { fill: var(--color-bone); }

  .ptv__sbx-box { fill: rgb(255 255 255 / .015); stroke: rgb(255 255 255 / .2); stroke-dasharray: 4 5; }
  .ptv__slot { fill: rgb(255 255 255 / .03); stroke: rgb(255 255 255 / .1); }
  .ptv__slot-t { font-family: var(--font-mono); font-size: 11px; fill: var(--color-smoke); }

  .ptv__wire { stroke: rgb(255 255 255 / .14); stroke-width: 1; stroke-dasharray: 3 4; fill: none; }
  .ptv__layer-box { stroke: rgb(245 131 39 / .55); stroke-width: 1; }
  .ptv__layer-t { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; fill: var(--color-flame-400); }

  .ptv__pkt { transform: translateX(110px); }
  .ptv__pkt-box { fill: var(--color-bone); stroke: none; }
  .ptv__pkt-t { font-family: var(--font-mono); font-size: 11px; fill: var(--color-ink-950); }

  .ptv__you-box { stroke: rgb(245 131 39 / .55); stroke-width: 1.2; filter: drop-shadow(0 18px 40px rgb(217 76 0 / .28)); }
  .ptv__logo { fill: var(--color-bone); }
  .ptv__logo-mark { stroke: var(--color-ink-950); stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .ptv__got-box { fill: rgb(244 239 233 / .06); stroke: rgb(244 239 233 / .22); }
  .ptv__got-dot { fill: var(--color-ok); }
  .ptv__got-t { font-family: var(--font-mono); font-size: 11px; fill: var(--color-bone); }

  .ptv__down-pulse { stroke: var(--color-flame-400); stroke-width: 2; stroke-linecap: round; fill: none; stroke-dasharray: 0 100; }
  .ptv__client-box { fill: rgb(255 255 255 / .03); stroke: rgb(255 255 255 / .16); }
  .ptv__client-av { fill: var(--color-ink-600); stroke: rgb(255 255 255 / .3); }

  @media (prefers-reduced-motion: no-preference) {
    .ptv__pkt { opacity: 0; transform: none; animation: ptv-move 6s var(--ease-in-out-quart) infinite; animation-delay: calc(var(--k) * 2s); }
    .ptv__pkt-box { animation: ptv-brand 6s var(--ease-in-out-quart) infinite; animation-delay: calc(var(--k) * 2s); }
    .ptv__pkt-t { animation: ptv-brand-t 6s var(--ease-in-out-quart) infinite; animation-delay: calc(var(--k) * 2s); }
    .ptv__got-box { animation: ptv-got 6s ease infinite; animation-delay: calc(var(--k) * 2s); }
    .ptv__down-pulse { animation: ptv-down 2s var(--ease-out-expo) infinite 1.6s; }
    .ptv__layer-box { animation: ptv-layer 2s ease-in-out infinite; }
  }
  @keyframes ptv-move {
    0% { opacity: 0; transform: translateX(0); }
    6% { opacity: 1; transform: translateX(0); }
    52% { opacity: 1; transform: translateX(110px); }
    62% { opacity: 0; transform: translateX(124px); }
    100% { opacity: 0; transform: translateX(124px); }
  }
  @keyframes ptv-brand { 0%, 26% { fill: var(--color-flame-500); } 34%, 100% { fill: var(--color-bone); } }
  @keyframes ptv-brand-t { 0%, 26% { fill: #1a0d03; } 34%, 100% { fill: var(--color-ink-950); } }
  @keyframes ptv-got { 0%, 54% { stroke: rgb(244 239 233 / .22); } 60%, 72% { stroke: rgb(245 131 39 / .9); } 90%, 100% { stroke: rgb(244 239 233 / .22); } }
  @keyframes ptv-down { 0% { stroke-dasharray: 0 100; stroke-dashoffset: 0; opacity: 1; } 60% { stroke-dasharray: 30 100; stroke-dashoffset: -70; opacity: 1; } 80%, 100% { stroke-dasharray: 30 100; stroke-dashoffset: -100; opacity: 0; } }
  @keyframes ptv-layer { 0%, 100% { stroke: rgb(245 131 39 / .4); } 50% { stroke: rgb(245 131 39 / .9); } }
</style>
