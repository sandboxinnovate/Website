---
/**
 * Consulting hero: a 12-week plan (simple timeline). Audit, then Sprint, then Head of AI.
 * A headline on top says where the project stands; a word legend explains the bar styles.
 * Responsive to its own width (container queries), not the viewport: at 1280 the hero column is narrow.
 * Bars fill up to "today", the marker slides in, active bars shimmer.
 */
import VisualFrame from './VisualFrame.astro';
import { VISUAL_COPY } from './copy';
import type { Lang } from '@/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = VISUAL_COPY[lang];
const t = c.consulting;

const WEEKS = 12;
const TODAY = 5.5; // weeks elapsed
// [start week (1-based), span in weeks, phase, kind]
const ROWS: [number, number, 0 | 1 | 2, 'bar' | 'milestone' | 'sessions' | 'open'][] = [
  [1, 2, 0, 'bar'],
  [2, 2, 0, 'bar'],
  [3, 1, 0, 'milestone'],
  [4, 3, 1, 'bar'],
  [5, 4, 1, 'bar'],
  [7, 4, 1, 'bar'],
  [6, 6, 1, 'sessions'],
  [11, 2, 2, 'open'],
];
const rows = ROWS.map(([start, span, phase, kind], i) => {
  const p = Math.max(0, Math.min(1, (TODAY - (start - 1)) / span));
  return { label: t.rows[i], left: ((start - 1) / WEEKS) * 100, width: (span / WEEKS) * 100, phase, kind, p, active: p > 0 && p < 1 };
});
const PHASES: [number, number][] = [[1, 3], [4, 10], [11, 12]];
const nDone = rows.filter((r) => r.p >= 1).length;
const nNow = rows.filter((r) => r.active).length;
const nNext = rows.length - nDone - nNow;
const AXIS = [1, 4, 8, 12];
---
<VisualFrame title={t.title} label={c.illustrative} labelShort={c.illustrativeShort} class="cv">
  <div class="cv__wrap">
    <div class="cv__top">
      <div class="cv__headline">
        <span class="cv__k">{t.headline}</span>
        <span class="cv__big">{t.weekOf(Math.ceil(TODAY), WEEKS)}</span>
      </div>
      <ul class="cv__counts">
        <li class="cv__count cv__count--done"><b>{nDone}</b> {t.done}</li>
        <li class="cv__count cv__count--now"><b>{nNow}</b> {t.inProgress}</li>
        <li class="cv__count"><b>{nNext}</b> {t.upNext}</li>
      </ul>
    </div>

    <div class="cv__grid">
      <div class="cv__corner cv__corner--ph"></div>
      <div class="cv__phases">
        {PHASES.map(([a, b], i) => (
          <span class:list={['cv__phase', `cv__phase--${i}`]} style={`left:${((a - 1) / WEEKS) * 100}%; width:${((b - a + 1) / WEEKS) * 100}%`}>
            <span class="cv__ph-long">{t.phases[i]}</span><span class="cv__ph-short">{t.phasesShort[i]}</span><span class="cv__ph-range">{t.range(a, b)}</span>
          </span>
        ))}
      </div>

      <div class="cv__corner cv__axis-k">{t.weeksLabel}</div>
      <div class="cv__weeks">
        {AXIS.map((w) => <span style={`left:${((w - 0.5) / WEEKS) * 100}%`}>{w}</span>)}
      </div>

      <div class="cv__labels">
        {rows.map((r) => <span class:list={['cv__label', r.p >= 1 && 'is-done', r.active && 'is-active']}>{r.label}</span>)}
      </div>
      <div class="cv__lanes">
        {PHASES.slice(1).map(([a]) => <span class="cv__divider" style={`left:${((a - 1) / WEEKS) * 100}%`}></span>)}
        {rows.map((r, i) => (
          <div class="cv__lane">
            {r.kind === 'milestone' ? (
              <span class="cv__ms" style={`left:calc(${r.left + r.width}% - 7px); --k:${i}`}>
                <span class="cv__ms-gem"></span>
                <span class="cv__ms-label">{t.milestone}</span>
              </span>
            ) : (
              <span
                class:list={['cv__bar', `cv__bar--${r.kind}`, `cv__bar--ph${r.phase}`, r.active && 'is-active']}
                style={`left:${r.left}%; width:${r.width}%; --p:${r.p}; --k:${i}`}
              >
                <span class="cv__fill"></span>
              </span>
            )}
          </div>
        ))}
        <span class="cv__today" style={`left:${(TODAY / WEEKS) * 100}%`}>
          <span class="cv__today-tag">{t.today}</span>
        </span>
      </div>
    </div>

    <ul class="cv__legend">
      <li><i class="cv__key cv__key--done"></i>{t.legend.done}</li>
      <li><i class="cv__key cv__key--planned"></i>{t.legend.planned}</li>
      <li><i class="cv__key cv__key--sessions"></i>{t.legend.sessions}</li>
      <li><i class="cv__key cv__key--ms"></i>{t.legend.milestone}</li>
    </ul>
  </div>
</VisualFrame>

<style>
  .cv__wrap { padding: 18px 18px 18px 16px; container-type: inline-size; }

  .cv__top { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 10px 16px; margin-bottom: 18px; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
  .cv__headline { display: flex; flex-direction: column; gap: 2px; }
  .cv__k { font-size: 12.5px; font-weight: 600; color: var(--color-smoke); }
  .cv__big { font-family: var(--font-display); font-size: 22px; letter-spacing: -.03em; color: var(--color-bone); }
  .cv__counts { display: flex; flex-wrap: wrap; gap: 6px; }
  .cv__count { padding: 4px 10px; border-radius: 99px; font-size: 12.5px; color: var(--color-mist); border: 1px solid var(--line); background: rgb(255 255 255 / .03); white-space: nowrap; }
  .cv__count b { font-weight: 700; color: var(--color-bone); }
  .cv__count--done { color: var(--color-ok); border-color: rgb(122 209 155 / .3); background: rgb(122 209 155 / .07); }
  .cv__count--done b { color: var(--color-ok); }
  .cv__count--now { color: var(--color-flame-300); border-color: rgb(245 131 39 / .4); background: rgb(245 131 39 / .08); }
  .cv__count--now b { color: var(--color-flame-300); }

  .cv__grid { display: grid; grid-template-columns: minmax(96px, 32%) minmax(0, 1fr); column-gap: 14px; }
  .cv__corner { min-height: 1px; }
  .cv__axis-k { display: flex; align-items: center; justify-content: flex-end; font-size: 12px; color: var(--color-smoke); }

  .cv__phases { position: relative; height: 30px; }
  .cv__phase { position: absolute; top: 0; height: 24px; display: flex; align-items: center; padding: 0 8px; border-radius: 7px; font-size: 12.5px; font-weight: 600; white-space: nowrap; overflow: hidden; color: var(--color-mist); border: 1px solid var(--line); background: rgb(255 255 255 / .02); box-sizing: border-box; }
  .cv__phase > span { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .cv__ph-short { display: none; }
  /* The 2-week "ongoing" phase is the narrowest: it switches to its short label first. */
  @container (max-width: 640px) { .cv__phase--2 .cv__ph-long { display: none; } .cv__phase--2 .cv__ph-short { display: inline; } }
  .cv__ph-range { display: none; font-weight: 400; color: var(--color-mist); }
  /* Narrow cards: phases become a row of plain chips ("Audit · Weeks 1-3") above the timeline. */
  @container (max-width: 520px) {
    .cv__corner--ph { display: none; }
    .cv__phases { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 6px; height: auto; margin-bottom: 14px; }
    .cv__phase { position: static; width: auto !important; height: 28px; padding: 0 10px; gap: 6px; }
    .cv__phase .cv__ph-long { display: inline; }
    .cv__phase .cv__ph-short { display: none; }
    .cv__ph-range { display: inline; }
  }
  .cv__phase--0 { color: var(--color-sun); border-color: rgb(252 168 0 / .35); background: rgb(252 168 0 / .06); }
  .cv__phase--1 { color: var(--color-flame-400); border-color: rgb(245 131 39 / .35); background: rgb(245 131 39 / .06); }

  .cv__weeks { position: relative; height: 24px; border-bottom: 1px solid var(--line); }
  .cv__weeks span { position: absolute; top: 4px; transform: translateX(-50%); font-size: 12px; color: var(--color-smoke); }

  .cv__labels { display: flex; flex-direction: column; }
  .cv__label { height: 38px; display: flex; align-items: center; font-size: 13.5px; line-height: 1.15; color: var(--color-mist); }
  .cv__label.is-done { color: var(--color-mist); }
  .cv__label.is-active { color: var(--color-bone); font-weight: 600; }
  @container (max-width: 520px) { .cv__label { font-size: 12px; } }

  .cv__lanes { position: relative; }
  .cv__divider { position: absolute; top: 0; bottom: 0; width: 1px; background: rgb(255 255 255 / .07); }
  .cv__lane { position: relative; height: 38px; }

  .cv__bar { position: absolute; top: 11px; height: 16px; border-radius: 8px; border: 1px solid rgb(255 255 255 / .2); background: rgb(255 255 255 / .04); overflow: hidden; }
  .cv__fill { position: absolute; inset: 0; transform-origin: left; transform: scaleX(var(--p)); border-radius: inherit; }
  .cv__bar--ph0 .cv__fill { background: linear-gradient(90deg, #fca800, #f58327); }
  .cv__bar--ph1 .cv__fill { background: linear-gradient(90deg, #f58327, #d65805); }
  .cv__bar--ph0 { border-color: rgb(252 168 0 / .4); }
  .cv__bar--ph1 { border-color: rgb(245 131 39 / .4); }
  .cv__bar--sessions { background-image: repeating-linear-gradient(90deg, rgb(255 255 255 / .1) 0 10px, transparent 10px 16px); }
  .cv__bar--sessions .cv__fill { -webkit-mask: repeating-linear-gradient(90deg, #000 0 10px, transparent 10px 16px); mask: repeating-linear-gradient(90deg, #000 0 10px, transparent 10px 16px); }
  .cv__bar--open { border-style: dashed; border-color: rgb(255 255 255 / .3); border-right: 0; border-radius: 8px 0 0 8px; -webkit-mask: linear-gradient(90deg, #000 60%, transparent); mask: linear-gradient(90deg, #000 60%, transparent); }
  .cv__bar.is-active { box-shadow: 0 0 18px -2px rgb(245 131 39 / .55); }

  .cv__ms { position: absolute; top: 11px; display: flex; align-items: center; gap: 8px; }
  .cv__ms-gem { flex: none; width: 15px; height: 15px; transform: rotate(45deg); border-radius: 3px; background: var(--color-sun); box-shadow: 0 0 14px rgb(255 210 31 / .6); }
  .cv__ms-label { font-size: 12.5px; font-weight: 600; color: var(--color-sun); white-space: nowrap; }

  .cv__today { position: absolute; top: 0; bottom: -6px; width: 2px; margin-left: -1px; border-radius: 2px; background: linear-gradient(rgb(245 131 39 / .3), var(--color-flame-400)); }
  .cv__today-tag { position: absolute; top: 100%; left: 50%; transform: translate(-50%, 4px); padding: 2px 10px; border-radius: 99px; background: var(--color-flame-500); color: #1a0d03; font-size: 12px; font-weight: 700; white-space: nowrap; }
  .cv__today::after { content: ''; position: absolute; top: -4px; left: -3px; width: 8px; height: 8px; border-radius: 9px; background: var(--color-flame-400); }

  .cv__legend { display: flex; flex-wrap: wrap; gap: 8px 16px; margin-top: 38px; padding-top: 12px; border-top: 1px solid var(--line); font-size: 12.5px; color: var(--color-mist); }
  .cv__legend li { display: inline-flex; align-items: center; gap: 7px; }
  .cv__key { display: inline-block; width: 20px; height: 9px; border-radius: 5px; }
  .cv__key--done { background: linear-gradient(90deg, #fca800, #f58327); }
  .cv__key--planned { border: 1px solid rgb(255 255 255 / .3); background: rgb(255 255 255 / .04); }
  .cv__key--sessions { background: repeating-linear-gradient(90deg, #f58327 0 5px, transparent 5px 8px); }
  .cv__key--ms { width: 10px; height: 10px; margin-inline: 4px; border-radius: 2px; transform: rotate(45deg); background: var(--color-sun); }

  @media (prefers-reduced-motion: no-preference) {
    .cv__fill { animation: cv-fill 1.3s var(--ease-out-expo) both; animation-delay: calc(var(--k) * 110ms + 300ms); }
    .cv__ms-gem { animation: cv-gem 2.8s ease-in-out infinite; }
    .cv__today { animation: cv-today 1.6s var(--ease-out-expo) both .2s; }
    .cv__bar.is-active::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, transparent, rgb(255 255 255 / .35), transparent); transform: translateX(-100%); animation: cv-shine 3.2s ease-in-out infinite 1.8s; }
  }
  @keyframes cv-fill { from { transform: scaleX(0); } to { transform: scaleX(var(--p)); } }
  @keyframes cv-gem { 0%, 100% { box-shadow: 0 0 6px rgb(255 210 31 / .4); } 50% { box-shadow: 0 0 20px rgb(255 210 31 / .9); } }
  @keyframes cv-today { from { opacity: 0; transform: translateX(-40px); } to { opacity: 1; transform: none; } }
  @keyframes cv-shine { 0% { transform: translateX(-100%); } 45%, 100% { transform: translateX(100%); } }
</style>
