---
/**
 * Consulting hero: a 12-week roadmap (Gantt). Diagnostic → Sprint → Head of AI.
 * Bars fill up to "today", the marker slides in, active bars shimmer.
 */
import VisualFrame from './VisualFrame.astro';
import { VISUAL_COPY } from './copy';
import type { Lang } from '@/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = VISUAL_COPY[lang];
const t = c.consulting;

const WEEKS = 12;
const TODAY = 5.5; // weeks elapsed
// [start week (1-based), span in weeks, phase, kind]
const ROWS: [number, number, 0 | 1 | 2, 'bar' | 'milestone' | 'sessions' | 'open'][] = [
  [1, 2, 0, 'bar'],
  [2, 2, 0, 'bar'],
  [3, 1, 0, 'milestone'],
  [4, 3, 1, 'bar'],
  [5, 4, 1, 'bar'],
  [7, 4, 1, 'bar'],
  [6, 6, 1, 'sessions'],
  [11, 2, 2, 'open'],
];
const rows = ROWS.map(([start, span, phase, kind], i) => {
  const p = Math.max(0, Math.min(1, (TODAY - (start - 1)) / span));
  return { label: t.rows[i], left: ((start - 1) / WEEKS) * 100, width: (span / WEEKS) * 100, phase, kind, p, active: p > 0 && p < 1 };
});
const PHASES: [number, number][] = [[1, 3], [4, 10], [11, 12]];
---
<VisualFrame file={t.file} label={c.illustrative} class="cv">
  <div class="cv__wrap">
    <div class="cv__grid">
      <div class="cv__corner"></div>
      <div class="cv__phases">
        {PHASES.map(([a, b], i) => (
          <span class:list={['cv__phase', `cv__phase--${i}`]} style={`left:${((a - 1) / WEEKS) * 100}%; width:${((b - a + 1) / WEEKS) * 100}%`}>
            <span class="cv__ph-long">{t.phases[i]}</span><span class="cv__ph-short">{t.phasesShort[i]}</span>
          </span>
        ))}
      </div>

      <div class="cv__corner"></div>
      <div class="cv__weeks">
        {Array.from({ length: WEEKS }, (_, i) => <span>{t.week}{i + 1}</span>)}
      </div>

      <div class="cv__labels">
        {rows.map((r) => <span class:list={['cv__label', r.p >= 1 && 'is-done', r.active && 'is-active']}>{r.label}</span>)}
      </div>
      <div class="cv__lanes">
        {rows.map((r, i) => (
          <div class="cv__lane">
            {r.kind === 'milestone' ? (
              <span class="cv__ms" style={`left:calc(${r.left + r.width}% - 7px); --k:${i}`}>
                <span class="cv__ms-gem"></span>
                <span class="cv__ms-label">{t.milestone}</span>
              </span>
            ) : (
              <span
                class:list={['cv__bar', `cv__bar--${r.kind}`, `cv__bar--ph${r.phase}`, r.active && 'is-active']}
                style={`left:${r.left}%; width:${r.width}%; --p:${r.p}; --k:${i}`}
              >
                <span class="cv__fill"></span>
              </span>
            )}
          </div>
        ))}
        <span class="cv__today" style={`left:${(TODAY / WEEKS) * 100}%`}>
          <span class="cv__today-tag">{t.today} · {t.week}6</span>
        </span>
      </div>
    </div>
  </div>
</VisualFrame>

<style>
  .cv__wrap { padding: 22px 18px 40px 16px; }
  .cv__grid { display: grid; grid-template-columns: minmax(96px, 30%) minmax(0, 1fr); column-gap: 14px; }
  .cv__corner { min-height: 1px; }

  .cv__phases { position: relative; height: 30px; }
  .cv__phase { position: absolute; top: 0; height: 22px; display: flex; align-items: center; padding: 0 8px; border-radius: 6px; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; overflow: hidden; color: var(--color-mist); border: 1px solid var(--line); background: rgb(255 255 255 / .02); box-sizing: border-box; }
  .cv__ph-short { display: none; }
  @media (max-width: 560px) { .cv__ph-long { display: none; } .cv__ph-short { display: inline; } .cv__phase { padding: 0 5px; font-size: 10px; } }
  .cv__phase--0 { color: var(--color-sun); border-color: rgb(252 168 0 / .35); background: rgb(252 168 0 / .06); }
  .cv__phase--1 { color: var(--color-flame-400); border-color: rgb(245 131 39 / .35); background: rgb(245 131 39 / .06); }

  .cv__weeks { display: grid; grid-template-columns: repeat(12, 1fr); height: 24px; align-items: center; border-bottom: 1px solid var(--line); }
  .cv__weeks span { font-family: var(--font-mono); font-size: 10px; color: var(--color-smoke); text-align: left; padding-left: 3px; }
  @media (max-width: 560px) { .cv__weeks span:nth-child(even) { visibility: hidden; } }

  .cv__labels { display: flex; flex-direction: column; }
  .cv__label { height: 38px; display: flex; align-items: center; font-size: 13px; line-height: 1.15; color: var(--color-smoke); border-bottom: 1px solid rgb(255 255 255 / .04); }
  .cv__label.is-done { color: var(--color-mist); }
  .cv__label.is-active { color: var(--color-bone); }
  @media (max-width: 560px) { .cv__label { font-size: 11.5px; } }

  .cv__lanes { position: relative; background-image: linear-gradient(to right, rgb(255 255 255 / .05) 1px, transparent 1px); background-size: calc(100% / 12) 100%; }
  .cv__lane { position: relative; height: 38px; border-bottom: 1px solid rgb(255 255 255 / .04); }

  .cv__bar { position: absolute; top: 12px; height: 14px; border-radius: 7px; border: 1px solid rgb(255 255 255 / .16); background: rgb(255 255 255 / .03); overflow: hidden; }
  .cv__fill { position: absolute; inset: 0; transform-origin: left; transform: scaleX(var(--p)); border-radius: inherit; }
  .cv__bar--ph0 .cv__fill { background: linear-gradient(90deg, #fca800, #f58327); }
  .cv__bar--ph1 .cv__fill { background: linear-gradient(90deg, #f58327, #d65805); }
  .cv__bar--ph0 { border-color: rgb(252 168 0 / .4); }
  .cv__bar--ph1 { border-color: rgb(245 131 39 / .4); }
  .cv__bar--sessions { background-image: repeating-linear-gradient(90deg, rgb(255 255 255 / .08) 0 10px, transparent 10px 16px); }
  .cv__bar--sessions .cv__fill { -webkit-mask: repeating-linear-gradient(90deg, #000 0 10px, transparent 10px 16px); mask: repeating-linear-gradient(90deg, #000 0 10px, transparent 10px 16px); }
  .cv__bar--open { border-style: dashed; border-color: rgb(255 255 255 / .3); border-right: 0; border-radius: 7px 0 0 7px; -webkit-mask: linear-gradient(90deg, #000 60%, transparent); mask: linear-gradient(90deg, #000 60%, transparent); }
  .cv__bar.is-active { box-shadow: 0 0 18px -2px rgb(245 131 39 / .55); }

  .cv__ms { position: absolute; top: 12px; display: flex; align-items: center; gap: 8px; }
  .cv__ms-gem { width: 14px; height: 14px; transform: rotate(45deg); border-radius: 3px; background: var(--color-sun); box-shadow: 0 0 14px rgb(255 210 31 / .6); }
  .cv__ms-label { font-family: var(--font-mono); font-size: 10.5px; color: var(--color-sun); white-space: nowrap; }

  .cv__today { position: absolute; top: 0; bottom: -6px; width: 1px; background: linear-gradient(rgb(245 131 39 / .25), var(--color-flame-400)); }
  .cv__today-tag { position: absolute; top: 100%; left: 50%; transform: translate(-50%, 4px); padding: 2px 8px; border-radius: 99px; background: var(--color-flame-500); color: #1a0d03; font-family: var(--font-mono); font-size: 10px; font-weight: 600; white-space: nowrap; }
  .cv__today::after { content: ''; position: absolute; top: -4px; left: -3.5px; width: 8px; height: 8px; border-radius: 9px; background: var(--color-flame-400); }

  @media (prefers-reduced-motion: no-preference) {
    .cv__fill { animation: cv-fill 1.3s var(--ease-out-expo) both; animation-delay: calc(var(--k) * 110ms + 300ms); }
    .cv__ms-gem { animation: cv-gem 2.8s ease-in-out infinite; }
    .cv__today { animation: cv-today 1.6s var(--ease-out-expo) both .2s; }
    .cv__bar.is-active::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, transparent, rgb(255 255 255 / .35), transparent); transform: translateX(-100%); animation: cv-shine 3.2s ease-in-out infinite 1.8s; }
  }
  @keyframes cv-fill { from { transform: scaleX(0); } to { transform: scaleX(var(--p)); } }
  @keyframes cv-gem { 0%, 100% { box-shadow: 0 0 6px rgb(255 210 31 / .4); } 50% { box-shadow: 0 0 20px rgb(255 210 31 / .9); } }
  @keyframes cv-today { from { opacity: 0; transform: translateX(-40px); } to { opacity: 1; transform: none; } }
  @keyframes cv-shine { 0% { transform: translateX(-100%); } 45%, 100% { transform: translateX(100%); } }
</style>
