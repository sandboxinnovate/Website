---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import type { UnitCopy } from '@/i18n/units';
import type { Lang } from '@/i18n';

interface Props { lang: Lang; copy: UnitCopy; index: string }
const { copy, index } = Astro.props;
const c = copy.cases;
const n = c.items.length;
---
<section class="uc" id="use-cases">
  <div class="container-x">
    <div class="uc__head">
      <SectionHeading index={index} eyebrow={c.eyebrow} title={c.title} lede={c.lede} />
      {c.note && <span class="uc__note mono-label" data-reveal>{c.note}</span>}
    </div>

    <ul class:list={['uc__grid', `uc__grid--${n}`]}>
      {c.items.map((it, i) => (
        <li class="uc__card card card-hover" data-reveal style={`--reveal-delay:${(i % 3) * 90}`}>
          <div class="uc__top">
            <span class="uc__ind">{it.industry}</span>
            <span class="uc__n">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <h3 class="uc__title">{it.title}</h3>
          <p class="uc__body">{it.body}</p>
          <ul class="uc__tags">{it.tags.map((t) => <li>{t}</li>)}</ul>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .uc { padding-block: clamp(64px, 8vw, 112px); }
  .uc__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: clamp(40px, 6vw, 64px); }
  .uc__note { padding: 6px 12px; border-radius: 99px; border: 1px solid var(--line-strong); }
  .uc__grid { display: grid; gap: 14px; grid-template-columns: 1fr; }
  @media (min-width: 700px) { .uc__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1080px) {
    .uc__grid { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .uc__grid > li { grid-column: span 2; }
    .uc__grid--5 > li:nth-child(n+4), .uc__grid--4 > li { grid-column: span 3; }
  }
  @media (min-width: 700px) and (max-width: 1079px) {
    .uc__grid--5 > li:last-child, .uc__grid--3 > li:last-child { grid-column: span 2; }
  }
  .uc__card { display: flex; flex-direction: column; gap: 14px; padding: clamp(22px, 2.4vw, 30px); }
  .uc__top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .uc__ind { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--color-flame-400); }
  .uc__n { font-family: var(--font-mono); font-size: 11px; color: var(--color-smoke); }
  .uc__title { font-size: clamp(1.15rem, 1.6vw, 1.4rem); line-height: 1.2; letter-spacing: -.03em; }
  .uc__body { color: var(--color-mist); font-size: 15.5px; line-height: 1.55; }
  .uc__tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; padding-top: 6px; }
  .uc__tags li { padding: 4px 10px; border-radius: 99px; font-family: var(--font-mono); font-size: 11px; color: var(--color-mist); background: rgb(255 255 255 / .03); border: 1px solid var(--line); }
</style>
