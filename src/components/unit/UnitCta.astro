---
import Icon from '@/components/ui/Icon.astro';
import { UNIT_COMMON } from '@/i18n/units';
import type { UnitCopy } from '@/i18n/units';
import type { UnitMeta } from '@/data/site';
import { SITE } from '@/data/site';
import { localize, type Lang } from '@/i18n';

interface Props { lang: Lang; unit: UnitMeta; copy: UnitCopy }
const { lang, unit, copy } = Astro.props;
const C = UNIT_COMMON.cta;
const showDiagnostic = unit.slug !== 'consulting';
---
<section class="ucta" aria-labelledby="ucta-title">
  <div class="container-x">
    <div class="ucta__band" data-reveal>
      <div class="ucta__glow glow-ember" aria-hidden="true"></div>
      <div class="bg-grid ucta__grid" aria-hidden="true"></div>
      <div class="ucta__top">
        <span class="mono-label">{unit.code} · {unit.name[lang]}</span>
        <span class="mono-label ucta__meta">{C.meta[lang]}</span>
      </div>
      <h2 id="ucta-title" class="ucta__title" set:html={copy.cta.title} />
      <div class="ucta__row">
        <p class="lede ucta__lede">{copy.cta.lede}</p>
        <div class="ucta__ctas">
          <a href={localize(lang, `/contact?service=${unit.slug}`)} class="btn btn-primary">
            <span>{copy.hero.primary}</span><span class="btn-chip"><Icon name="arrow-up-right" size={16} stroke={1.8} /></span>
          </a>
          {showDiagnostic && (
            <a href={localize(lang, '/diagnostic')} class="btn btn-ghost">
              <span>{C.diagnostic[lang]}</span><span class="btn-chip"><Icon name="arrow-right" size={16} stroke={1.8} /></span>
            </a>
          )}
        </div>
      </div>
      <a href={`mailto:${SITE.email}`} class="ucta__mail"><Icon name="mail" size={16} />{SITE.email}</a>
    </div>
  </div>
</section>

<style>
  .ucta { padding-block: clamp(80px, 11vw, 150px) clamp(60px, 8vw, 100px); }
  .ucta__band { position: relative; display: flex; flex-direction: column; gap: clamp(22px, 3vw, 34px); padding: clamp(28px, 5vw, 64px); border-radius: var(--radius-xl2); border: 1px solid rgb(245 131 39 / .28); background: linear-gradient(180deg, rgb(255 255 255 / .035), rgb(255 255 255 / .01)), var(--color-ink-900); overflow: hidden; isolation: isolate; box-shadow: inset 0 1px 0 rgb(255 255 255 / .06); }
  .ucta__glow { z-index: -1; width: 900px; height: 520px; right: -260px; bottom: -300px; opacity: .55; }
  .ucta__grid { position: absolute; inset: 0; z-index: -1; opacity: .5; }
  .ucta__top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; }
  .ucta__meta { color: var(--color-mist); }
  @media (max-width: 560px) { .ucta__meta { display: none; } }
  .ucta__title { font-family: var(--font-display); font-weight: 500; font-size: clamp(2.1rem, 5vw, 4.4rem); line-height: 1; letter-spacing: -.05em; max-width: 16ch; }
  .ucta__title :global(em) { font-style: normal; background: var(--grad-text); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .ucta__row { display: grid; gap: 26px; align-items: end; padding-top: 26px; border-top: 1px solid var(--line); }
  @media (min-width: 1000px) { .ucta__row { grid-template-columns: minmax(0, 1fr) auto; gap: 48px; } }
  .ucta__lede { max-width: 560px; }
  .ucta__ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 480px) { .ucta__ctas .btn { width: 100%; justify-content: space-between; } }
  .ucta__mail { display: inline-flex; align-items: center; gap: 10px; align-self: flex-start; min-height: 40px; font-size: 15px; color: var(--color-mist); }
  .ucta__mail:hover { color: var(--color-bone); }
</style>
