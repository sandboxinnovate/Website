---
/**
 * The proof section of each unit page: a live widget where it adds evidence.
 *   brains     → AgentConsole (compact, next to notes)
 *   consulting → ReadinessDiagnostic teaser (next to notes)
 *   growth     → GeoAnswer (full width)
 *   academy / products / partners → this unit's own islands (full width)
 */
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import AgentConsole from '@/components/widgets/AgentConsole/AgentConsole';
import ReadinessDiagnostic from '@/components/widgets/ReadinessDiagnostic/ReadinessDiagnostic';
import GeoAnswer from '@/components/widgets/GeoAnswer/GeoAnswer';
import AcademyExplorer from './AcademyExplorer/AcademyExplorer';
import ProductsSelector from './ProductsSelector/ProductsSelector';
import PartnersFlow from './PartnersFlow/PartnersFlow';
import type { UnitCopy } from '@/i18n/units';
import type { UnitSlug } from '@/data/site';
import { localize, type Lang } from '@/i18n';

interface Props { lang: Lang; slug: UnitSlug; copy: UnitCopy; index: string }
const { lang, slug, copy, index } = Astro.props;
const d = copy.demo;
const split = slug === 'brains' || slug === 'consulting';
---
<section class:list={['ud', split ? 'ud--split' : 'ud--full', `ud--${slug}`]} id="demo">
  <div class="container-x">
    {split ? (
      <div class="ud__split">
        <div class="ud__copy">
          <SectionHeading index={index} eyebrow={d.eyebrow} title={d.title} lede={d.lede} size="md" />
          {d.notes && (
            <div class="ud__notes" data-reveal>
              {d.notesTitle && <span class="mono-label">{d.notesTitle}</span>}
              <ol>
                {d.notes.map((n, i) => (
                  <li><span class="ud__nn">{String(i + 1).padStart(2, '0')}</span><span>{n}</span></li>
                ))}
              </ol>
            </div>
          )}
          {d.link && (
            <a class="ud__link" href={localize(lang, d.link.href)} data-reveal>
              {d.link.label}<Icon name="arrow-up-right" size={16} />
            </a>
          )}
        </div>
        <div class="ud__stage" data-reveal>
          <div class="glow-ember ud__glow" aria-hidden="true"></div>
          {slug === 'brains' && <AgentConsole client:visible lang={lang} compact initialScenario="lead" />}
          {slug === 'consulting' && (
            <div class="ud__teaser">
              <ReadinessDiagnostic client:visible lang={lang} variant="teaser" />
            </div>
          )}
        </div>
      </div>
    ) : (
      <>
        <div class="ud__head">
          <SectionHeading index={index} eyebrow={d.eyebrow} title={d.title} lede={d.lede} />
        </div>
        <div class="ud__stage" data-reveal>
          <div class="glow-ember ud__glow" aria-hidden="true"></div>
          {slug === 'growth' && <GeoAnswer client:visible lang={lang} />}
          {slug === 'academy' && <AcademyExplorer client:visible lang={lang} />}
          {slug === 'products' && <ProductsSelector client:visible lang={lang} />}
          {slug === 'partners' && <PartnersFlow client:visible lang={lang} />}
        </div>
      </>
    )}
  </div>
</section>

<style>
  .ud { padding-block: clamp(64px, 8vw, 112px); }
  .ud { position: relative; overflow-x: clip; }
  .ud__head { margin-bottom: clamp(36px, 5vw, 64px); }
  .ud__stage { position: relative; isolation: isolate; min-width: 0; }
  .ud__glow { z-index: -1; width: 80%; height: 80%; left: 10%; top: 10%; opacity: .22; }

  .ud__split { display: grid; gap: 40px; align-items: start; }
  @media (min-width: 1080px) {
    .ud__split { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 56px; }
    .ud--consulting .ud__split { grid-template-columns: minmax(0, 1fr) minmax(0, 560px); align-items: center; }
    .ud__copy { position: sticky; top: calc(var(--nav-h) + 40px); }
  }
  .ud__copy { display: flex; flex-direction: column; gap: 32px; }
  .ud__notes { display: flex; flex-direction: column; gap: 14px; }
  .ud__notes ol { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
  .ud__notes li { display: grid; grid-template-columns: 36px 1fr; gap: 8px; padding: 14px 0; border-bottom: 1px solid var(--line); font-size: 16px; line-height: 1.5; color: var(--color-mist); }
  .ud__nn { font-family: var(--font-mono); font-size: 11.5px; color: var(--color-flame-400); padding-top: 3px; }
  .ud__link { display: inline-flex; align-items: center; gap: 8px; align-self: flex-start; min-height: 40px; font-family: var(--font-display); font-size: 12.5px; letter-spacing: .05em; text-transform: uppercase; color: var(--color-flame-400); border-bottom: 1px solid rgb(245 131 39 / .4); }
  .ud__link:hover { color: var(--color-bone); border-color: var(--color-bone); }
  .ud__teaser { width: 100%; max-width: 560px; margin-inline: auto; }
</style>
