---
import Icon from '@/components/ui/Icon.astro';
import { WORK, CASES } from '@/i18n/work';
import type { Lang } from '@/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const h = WORK.hero;
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="wh" aria-labelledby="wh-title">
  <div class="wh__grid bg-grid" aria-hidden="true"></div>
  <div class="wh__glow glow-ember" aria-hidden="true"></div>
  <div class="container-x wh__inner">
    <div class="wh__copy">
      <span class="eyebrow" data-reveal>{h.eyebrow[lang]}</span>
      <h1 id="wh-title" class="wh__title display-xl" data-reveal style="--reveal-delay:80" set:html={h.title[lang]} />
      <p class="lede wh__lede" data-reveal style="--reveal-delay:160">{h.lede[lang]}</p>
    </div>

    <!-- Ledger: every published case with its headline number; each row deep-links to the case -->
    <nav class="wh__ledger" aria-label={h.jump[lang]} data-reveal style="--reveal-delay:240">
      <div class="wh__ledger-head">
        <span class="mono-label">{lang === 'en' ? 'Index' : 'Índice'}</span>
        <span class="mono-label"><b>{pad(CASES.length)}</b> {h.countLabel[lang]}</span>
      </div>
      <ol>
        {CASES.map((c, i) => (
          <li>
            <a href={`#case-${c.id}`} class="wh__row" data-case-link={c.id}>
              <span class="wh__no">{pad(i + 1)}</span>
              <span class="wh__name">{c.client[lang]}</span>
              <span class="wh__metric">+{c.metrics[0].value.replace(/^\+/, '')}</span>
              <Icon name="arrow-right" size={14} class="wh__arrow" />
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>
</section>

<style>
  .wh { position: relative; isolation: isolate; overflow: hidden; padding-top: calc(var(--nav-h) + clamp(48px, 8vw, 112px)); padding-bottom: clamp(56px, 7vw, 96px); }
  .wh__grid { position: absolute; inset: 0; z-index: -2; opacity: .7; }
  .wh__glow { z-index: -1; width: min(820px, 90vw); height: 480px; left: -14%; top: -20%; opacity: .42; }
  .wh__inner { display: grid; gap: 48px; align-items: end; }
  @media (min-width: 1080px) { .wh__inner { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 72px; } }
  .wh__copy { display: flex; flex-direction: column; align-items: flex-start; gap: 26px; }
  .wh__title :global(em) { font-style: normal; background: var(--grad-text); -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: .04em; }
  .wh__lede { max-width: 540px; }

  .wh__ledger { border-radius: 18px; border: 1px solid var(--line); background: rgb(13 12 12 / .8); box-shadow: inset 0 1px 0 rgb(255 255 255 / .05); overflow: hidden; }
  .wh__ledger-head { display: flex; justify-content: space-between; gap: 12px; padding: 14px 18px; border-bottom: 1px solid var(--line); }
  .wh__ledger-head b { color: var(--color-flame-400); font-weight: 500; }
  .wh__row { display: grid; grid-template-columns: 30px 1fr auto 16px; align-items: center; gap: 12px; min-height: 48px; padding: 0 18px; border-bottom: 1px solid var(--line); transition: background-color .25s; }
  li:last-child .wh__row { border-bottom: 0; }
  .wh__no { font-family: var(--font-mono); font-size: 11px; color: var(--color-smoke); }
  .wh__name { font-size: 15px; line-height: 1.3; padding-block: 12px; color: var(--color-mist); transition: color .25s; }
  .wh__metric { font-family: var(--font-mono); font-size: 13px; color: var(--color-flame-400); font-variant-numeric: tabular-nums; }
  .wh__row :global(.wh__arrow) { color: var(--color-smoke); transition: transform .4s var(--ease-out-expo), color .25s; }
  .wh__row:hover, .wh__row:focus-visible { background: rgb(245 131 39 / .05); }
  .wh__row:hover .wh__name, .wh__row:focus-visible .wh__name { color: var(--color-bone); }
  .wh__row:hover :global(.wh__arrow) { transform: translateX(3px); color: var(--color-flame-400); }
  .wh__row:focus-visible { outline-offset: -2px; }
</style>
