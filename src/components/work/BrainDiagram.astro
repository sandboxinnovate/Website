---
/**
 * "What a Sandbox brain looks like": a generic reference architecture (not a client system).
 * Two hand-drawn SVG layouts: a wide pipeline for desktop and a stacked one for small screens.
 */
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import { WORK } from '@/i18n/work';
import { localize, type Lang } from '@/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const b = WORK.brain;
const v = b.svg;
const T = <X,>(o: Record<Lang, X>) => o[lang];

/** Rough text width for chip sizing (Satoshi ≈ .56em per char at these sizes). */
const tw = (s: string, size: number) => Math.round(s.length * size * 0.56);

/** Flow chips left-to-right inside a box, wrapping to new rows. */
function flow(items: string[], x0: number, x1: number, y0: number, size = 12.5, h = 28, gap = 8) {
  let x = x0; let y = y0;
  return items.map((label) => {
    const w = tw(label, size) + 26;
    if (x + w > x1) { x = x0; y += h + gap; }
    const chip = { label, x, y, w, h };
    x += w + gap;
    return chip;
  });
}

/* ---------- Desktop geometry (viewBox 1200 × 520) ---------- */
const D = {
  req: { x: 6, y: 196, w: 162, h: 68 },
  agents: { x: 206, y: 100, w: 350, h: 240 },
  appr: { x: 616, y: 100, w: 180, h: 240 },
  tools: { x: 836, y: 100, w: 200, h: 240 },
  out: { x: 1072, y: 196, w: 122, h: 68 },
  know: { x: 206, y: 392, w: 350, h: 112 },
};
const agentNames = T(v.agentNames);
const dAgents = agentNames.map((n, i) => ({ n, x: D.agents.x + 20 + (i % 2) * 160, y: D.agents.y + 52 + Math.floor(i / 2) * 82, w: 150, h: 70 }));
const dKnow = flow(T(v.knowledgeItems), D.know.x + 20, D.know.x + D.know.w - 20, D.know.y + 42);
// The knowledge box grows with its chips (Spanish labels wrap to more rows); the viewBox follows.
D.know.h = Math.max(...dKnow.map((c) => c.y + c.h)) - D.know.y + 18;
const vbH = Math.max(520, D.know.y + D.know.h + 8);
const decisions = T(v.decisions);
const dDec = decisions.map((n, i) => ({ n, x: D.appr.x + 20, y: D.appr.y + 56 + i * 54, w: D.appr.w - 40, h: 40 }));
const toolItems = T(v.toolItems);
const dTools = toolItems.map((n, i) => ({ n, x: D.tools.x + 16, y: D.tools.y + 46 + i * 30, w: D.tools.w - 32, h: 24 }));
const midY = 230;

/* ---------- Mobile geometry (viewBox 360 × 830) ---------- */
const M = {
  req: { x: 100, y: 8, w: 160, h: 52 },
  agents: { x: 16, y: 100, w: 328, h: 214 },
  know: { x: 16, y: 354, w: 158, h: 204 },
  appr: { x: 186, y: 354, w: 158, h: 204 },
  tools: { x: 16, y: 598, w: 328, h: 148 },
  out: { x: 100, y: 774, w: 160, h: 52 },
};
const mAgents = agentNames.map((n, i) => ({ n, x: M.agents.x + 16 + (i % 2) * 152, y: M.agents.y + 46 + Math.floor(i / 2) * 80, w: 144, h: 70 }));
const mKnow = T(v.knowledgeItems).map((n, i) => ({ n, x: M.know.x + 14, y: M.know.y + 44 + i * 30, w: M.know.w - 28, h: 24 }));
const mDec = decisions.map((n, i) => ({ n, x: M.appr.x + 14, y: M.appr.y + 50 + i * 48, w: M.appr.w - 28, h: 36 }));
const mTools = toolItems.map((n, i) => ({ n, x: M.tools.x + 16 + (i % 2) * 152, y: M.tools.y + 44 + Math.floor(i / 2) * 32, w: 144, h: 26 }));
---
<section class="bd section-y" aria-label={b.eyebrow[lang]} data-brain>
  <div class="container-x">
    <div class="bd__head">
      <SectionHeading index={b.index} eyebrow={b.eyebrow[lang]} title={b.title[lang]} lede={b.lede[lang]} />
      <a href={localize(lang, '/services/brains')} class="btn btn-ghost bd__cta" data-reveal>
        <span>{b.cta[lang]}</span><span class="btn-chip"><Icon name="arrow-up-right" size={16} stroke={1.8} /></span>
      </a>
    </div>

    <figure class="bd__card card" data-reveal>
      <figcaption class="bd__label"><span class="bd__label-dot" aria-hidden="true"></span>{b.label[lang]}</figcaption>

      <div class="bd__stage">
        <!-- Desktop -->
        <svg class="bd__svg bd__svg--wide" viewBox={`0 84 1200 ${vbH - 84}`} role="img" aria-labelledby="bd-t-w bd-d-w">
          <title id="bd-t-w">{T(v.title)}</title>
          <desc id="bd-d-w">{T(v.desc)}</desc>
          <defs>
            <marker id="bd-ar-w" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z" class="bd-arrow" /></marker>
          </defs>

          <!-- edges -->
          <g class="bd-edges">
            <path class="bd-edge bd-flow" d={`M${D.req.x + D.req.w} ${midY} H${D.agents.x - 4}`} marker-end="url(#bd-ar-w)" />
            <path class="bd-edge bd-flow" d={`M381 ${D.agents.y + D.agents.h + 4} V${D.know.y - 4}`} marker-end="url(#bd-ar-w)" marker-start="url(#bd-ar-w)" />
            <path class="bd-edge bd-flow" d={`M${D.agents.x + D.agents.w} ${midY} H${D.appr.x - 4}`} marker-end="url(#bd-ar-w)" />
            <path class="bd-edge bd-flow" d={`M${D.appr.x + D.appr.w} ${midY} H${D.tools.x - 4}`} marker-end="url(#bd-ar-w)" />
            <path class="bd-edge bd-flow" d={`M${D.tools.x + D.tools.w} ${midY} H${D.out.x - 4}`} marker-end="url(#bd-ar-w)" />
            <path class="bd-edge bd-edge--loop bd-flow" d={`M${D.tools.x + D.tools.w / 2} ${D.tools.y + D.tools.h + 4} V448 H${D.know.x + D.know.w + 4}`} marker-end="url(#bd-ar-w)" />
          </g>
          <text class="bd-elabel" x="393" y={(D.agents.y + D.agents.h + D.know.y) / 2 + 4}>{T(v.retrieve)}</text>
          <text class="bd-elabel" x={(D.agents.x + D.agents.w + D.appr.x) / 2} y={midY - 10} text-anchor="middle">{T(v.draft)}</text>
          <text class="bd-elabel bd-elabel--loop" x={(D.know.x + D.know.w + D.tools.x + D.tools.w / 2) / 2} y="438" text-anchor="middle">{T(v.loop)}</text>

          <!-- request -->
          <g class="bd-box bd-s1">
            <rect class="bd-frame" x={D.req.x} y={D.req.y} width={D.req.w} height={D.req.h} rx="34" />
            <text class="bd-name" x={D.req.x + D.req.w / 2} y={D.req.y + 31} text-anchor="middle">{T(v.request)}</text>
            <text class="bd-sub" x={D.req.x + D.req.w / 2} y={D.req.y + 49} text-anchor="middle">{T(v.requestSub)}</text>
          </g>

          <!-- agents -->
          <g class="bd-box bd-s2">
            <rect class="bd-frame" x={D.agents.x} y={D.agents.y} width={D.agents.w} height={D.agents.h} rx="18" />
            <text class="bd-head" x={D.agents.x + 20} y={D.agents.y + 30}>L2 · {T(v.agents)}</text>
            {dAgents.map((a, i) => (
              <g class:list={['bd-agent', `bd-a${i}`]}>
                <rect x={a.x} y={a.y} width={a.w} height={a.h} rx="12" />
                <circle cx={a.x + a.w - 16} cy={a.y + 16} r="3.5" class="bd-led" />
                <text class="bd-name" x={a.x + 16} y={a.y + 32}>{a.n}</text>
                <text class="bd-sub" x={a.x + 16} y={a.y + 52}>{T(v.agentSub)}</text>
              </g>
            ))}
          </g>

          <!-- knowledge -->
          <g class="bd-box bd-s3">
            <rect class="bd-frame" x={D.know.x} y={D.know.y} width={D.know.w} height={D.know.h} rx="18" />
            <text class="bd-head" x={D.know.x + 20} y={D.know.y + 28}>L1 · {T(v.knowledge)}</text>
            {dKnow.map((c) => (
              <g class="bd-chip"><rect x={c.x} y={c.y} width={c.w} height={c.h} rx="14" /><text x={c.x + c.w / 2} y={c.y + 18.5} text-anchor="middle">{c.label}</text></g>
            ))}
          </g>

          <!-- approval -->
          <g class="bd-box bd-s4">
            <rect class="bd-frame bd-frame--gate" x={D.appr.x} y={D.appr.y} width={D.appr.w} height={D.appr.h} rx="18" />
            <text class="bd-head" x={D.appr.x + 20} y={D.appr.y + 30}>L3 · {T(v.approvalShort)}</text>
            {dDec.map((d, i) => (
              <g class:list={['bd-dec', i === 0 && 'bd-dec--yes']}>
                <rect x={d.x} y={d.y} width={d.w} height={d.h} rx="20" />
                <text x={d.x + d.w / 2} y={d.y + 25} text-anchor="middle">{d.n}</text>
              </g>
            ))}
          </g>

          <!-- tools -->
          <g class="bd-box bd-s5">
            <rect class="bd-frame" x={D.tools.x} y={D.tools.y} width={D.tools.w} height={D.tools.h} rx="18" />
            <text class="bd-head" x={D.tools.x + 16} y={D.tools.y + 30}>L4 · {T(v.tools)}</text>
            {dTools.map((t) => (
              <g class="bd-tool"><rect x={t.x} y={t.y} width={t.w} height={t.h} rx="6" /><rect class="bd-tool-ico" x={t.x + 8} y={t.y + 8} width="8" height="8" rx="2" /><text x={t.x + 26} y={t.y + 16.5}>{t.n}</text></g>
            ))}
          </g>

          <!-- outcome -->
          <g class="bd-box bd-s6">
            <rect class="bd-frame bd-frame--out" x={D.out.x} y={D.out.y} width={D.out.w} height={D.out.h} rx="34" />
            <text class="bd-name" x={D.out.x + D.out.w / 2} y={D.out.y + 31} text-anchor="middle">{T(v.outcome)}</text>
            <text class="bd-sub" x={D.out.x + D.out.w / 2} y={D.out.y + 49} text-anchor="middle">{T(v.outcomeSub)}</text>
          </g>
        </svg>

        <!-- Small screens -->
        <svg class="bd__svg bd__svg--tall" viewBox="0 0 360 830" role="img" aria-labelledby="bd-t-m bd-d-m">
          <title id="bd-t-m">{T(v.title)}</title>
          <desc id="bd-d-m">{T(v.desc)}</desc>
          <defs>
            <marker id="bd-ar-m" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z" class="bd-arrow" /></marker>
          </defs>
          <g class="bd-edges">
            <path class="bd-edge bd-flow" d={`M180 ${M.req.y + M.req.h} V${M.agents.y - 4}`} marker-end="url(#bd-ar-m)" />
            <path class="bd-edge bd-flow" d={`M95 ${M.agents.y + M.agents.h + 4} V${M.know.y - 4}`} marker-end="url(#bd-ar-m)" marker-start="url(#bd-ar-m)" />
            <path class="bd-edge bd-flow" d={`M265 ${M.agents.y + M.agents.h} V${M.appr.y - 4}`} marker-end="url(#bd-ar-m)" />
            <path class="bd-edge bd-flow" d={`M312 ${M.appr.y + M.appr.h} V${M.tools.y - 4}`} marker-end="url(#bd-ar-m)" />
            <path class="bd-edge bd-edge--loop bd-flow" d={`M60 ${M.tools.y - 2} V${M.know.y + M.know.h + 4}`} marker-end="url(#bd-ar-m)" />
            <path class="bd-edge bd-flow" d={`M180 ${M.tools.y + M.tools.h} V${M.out.y - 4}`} marker-end="url(#bd-ar-m)" />
          </g>
          <text class="bd-elabel" x="105" y={(M.agents.y + M.agents.h + M.know.y) / 2 + 4}>{T(v.retrieve).split(' ')[0]}</text>
          <text class="bd-elabel" x="275" y={(M.agents.y + M.agents.h + M.appr.y) / 2 + 4}>{T(v.draft)}</text>
          <text class="bd-elabel bd-elabel--loop" x="70" y={(M.know.y + M.know.h + M.tools.y) / 2 + 4}>{T(v.loop)}</text>

          <g class="bd-box bd-s1">
            <rect class="bd-frame" x={M.req.x} y={M.req.y} width={M.req.w} height={M.req.h} rx="26" />
            <text class="bd-name" x="180" y={M.req.y + 24} text-anchor="middle">{T(v.request)}</text>
            <text class="bd-sub" x="180" y={M.req.y + 41} text-anchor="middle">{T(v.requestSub)}</text>
          </g>
          <g class="bd-box bd-s2">
            <rect class="bd-frame" x={M.agents.x} y={M.agents.y} width={M.agents.w} height={M.agents.h} rx="16" />
            <text class="bd-head" x={M.agents.x + 16} y={M.agents.y + 28}>L2 · {T(v.agents)}</text>
            {mAgents.map((a, i) => (
              <g class:list={['bd-agent', `bd-a${i}`]}>
                <rect x={a.x} y={a.y} width={a.w} height={a.h} rx="12" />
                <circle cx={a.x + a.w - 14} cy={a.y + 14} r="3.5" class="bd-led" />
                <text class="bd-name" x={a.x + 14} y={a.y + 32}>{a.n}</text>
                <text class="bd-sub" x={a.x + 14} y={a.y + 52}>{T(v.agentSub)}</text>
              </g>
            ))}
          </g>
          <g class="bd-box bd-s3">
            <rect class="bd-frame" x={M.know.x} y={M.know.y} width={M.know.w} height={M.know.h} rx="16" />
            <text class="bd-head" x={M.know.x + 14} y={M.know.y + 28}>L1 · {T(v.knowledge)}</text>
            {mKnow.map((c) => (
              <g class="bd-chip"><rect x={c.x} y={c.y} width={c.w} height={c.h} rx="12" /><text x={c.x + 12} y={c.y + 16.5}>{c.n}</text></g>
            ))}
          </g>
          <g class="bd-box bd-s4">
            <rect class="bd-frame bd-frame--gate" x={M.appr.x} y={M.appr.y} width={M.appr.w} height={M.appr.h} rx="16" />
            <text class="bd-head" x={M.appr.x + 14} y={M.appr.y + 28}>L3 · {lang === 'en' ? 'Approval' : 'Aprobación'}</text>
            {mDec.map((d, i) => (
              <g class:list={['bd-dec', i === 0 && 'bd-dec--yes']}>
                <rect x={d.x} y={d.y} width={d.w} height={d.h} rx="18" />
                <text x={d.x + d.w / 2} y={d.y + 23} text-anchor="middle">{d.n}</text>
              </g>
            ))}
          </g>
          <g class="bd-box bd-s5">
            <rect class="bd-frame" x={M.tools.x} y={M.tools.y} width={M.tools.w} height={M.tools.h} rx="16" />
            <text class="bd-head" x={M.tools.x + 16} y={M.tools.y + 28}>L4 · {T(v.tools)}</text>
            {mTools.map((t) => (
              <g class="bd-tool"><rect x={t.x} y={t.y} width={t.w} height={t.h} rx="6" /><rect class="bd-tool-ico" x={t.x + 8} y={t.y + 9} width="8" height="8" rx="2" /><text x={t.x + 24} y={t.y + 17.5}>{t.n}</text></g>
            ))}
          </g>
          <g class="bd-box bd-s6">
            <rect class="bd-frame bd-frame--out" x={M.out.x} y={M.out.y} width={M.out.w} height={M.out.h} rx="26" />
            <text class="bd-name" x="180" y={M.out.y + 24} text-anchor="middle">{T(v.outcome)}</text>
            <text class="bd-sub" x="180" y={M.out.y + 41} text-anchor="middle">{T(v.outcomeSub)}</text>
          </g>
        </svg>

        <ol class="bd__points">
          {b.points.map((p) => (
            <li>
              <span class="mono-label bd__k">{p.k}</span>
              <span class="bd__t">{p.t[lang]}</span>
              <span class="bd__d">{p.d[lang]}</span>
            </li>
          ))}
        </ol>
      </div>
    </figure>
  </div>
</section>

<script>
  // Ambient signal animation runs only while the diagram is on screen and the tab is visible.
  document.querySelectorAll<HTMLElement>('[data-brain]').forEach((root) => {
    let onScreen = false;
    const sync = () => root.classList.toggle('is-running', onScreen && !document.hidden);
    new IntersectionObserver(([e]) => { onScreen = e.isIntersecting; sync(); }, { threshold: 0.15 }).observe(root);
    document.addEventListener('visibilitychange', sync);
  });
</script>

<style>
  .bd { border-top: 1px solid var(--line); }
  .bd__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 28px; }
  .bd__cta { flex: none; }

  .bd__card { margin-top: clamp(36px, 5vw, 64px); padding: clamp(18px, 3vw, 36px); overflow: hidden;
    background: radial-gradient(60% 80% at 50% 45%, rgb(217 76 0 / .07), transparent 70%), linear-gradient(180deg, rgb(255 255 255 / .03), rgb(255 255 255 / .005)), var(--color-ink-900); }
  .bd__card::before { content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; opacity: .6;
    background-image: linear-gradient(to right, rgb(255 255 255 / .035) 1px, transparent 1px), linear-gradient(to bottom, rgb(255 255 255 / .035) 1px, transparent 1px); background-size: 32px 32px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, #000 40%, transparent 90%); }
  .bd__label { position: relative; display: inline-flex; align-items: center; gap: 10px; max-width: 100%; font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--color-smoke);
    padding: 6px 12px; border-radius: 99px; border: 1px dashed var(--line-strong); }
  @media (max-width: 640px) { .bd__label { border-radius: 12px; align-items: flex-start; } .bd__label-dot { flex: none; margin-top: 5px; } }
  .bd__label-dot { width: 6px; height: 6px; border-radius: 9px; border: 1px solid var(--color-flame-400); }

  .bd__stage { position: relative; display: grid; gap: 28px; margin-top: 24px; }
  .bd__svg { display: block; width: 100%; height: auto; overflow: visible; }
  .bd__svg--wide { display: none; }
  .bd__svg--tall { max-width: 400px; margin-inline: auto; }
  @media (min-width: 680px) and (max-width: 1099px) {
    .bd__stage { grid-template-columns: minmax(0, 380px) minmax(0, 1fr); align-items: center; gap: 40px; }
  }
  @media (min-width: 1100px) {
    .bd__svg--wide { display: block; }
    .bd__svg--tall { display: none; }
  }

  /* SVG styling */
  .bd__svg text { font-family: var(--font-sans); fill: var(--color-bone); }
  .bd-frame { --bd-stroke: var(--line-strong); fill: rgb(17 16 16 / .9); stroke: var(--bd-stroke); stroke-width: 1; }
  .bd-frame--gate { --bd-stroke: rgb(255 210 31 / .45); stroke-dasharray: 5 4; }
  .bd-frame--out { --bd-stroke: rgb(245 131 39 / .45); fill: rgb(245 131 39 / .08); }
  .bd-head { font-family: var(--font-mono) !important; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; fill: var(--color-smoke) !important; }
  .bd-name { font-size: 15px; font-weight: 500; }
  .bd-sub { font-family: var(--font-mono) !important; font-size: 10.5px; fill: var(--color-smoke) !important; letter-spacing: .04em; }
  .bd-agent rect { fill: var(--color-ink-800); stroke: var(--line); }
  .bd-led { fill: var(--color-ink-500); }
  .bd-chip rect { fill: rgb(255 255 255 / .03); stroke: var(--line-strong); }
  .bd-chip text { font-size: 12.5px; fill: var(--color-mist) !important; }
  .bd-dec rect { fill: transparent; stroke: var(--line-strong); }
  .bd-dec text { font-family: var(--font-mono) !important; font-size: 11.5px; letter-spacing: .06em; text-transform: uppercase; fill: var(--color-mist) !important; }
  .bd-dec--yes rect { fill: rgb(122 209 155 / .08); stroke: rgb(122 209 155 / .55); }
  .bd-dec--yes text { fill: var(--color-ok) !important; }
  .bd-tool rect:first-child { fill: rgb(255 255 255 / .02); stroke: var(--line); }
  .bd-tool-ico { fill: none; stroke: var(--color-flame-400); }
  .bd-tool text { font-size: 12.5px; fill: var(--color-mist) !important; }
  .bd-edge { fill: none; stroke: rgb(245 131 39 / .55); stroke-width: 1.25; }
  .bd-edge--loop { stroke: rgb(255 255 255 / .22); }
  .bd-arrow { fill: var(--color-flame-400); }
  .bd-elabel { font-family: var(--font-mono) !important; font-size: 10.5px; fill: var(--color-flame-300) !important; letter-spacing: .04em; }
  .bd-elabel--loop { fill: var(--color-smoke) !important; }
  .bd__svg--tall .bd-elabel { font-size: 9.5px; }

  /* Ambient run: edges carry dashes, stages light up in sequence (8 s loop). Off when paused or reduced motion. */
  .bd.is-running .bd-flow { stroke-dasharray: 5 6; animation: bd-dash 1.1s linear infinite; }
  .bd.is-running .bd-box > .bd-frame { animation: bd-lit 8s var(--ease-out-expo) infinite; }
  .bd.is-running .bd-s1 > .bd-frame { animation-delay: 0s; }
  .bd.is-running .bd-s2 > .bd-frame { animation-delay: 1s; }
  .bd.is-running .bd-s3 > .bd-frame { animation-delay: 2s; }
  .bd.is-running .bd-s4 > .bd-frame { animation-delay: 3.2s; }
  .bd.is-running .bd-s5 > .bd-frame { animation-delay: 4.6s; }
  .bd.is-running .bd-s6 > .bd-frame { animation-delay: 5.8s; }
  .bd.is-running .bd-led { animation: bd-led 8s steps(1) infinite; }
  .bd.is-running .bd-a1 .bd-led { animation-delay: -2s; }
  .bd.is-running .bd-a2 .bd-led { animation-delay: -4s; }
  .bd.is-running .bd-a3 .bd-led { animation-delay: -6s; }
  @keyframes bd-dash { to { stroke-dashoffset: -22; } }
  @keyframes bd-lit {
    0% { stroke: var(--bd-stroke); filter: none; }
