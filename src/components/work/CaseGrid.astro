---
/**
 * Case studies: unit filter chips + cards; each card opens an accessible <dialog>
 * (challenge → what we did → results). Deep links: /work#case-<id> opens that case.
 */
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import { WORK, CASES } from '@/i18n/work';
import { UNITS, unitBySlug } from '@/data/site';
import { localize, type Lang } from '@/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const w = WORK.cases;
const pad = (n: number) => String(n).padStart(2, '0');
const counts = Object.fromEntries(UNITS.map((u) => [u.slug, CASES.filter((c) => c.unit === u.slug).length]));
const unitLabel = (slug: string) => { const u = unitBySlug(slug); return u ? `${u.code} ${u.name[lang]}` : slug; };
---
<section class="cg section-y" id="cases" aria-label={w.eyebrow[lang]} data-cases data-lang={lang}>
  <div class="container-x">
    <div class="cg__head">
      <SectionHeading index={w.index} eyebrow={w.eyebrow[lang]} title={w.title[lang]} lede={w.lede[lang]} />
    </div>

    <div class="cg__bar" data-reveal>
      <div class="cg__filters" role="group" aria-label={w.filterLabel[lang]}>
        <button type="button" class="cg__chip" data-filter="all" aria-pressed="true">
          {w.all[lang]} <span class="cg__count">{pad(CASES.length)}</span>
        </button>
        {UNITS.map((u) => {
          const n = counts[u.slug];
          return (
            <button type="button" class="cg__chip" data-filter={u.slug} aria-pressed="false"
              aria-disabled={n === 0 ? 'true' : undefined} title={n === 0 ? w.noneYet[lang] : undefined}>
              <span class="cg__chip-code">{u.code}</span>{u.name[lang]} <span class="cg__count">{pad(n)}</span>
            </button>
          );
        })}
      </div>
      <p class="cg__status mono-label" aria-live="polite" data-status>
        {w.showing[lang]} <b data-shown>{pad(CASES.length)}</b> {w.of[lang]} {pad(CASES.length)}
      </p>
    </div>

    <ul class="cg__grid">
      {CASES.map((c, i) => (
        <li class="cg__item" data-unit={c.unit} id={`case-${c.id}`} data-reveal style={`--reveal-delay:${(i % 2) * 110}`}>
          <article class="cg__card">
            <div class="cg__media">
              <img src={c.card} alt={`${w.mockup[lang]} — ${c.client[lang]}`} width="960" height="960" loading="lazy" decoding="async" />
              <span class="cg__unit mono-label">{unitLabel(c.unit)}</span>
              <span class="cg__no mono-label">{w.caseWord[lang]} {pad(i + 1)}</span>
            </div>
            <div class="cg__body">
              <ul class="cg__tags" aria-label={lang === 'en' ? 'Services' : 'Servicios'}>
                {c.tags[lang].map((t) => <li>{t}</li>)}
              </ul>
              <h3 class="cg__title">
                <button type="button" class="cg__open" data-open={c.id} aria-haspopup="dialog" aria-controls={`dlg-${c.id}`}>{c.title[lang]}</button>
              </h3>
              <p class="cg__dek">{c.dek[lang]}</p>
              <dl class="cg__metrics">
                {c.metrics.map((m) => (
                  <div><dt>{m.label[lang]}</dt><dd>{m.value}</dd></div>
                ))}
              </dl>
              <span class="cg__more" aria-hidden="true">{w.open[lang]} <Icon name="arrow-up-right" size={16} /></span>
            </div>
          </article>
        </li>
      ))}

      <li class="cg__item cg__slot" data-unit="brains consulting" data-reveal>
        <div class="cg__slot-inner">
          <span class="mono-label cg__slot-label">{w.slot.label[lang]}</span>
          <div class="cg__slot-units" aria-hidden="true">
            <span>{unitLabel('brains')}</span><span>{unitLabel('consulting')}</span>
          </div>
          <h3 class="cg__slot-title">{w.slot.title[lang]}</h3>
          <p class="cg__slot-body">{w.slot.body[lang]}</p>
          <a href={localize(lang, '/contact')} class="btn btn-ghost btn-sm">
            <span>{w.slot.cta[lang]}</span><span class="btn-chip"><Icon name="arrow-up-right" size={16} stroke={1.8} /></span>
          </a>
        </div>
      </li>
    </ul>
  </div>

  {CASES.map((c, i) => {
    const prev = CASES[(i - 1 + CASES.length) % CASES.length];
    const next = CASES[(i + 1) % CASES.length];
    return (
      <dialog class="cg__dlg" id={`dlg-${c.id}`} aria-labelledby={`dlg-${c.id}-t`} data-dlg={c.id}>
        <div class="cg__sheet">
          <header class="cg__dlg-head">
            <span class="mono-label">{w.caseWord[lang]} {pad(i + 1)} / {pad(CASES.length)} · {unitLabel(c.unit)}</span>
            <div class="cg__dlg-nav">
              <button type="button" class="cg__icon-btn" data-go={prev.id} aria-label={`${w.prev[lang]}: ${prev.title[lang]}`}><Icon name="arrow-left" size={18} /></button>
              <button type="button" class="cg__icon-btn" data-go={next.id} aria-label={`${w.next[lang]}: ${next.title[lang]}`}><Icon name="arrow-right" size={18} /></button>
              <button type="button" class="cg__icon-btn cg__icon-btn--close" data-close aria-label={w.close[lang]}><Icon name="close" size={18} /></button>
            </div>
          </header>

          <div class="cg__dlg-scroll">
            <div class="cg__dlg-top">
              <div class="cg__dlg-intro">
                <ul class="cg__tags">{c.tags[lang].map((t) => <li>{t}</li>)}</ul>
                <h2 id={`dlg-${c.id}-t`} class="cg__dlg-title">{c.title[lang]}</h2>
                <p class="cg__dlg-dek">{c.dek[lang]}</p>
                <p class="cg__dlg-client"><span class="mono-label">{w.client[lang]}</span>{c.client[lang]}</p>
              </div>
              <dl class="cg__dlg-metrics">
                {c.metrics.map((m) => (
                  <div><dt>{m.label[lang]}</dt><dd>{m.value}</dd></div>
                ))}
              </dl>
            </div>

            <figure class="cg__dlg-fig">
              <img src={c.wide.src} alt={`${w.mockup[lang]} — ${c.client[lang]}`} width={c.wide.w} height={c.wide.h} loading="lazy" decoding="async" />
            </figure>

            <div class="cg__dlg-story">
              <section class="cg__part">
                <h3><span class="mono-label">01</span>{w.challenge[lang]}</h3>
                <p>{c.challenge[lang]}</p>
              </section>
              <section class="cg__part">
                <h3><span class="mono-label">02</span>{w.did[lang]}</h3>
                <ol class="cg__did">{c.did[lang].map((d) => <li>{d}</li>)}</ol>
              </section>
              <section class="cg__part cg__part--results">
                <h3><span class="mono-label">03</span>{w.results[lang]}</h3>
                <ul class="cg__res">{c.results[lang].map((r) => <li><Icon name="check" size={16} stroke={2} />{r}</li>)}</ul>
              </section>
            </div>

            <footer class="cg__dlg-foot">
              <span>{WORK.cta.body[lang]}</span>
              <a href={localize(lang, '/contact')} class="btn btn-primary btn-sm">
                <span>{WORK.cta.primary[lang]}</span><span class="btn-chip"><Icon name="arrow-up-right" size={16} stroke={1.8} /></span>
              </a>
            </footer>
          </div>
        </div>
      </dialog>
    );
  })}
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-cases]').forEach((root) => {
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const items = Array.from(root.querySelectorAll<HTMLElement>('.cg__item'));
    const shown = root.querySelector<HTMLElement>('[data-shown]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ---------- Filter ---------- */
    const apply = (f: string) => {
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === f)));
      let n = 0;
      items.forEach((it) => {
        const units = (it.dataset.unit || '').split(' ');
        const isSlot = it.classList.contains('cg__slot');
        const on = f === 'all' ? true : !isSlot && units.includes(f);
        if (on && !isSlot) n++;
        if (on && it.hidden) {
          it.hidden = false;
          if (!reduce) { it.classList.add('is-entering'); requestAnimationFrame(() => requestAnimationFrame(() => it.classList.remove('is-entering'))); }
        } else if (!on) it.hidden = true;
      });
      shown.textContent = String(n).padStart(2, '0');
    };
    chips.forEach((c) => c.addEventListener('click', () => {
      if (c.getAttribute('aria-disabled') === 'true') return;
      apply(c.getAttribute('aria-pressed') === 'true' && c.dataset.filter !== 'all' ? 'all' : c.dataset.filter!);
    }));

    /* ---------- Dialogs ---------- */
    const dialogs = new Map<string, HTMLDialogElement>();
    root.querySelectorAll<HTMLDialogElement>('[data-dlg]').forEach((d) => dialogs.set(d.dataset.dlg!, d));
    let current: string | null = null;
    const base = () => location.pathname + location.search;

    const open = (id: string, focusSel?: string) => {
      const d = dialogs.get(id);
      if (!d) return;
      if (current && current !== id) { const prev = dialogs.get(current); prev?.classList.remove('is-in'); prev?.close(); }
      current = id;
      if (!d.open) d.showModal();
      d.querySelector<HTMLElement>('.cg__dlg-scroll')!.scrollTop = 0;
      requestAnimationFrame(() => d.classList.add('is-in'));
      (d.querySelector<HTMLElement>(focusSel || '[data-close]'))?.focus();
      history.replaceState(null, '', `${base()}#case-${id}`);
    };
    const close = () => {
      if (!current) return;
      const d = dialogs.get(current)!;
      const id = current;
      current = null;
      d.classList.remove('is-in');
      const done = () => { d.close(); root.querySelector<HTMLElement>(`[data-open="${id}"]`)?.focus({ preventScroll: true }); };
      reduce ? done() : window.setTimeout(done, 220);
      history.replaceState(null, '', base());
    };

    root.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) => b.addEventListener('click', () => open(b.dataset.open!)));
    dialogs.forEach((d) => {
      d.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
      d.addEventListener('click', (e) => { if (e.target === d) close(); });
      d.querySelector('[data-close]')!.addEventListener('click', close);
      d.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((b) => b.addEventListener('click', () => {
        const sel = b === b.parentElement!.firstElementChild ? '[data-go]:first-child' : '[data-go]:nth-child(2)';
        open(b.dataset.go!, sel);
      }));
      d.addEventListener('keydown', (e) => {
        if (e.target instanceof HTMLInputElement) return;
        if (e.key === 'ArrowRight') d.querySelector<HTMLButtonElement>('[data-go]:nth-child(2)')?.click();
        if (e.key === 'ArrowLeft') d.querySelector<HTMLButtonElement>('[data-go]:first-child')?.click();
      });
    });

    // Deep links (#case-<id>) — on load, on hash change, and from the index in the page header.
    const fromHash = () => { const m = location.hash.match(/^#case-(.+)$/); if (m && dialogs.has(m[1])) open(m[1]); };
    document.querySelectorAll<HTMLAnchorElement>('[data-case-link]').forEach((a) => a.addEventListener('click', (e) => {
      e.preventDefault();
      open(a.dataset.caseLink!);
    }));
    addEventListener('hashchange', fromHash);
    fromHash();
  });
</script>

<style>
  .cg__bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 24px; margin-top: clamp(36px, 5vw, 56px); padding-bottom: 20px; border-bottom: 1px solid var(--line); }
  .cg__filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .cg__chip { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 14px; border-radius: 99px; border: 1px solid var(--line-strong); background: rgb(255 255 255 / .02);
    font-size: 14px; color: var(--color-mist); cursor: pointer; transition: border-color .25s, background-color .25s, color .25s; }
  .cg__chip:hover:not([aria-disabled='true']) { border-color: rgb(245 131 39 / .5); color: var(--color-bone); }
  .cg__chip[aria-pressed='true'] { background: rgb(245 131 39 / .12); border-color: rgb(245 131 39 / .6); color: var(--color-bone); }
  .cg__chip[aria-disabled='true'] { cursor: not-allowed; color: var(--color-smoke); border-style: dashed; border-color: var(--line); background: transparent; }
  .cg__chip-code { font-family: var(--font-mono); font-size: 10.5px; color: var(--color-smoke); }
  .cg__count { font-family: var(--font-mono); font-size: 11px; padding: 1px 6px; border-radius: 6px; background: rgb(255 255 255 / .05); color: var(--color-mist); }
  .cg__chip[aria-pressed='true'] .cg__count { background: rgb(245 131 39 / .2); color: var(--color-flame-200); }
  .cg__chip[aria-disabled='true'] .cg__count { background: transparent; color: var(--color-ink-500); }
  .cg__status b { color: var(--color-flame-400); font-weight: 500; }

  /* Grid */
  .cg__grid { display: grid; gap: 16px; margin-top: 28px; }
  @media (min-width: 900px) { .cg__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; } }
  .cg__item { transition: opacity .6s var(--ease-out-expo), transform .8s var(--ease-out-expo); }
  .cg__item.is-entering { opacity: 0; transform: translateY(16px) scale(.98); }
  .cg__item[hidden] { display: none; }

  .cg__card { position: relative; height: 100%; display: flex; flex-direction: column; border-radius: var(--radius-card); border: 1px solid var(--line); overflow: hidden;
    background: linear-gradient(180deg, rgb(255 255 255 / .03), rgb(255 255 255 / .005)), var(--color-ink-900); box-shadow: inset 0 1px 0 rgb(255 255 255 / .05);
    transition: border-color .4s, transform .7s var(--ease-out-expo); }
  .cg__card:hover, .cg__card:focus-within { border-color: rgb(245 131 39 / .38); }
  .cg__media { position: relative; aspect-ratio: 16 / 11; overflow: hidden; background: var(--color-ink-800); }
  @media (min-width: 600px) and (max-width: 899px) { .cg__media { aspect-ratio: 16 / 9; } }
  .cg__media img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 45%; filter: saturate(.88) brightness(.9); transform: scale(1.04); transition: transform 1.2s var(--ease-out-expo), filter .6s; }
  .cg__media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(10 10 10 / .35), transparent 28%, transparent 55%, rgb(19 18 18 / .85) 86%, #131212 100%); pointer-events: none; }
  .cg__card:hover .cg__media img, .cg__card:focus-within .cg__media img { transform: scale(1.09); filter: saturate(1) brightness(1); }
  .cg__unit, .cg__no { position: absolute; top: 14px; z-index: 1; padding: 5px 10px; border-radius: 99px; background: rgb(10 10 10 / .72); border: 1px solid var(--line-strong); color: var(--color-bone); backdrop-filter: blur(6px); }
  .cg__unit { left: 14px; }
  .cg__no { right: 14px; color: var(--color-mist); }

  .cg__body { position: relative; display: flex; flex-direction: column; gap: 12px; flex: 1; padding: 22px clamp(20px, 2.4vw, 30px) 26px; margin-top: -32px; z-index: 1; }
  .cg__tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .cg__tags li { font-family: var(--font-mono); font-size: 11px; color: var(--color-flame-300); padding: 3px 9px; border-radius: 99px; background: rgb(245 131 39 / .08); border: 1px solid rgb(245 131 39 / .2); }
  .cg__title { font-size: clamp(1.3rem, 2vw, 1.65rem); line-height: 1.12; letter-spacing: -.03em; }
  .cg__open { text-align: left; font: inherit; letter-spacing: inherit; color: inherit; cursor: pointer; }
  /* Stretched hit area: the whole card opens the case */
  .cg__open::after { content: ""; position: absolute; inset: 0; z-index: 2; border-radius: var(--radius-card); }
  .cg__open:focus-visible { outline: none; }
  .cg__open:focus-visible::after { outline: 2px solid var(--color-flame-400); outline-offset: -2px; }
  .cg__dek { color: var(--color-mist); font-size: 15.5px; max-width: 46ch; }
  .cg__metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: auto; padding-top: 18px; border-top: 1px solid var(--line); }
  .cg__metrics div { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 6px; }
  .cg__metrics dd { white-space: nowrap; font-family: var(--font-display); font-weight: 500; font-size: clamp(1.9rem, 3.4vw, 2.7rem); line-height: 1; letter-spacing: -.045em; background: var(--grad-text); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .cg__metrics dt { font-size: 13.5px; color: var(--color-mist); line-height: 1.35; }
  .cg__more { display: inline-flex; align-items: center; gap: 8px; margin-top: 4px; font-family: var(--font-display); font-size: 11.5px; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; color: var(--color-flame-400); }
  .cg__more :global(svg) { transition: transform .5s var(--ease-out-expo); }
  .cg__card:hover .cg__more :global(svg) { transform: rotate(45deg); }

  /* Slot card for future Brains / Consulting cases */
  .cg__slot-inner { height: 100%; min-height: 280px; display: flex; flex-direction: column; align-items: flex-start; gap: 14px; padding: clamp(24px, 3vw, 36px); border-radius: var(--radius-card); border: 1px dashed var(--line-strong);
    background: repeating-linear-gradient(135deg, rgb(255 255 255 / .012) 0 10px, transparent 10px 20px); }
  .cg__slot-label { color: var(--color-flame-400); }
  .cg__slot-units { display: flex; gap: 8px; }
  .cg__slot-units span { font-family: var(--font-mono); font-size: 11px; color: var(--color-mist); padding: 4px 10px; border-radius: 99px; border: 1px solid var(--line); }
  .cg__slot-title { font-size: clamp(1.3rem, 2vw, 1.65rem); letter-spacing: -.03em; max-width: 18ch; }
  .cg__slot-body { color: var(--color-mist); font-size: 15.5px; max-width: 44ch; margin-bottom: auto; }
  @media (min-width: 900px) { .cg__slot { grid-column: 1 / -1; } .cg__slot-inner { min-height: 0; display: grid; grid-template-columns: 1fr 1.2fr auto; align-items: center; column-gap: 40px; }
    .cg__slot-label, .cg__slot-units { grid-column: 1; } .cg__slot-title { grid-column: 1; } .cg__slot-body { grid-column: 2; grid-row: 1 / span 3; margin: 0; } .cg__slot-inner .btn { grid-column: 3; grid-row: 1 / span 3; } }

  /* ---------- Dialog ---------- */
  .cg__dlg { width: min(1080px, calc(100vw - 32px)); max-width: none; max-height: calc(100dvh - 48px); margin: auto; padding: 0; border: 0; background: transparent; color: var(--color-bone); overflow: visible; }
  .cg__dlg::backdrop { background: rgb(6 5 5 / .78); backdrop-filter: blur(8px); opacity: 0; transition: opacity .3s; }
  .cg__dlg.is-in::backdrop { opacity: 1; }
  .cg__sheet { display: flex; flex-direction: column; max-height: calc(100dvh - 48px); border-radius: 24px; border: 1px solid var(--line-strong); overflow: hidden;
    background: linear-gradient(180deg, rgb(255 255 255 / .03), transparent 30%), var(--color-ink-900); box-shadow: 0 40px 120px -20px rgb(0 0 0 / .9), inset 0 1px 0 rgb(255 255 255 / .06);
    opacity: 0; transform: translateY(24px) scale(.985); transition: opacity .35s var(--ease-out-expo), transform .6s var(--ease-out-expo); }
  .cg__dlg.is-in .cg__sheet { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .cg__sheet, .cg__dlg::backdrop { transition: none; } }
  @media (max-width: 640px) {
    .cg__dlg { width: 100vw; max-height: 94dvh; margin: auto 0 0; }
    .cg__sheet { max-height: 94dvh; border-radius: 22px 22px 0 0; border-bottom: 0; transform: translateY(40px); }
  }
  .cg__dlg-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 10px 10px 22px; border-bottom: 1px solid var(--line); }
  .cg__dlg-nav { display: flex; gap: 6px; }
  .cg__icon-btn { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 99px; border: 1px solid var(--line-strong); color: var(--color-mist); cursor: pointer; transition: color .2s, border-color .2s, background-color .2s; }
  .cg__icon-btn:hover { color: var(--color-bone); border-color: rgb(245 131 39 / .5); }
  .cg__icon-btn--close { background: rgb(255 255 255 / .05); color: var(--color-bone); }
  .cg__dlg-scroll { overflow-y: auto; overscroll-behavior: contain; padding: clamp(22px, 4vw, 44px); display: flex; flex-direction: column; gap: clamp(24px, 4vw, 40px); }
  .cg__dlg-scroll > * { flex-shrink: 0; }

  .cg__dlg-top { display: grid; gap: 24px; }
  @media (min-width: 820px) { .cg__dlg-top { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 48px; align-items: end; } }
  .cg__dlg-intro { display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
  .cg__dlg-title { font-size: clamp(1.7rem, 3.6vw, 2.8rem); letter-spacing: -.04em; }
  .cg__dlg-dek { color: var(--color-mist); font-size: 17px; }
  .cg__dlg-client { display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 10px; font-size: 15px; }
  .cg__dlg-metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; }
  .cg__dlg-metrics div { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 8px; padding: 18px 18px 20px; }
  .cg__dlg-metrics div + div { border-left: 1px solid var(--line); }
  .cg__dlg-metrics dd { white-space: nowrap; font-family: var(--font-display); font-weight: 500; font-size: clamp(1.8rem, 3.4vw, 2.6rem); line-height: 1; letter-spacing: -.045em; background: var(--grad-text); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .cg__dlg-metrics dt { font-size: 13.5px; color: var(--color-mist); line-height: 1.35; }

  .cg__dlg-fig { border-radius: 16px; overflow: hidden; border: 1px solid var(--line); background: var(--color-ink-800); aspect-ratio: 16 / 9; }
  .cg__dlg-fig img { width: 100%; height: 100%; object-fit: cover; }

  .cg__dlg-story { display: grid; gap: 28px; }
  @media (min-width: 820px) { .cg__dlg-story { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; } }
  .cg__part { display: flex; flex-direction: column; gap: 12px; padding-top: 16px; border-top: 1px solid var(--line); }
  .cg__part h3 { display: flex; align-items: baseline; gap: 10px; font-size: 1.05rem; letter-spacing: -.02em; }
  .cg__part p, .cg__did li, .cg__res li { color: var(--color-mist); font-size: 15px; line-height: 1.55; }
