---
/**
 * 404 — "signal lost". Rendered twice: src/pages/404.astro (EN) and src/pages/es/404.astro (ES).
 * Netlify serves the Spanish one for missing /es/ paths (public/_redirects). Hosts that only know
 * /404.html get the English page, whose inline script sends /es/ URLs to /es/404/ before paint,
 * so nav, footer and palette are Spanish too. The requested path is kept for the "last seen" readout.
 */
import Base from '@/layouts/Base.astro';
import Icon from '@/components/ui/Icon.astro';
import { localize, type Lang } from '@/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;

const COPY = {
  en: {
    title: 'Signal lost (404)',
    status: 'ERR_ROUTE_NOT_FOUND',
    h1: 'Signal lost.',
    body: 'Nothing is wired to this address. We checked the sitemap, the redirects and the archive — no answer.',
    cmd1: 'sandbox resolve',
    l1: 'searching sitemap', r1: '0 matches',
    l2: 'checking redirects', r2: 'none',
    l3: 'status', r3: '404 · signal lost',
    cmd2: 'suggest --nearest',
    links: [
      { href: '/', label: 'Home', hint: 'Start over', icon: 'arrow-left' },
      { href: '/#services', label: 'Services', hint: 'Six units', icon: 'layers' },
      { href: '/contact', label: 'Contact', hint: 'Talk to us', icon: 'mail' },
    ],
    search: 'Or search the site',
    scope: { ch: 'CH1 · inbound request', last: 'last seen', freq: 'freq', amp: 'amp' },
  },
  es: {
    title: 'Se perdió la señal (404)',
    status: 'ERR_ROUTE_NOT_FOUND',
    h1: 'Se perdió la señal.',
    body: 'No hay nada conectado a esta dirección. Revisamos el mapa del sitio, las redirecciones y el archivo — sin respuesta.',
    cmd1: 'sandbox resolve',
    l1: 'buscando en el sitemap', r1: '0 coincidencias',
    l2: 'revisando redirecciones', r2: 'ninguna',
    l3: 'estado', r3: '404 · sin señal',
    cmd2: 'suggest --nearest',
    links: [
      { href: '/', label: 'Inicio', hint: 'Empezar de nuevo', icon: 'arrow-left' },
      { href: '/#services', label: 'Servicios', hint: 'Seis unidades', icon: 'layers' },
      { href: '/contact', label: 'Contacto', hint: 'Escríbenos', icon: 'mail' },
    ],
    search: 'O busca en el sitio',
    scope: { ch: 'CH1 · solicitud entrante', last: 'última señal', freq: 'frec', amp: 'amp' },
  },
} as const;

/* Oscilloscope trace: a healthy wave that decays into a flatline. */
const pts: string[] = [];
for (let x = 0; x <= 640; x += 2) {
  const amp = x < 210 ? 54 : x < 360 ? 54 * Math.pow(1 - (x - 210) / 150, 1.6) : 0;
  const jitter = x > 360 && x % 46 === 0 ? 1.5 : 0;
  const y = 110 + amp * Math.sin(x / 15) * (0.85 + 0.15 * Math.sin(x / 47)) + jitter;
  pts.push(`${x === 0 ? 'M' : 'L'}${x} ${y.toFixed(1)}`);
}
const trace = pts.join(' ');
---
<Base lang={lang} title={COPY[lang].title} description={lang === 'es' ? 'Esta página no está conectada a nada. Vuelve al inicio, explora los servicios o contacta a Sandbox.' : 'This page is not wired to anything. Go back home, explore services or contact Sandbox.'} noindex>
  <script is:inline>
    (function () {
      // English 404 served for a missing /es/ URL (hosts without per-language 404s): go to the Spanish one.
      var p = location.pathname;
      if (document.documentElement.lang === 'en' && /^\/es(\/|$)/.test(p) && !/^\/es\/404(\/|$)/.test(p)) {
        try { sessionStorage.setItem('sbx:404-from', p); } catch (e) {}
        location.replace('/es/404/');
      }
    })();
  </script>

  <section class="nf" data-nf>
    <div class="nf__grid bg-grid" aria-hidden="true"></div>
    <div class="nf__glow glow-ember" aria-hidden="true"></div>

    <div class="container-x nf__inner">
      {[lang].map((l) => {
        const c = COPY[l];
        return (
          <div class="nf__copy">
            <p class="nf__status mono-label"><span class="nf__led" aria-hidden="true"></span>{c.status} · 404</p>
            <h1 id={`nf-title-${l}`} class="nf__title display-xl">{c.h1}</h1>
            <p class="lede nf__body">{c.body}</p>

            <div class="nf__term" role="log" aria-label="Terminal">
              <p class="nf__ln"><span class="nf__pr" aria-hidden="true">$</span> {c.cmd1} <span class="nf__path" data-path>/…</span></p>
              <p class="nf__ln nf__ln--out"><span>↳ {c.l1}</span><span class="nf__dots" aria-hidden="true"></span><span class="nf__r">{c.r1}</span></p>
              <p class="nf__ln nf__ln--out"><span>↳ {c.l2}</span><span class="nf__dots" aria-hidden="true"></span><span class="nf__r">{c.r2}</span></p>
              <p class="nf__ln nf__ln--out"><span>↳ {c.l3}</span><span class="nf__dots" aria-hidden="true"></span><span class="nf__r nf__r--err">{c.r3}</span></p>
              <p class="nf__ln"><span class="nf__pr" aria-hidden="true">$</span> {c.cmd2}<span class="nf__caret" aria-hidden="true"></span></p>
            </div>

            <nav class="nf__links" aria-label={l === 'en' ? 'Where to go next' : 'Adónde ir'}>
              {c.links.map((k) => (
                <a href={localize(l, k.href)} class="nf__link">
                  <span class="nf__link-ico"><Icon name={k.icon} size={18} /></span>
                  <span class="nf__link-txt"><span class="nf__link-l">{k.label}</span><span class="nf__link-h">{k.hint}</span></span>
                  <Icon name="arrow-up-right" size={16} class="nf__link-arrow" />
                </a>
              ))}
            </nav>
            <button type="button" class="nf__search" data-search>
              <Icon name="search" size={16} />{c.search}<span class="kbd" data-kbd>⌘K</span>
            </button>
          </div>
        );
      })}

      <!-- Oscilloscope: the request's signal decays into a flatline -->
      <div class="nf__scope" aria-hidden="true">
        <div class="nf__scope-head">
          <span class="mono-label">{COPY[lang].scope.ch}</span>
          <span class="nf__rec"><i></i>REC</span>
        </div>
        <div class="nf__screen">
          <span class="nf__big">404</span>
          <svg viewBox="0 0 640 220" preserveAspectRatio="none" class="nf__svg">
            <path class="nf__trace-glow" d={trace} pathLength="1" />
            <path class="nf__trace" d={trace} pathLength="1" />
            <line x1="0" y1="110" x2="640" y2="110" class="nf__axis" />
          </svg>
          <span class="nf__sweep"></span>
        </div>
        <div class="nf__read">
          <div class="nf__read-row">
            <span>{COPY[lang].scope.amp} <b>0.00</b></span>
            <span>{COPY[lang].scope.freq} <b>—</b></span>
            <span class="nf__read-last">{COPY[lang].scope.last} <b data-path>/…</b></span>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-nf]');
  if (root) {
    // Show the requested path (as text, never as HTML). After the EN → /es/404/ hop, use the original one.
    let from: string | null = null;
    try { from = sessionStorage.getItem('sbx:404-from'); sessionStorage.removeItem('sbx:404-from'); } catch { /* storage blocked */ }
    let path = from || location.pathname;
    try { path = decodeURIComponent(path); } catch { /* malformed escape: show it raw */ }
    path = path.slice(0, 48) || '/';
    root.querySelectorAll<HTMLElement>('[data-path]').forEach((el) => (el.textContent = path));
    // Platform-aware shortcut hint, and open the global command palette.
    const mac = /Mac|iPhone|iPad/.test(navigator.userAgent);
    root.querySelectorAll<HTMLElement>('[data-kbd]').forEach((el) => (el.textContent = mac ? '⌘K' : 'Ctrl K'));
    root.querySelectorAll<HTMLButtonElement>('[data-search]').forEach((b) => b.addEventListener('click', () => window.dispatchEvent(new CustomEvent('sbx:cmdk'))));
    // Terminal lines appear one by one (static when reduced motion is on).
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.classList.add('is-typing');
      root.querySelectorAll<HTMLElement>('.nf__term').forEach((t) => {
        t.querySelectorAll<HTMLElement>('.nf__ln').forEach((ln, i) => window.setTimeout(() => ln.classList.add('is-on'), 350 + i * 420));
      });
    }
    // Ambient animation pauses in background tabs.
    const sync = () => root.classList.toggle('is-paused', document.hidden);
    document.addEventListener('visibilitychange', sync);
  }
</script>

<style>

  .nf { position: relative; isolation: isolate; overflow: hidden; min-height: calc(100svh - 40px); display: flex; align-items: center; padding-top: calc(var(--nav-h) + clamp(40px, 6vw, 80px)); padding-bottom: clamp(64px, 8vw, 112px); }
  .nf__grid { position: absolute; inset: 0; z-index: -2; }
  .nf__glow { z-index: -1; width: min(760px, 90vw); height: 460px; right: -10%; top: 18%; opacity: .45; }
  .nf__inner { display: grid; gap: clamp(48px, 6vw, 80px); align-items: center; }
  .nf__inner > * { min-width: 0; }
  @media (min-width: 1024px) { .nf__inner { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); } }

  .nf__copy { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }
  .nf__status { display: inline-flex; align-items: center; gap: 10px; color: var(--color-err); }
  .nf__led { width: 7px; height: 7px; border-radius: 9px; background: var(--color-err); box-shadow: 0 0 10px var(--color-err); animation: nf-blink 1.4s steps(1) infinite; }
  @keyframes nf-blink { 50% { opacity: .25; } }
  .nf__title { max-width: 10ch; }
  .nf__body { max-width: 520px; }

  .nf__term { width: 100%; max-width: 560px; padding: 16px 18px; border-radius: 14px; border: 1px solid var(--line); background: rgb(13 12 12 / .85); font-family: var(--font-mono); font-size: 13px; line-height: 1.9; color: var(--color-mist); box-shadow: inset 0 1px 0 rgb(255 255 255 / .04); }
  .nf__ln { display: flex; gap: 8px; align-items: baseline; white-space: nowrap; overflow: hidden; }
  .nf__ln--out { padding-left: 14px; color: var(--color-smoke); }
  @media (max-width: 480px) { .nf__term { font-size: 11.5px; padding: 14px; } .nf__ln--out { padding-left: 6px; } }
  .nf__pr { color: var(--color-flame-400); }
  .nf__path { color: var(--color-bone); overflow: hidden; text-overflow: ellipsis; }
  .nf__dots { flex: 1; min-width: 16px; border-bottom: 1px dotted var(--color-ink-500); transform: translateY(-4px); }
  .nf__r { color: var(--color-mist); }
  .nf__r--err { color: var(--color-err); }
  .nf__caret { display: inline-block; width: 8px; height: 15px; margin-left: 2px; background: var(--color-flame-400); transform: translateY(2px); animation: nf-blink 1.05s steps(1) infinite; }
  .nf.is-typing .nf__ln { opacity: 0; transform: translateY(4px); transition: opacity .35s, transform .5s var(--ease-out-expo); }
  .nf.is-typing .nf__ln.is-on { opacity: 1; transform: none; }

  .nf__links { display: grid; gap: 10px; width: 100%; max-width: 560px; }
  @media (min-width: 560px) { .nf__links { grid-template-columns: repeat(3, 1fr); } }
  .nf__link { display: flex; align-items: center; gap: 12px; min-height: 56px; padding: 12px 14px; border-radius: 14px; border: 1px solid var(--line-strong); background: rgb(255 255 255 / .02); transition: border-color .25s, background-color .25s; }
  .nf__link:hover { border-color: rgb(245 131 39 / .5); background: rgb(245 131 39 / .06); }
  .nf__link-ico { display: grid; place-items: center; flex: none; width: 34px; height: 34px; border-radius: 10px; background: rgb(245 131 39 / .1); color: var(--color-flame-400); }
  .nf__link-txt { display: flex; flex-direction: column; line-height: 1.2; min-width: 0; flex: 1; }
  .nf__link-l { font-weight: 500; color: var(--color-bone); }
  .nf__link-h { font-size: 12.5px; color: var(--color-smoke); }
  .nf__link :global(.nf__link-arrow) { flex: none; color: var(--color-smoke); transition: transform .4s var(--ease-out-expo), color .2s; }
  .nf__link:hover :global(.nf__link-arrow) { transform: rotate(45deg); color: var(--color-flame-400); }
  .nf__search { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; color: var(--color-mist); font-size: 15px; cursor: pointer; }
  .nf__search:hover { color: var(--color-bone); }

  /* Scope */
  .nf__scope { border-radius: var(--radius-card); border: 1px solid var(--line); background: linear-gradient(180deg, rgb(255 255 255 / .03), transparent), var(--color-ink-900); padding: 16px; box-shadow: inset 0 1px 0 rgb(255 255 255 / .05), 0 40px 80px -40px rgb(0 0 0 / .8); }
  .nf__scope-head { display: flex; justify-content: space-between; align-items: center; padding: 2px 4px 14px; }
  .nf__rec { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 10.5px; color: var(--color-smoke); letter-spacing: .1em; }
  .nf__rec i { width: 6px; height: 6px; border-radius: 9px; background: var(--color-err); animation: nf-blink 1.4s steps(1) infinite; }
  .nf__screen { position: relative; aspect-ratio: 16 / 10; border-radius: 12px; overflow: hidden; background: radial-gradient(80% 70% at 50% 50%, rgb(217 76 0 / .1), transparent 70%), #0b0a0a; border: 1px solid var(--line);
    background-image: linear-gradient(to right, rgb(255 255 255 / .05) 1px, transparent 1px), linear-gradient(to bottom, rgb(255 255 255 / .05) 1px, transparent 1px), radial-gradient(80% 70% at 50% 50%, rgb(217 76 0 / .12), transparent 70%);
    background-size: 10% 12.5%, 10% 12.5%, 100% 100%; }
  .nf__big { position: absolute; inset: 0; display: grid; place-items: center; font-family: var(--font-display); font-weight: 600; font-size: clamp(5rem, 15vw, 11rem); letter-spacing: -.06em; color: transparent; -webkit-text-stroke: 1px rgb(255 132 66 / .22); user-select: none; }
  .nf__svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .nf__axis { stroke: rgb(255 255 255 / .1); stroke-dasharray: 2 4; }
  .nf__trace, .nf__trace-glow { fill: none; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .nf__trace { stroke: var(--color-flame-400); stroke-width: 2; }
  .nf__trace-glow { stroke: rgb(245 131 39 / .35); stroke-width: 8; filter: blur(4px); }
  .nf__sweep { position: absolute; top: 0; bottom: 0; left: 0; width: 22%; background: linear-gradient(90deg, transparent, rgb(255 132 66 / .08) 80%, rgb(255 132 66 / .22)); border-right: 1px solid rgb(255 132 66 / .5); transform: translateX(-100%); }
  @media (prefers-reduced-motion: no-preference) {
    .nf__trace, .nf__trace-glow { stroke-dasharray: 1; animation: nf-draw 5s var(--ease-out-expo) infinite; }
    .nf__sweep { animation: nf-sweep 5s linear infinite; }
  }
  .nf.is-paused .nf__trace, .nf.is-paused .nf__trace-glow, .nf.is-paused .nf__sweep, .nf.is-paused .nf__led { animation-play-state: paused; }
  @keyframes nf-draw { 0% { stroke-dashoffset: 1; opacity: 1; } 70% { stroke-dashoffset: 0; opacity: 1; } 92% { opacity: 1; } 100% { stroke-dashoffset: 0; opacity: 0; } }
  @keyframes nf-sweep { 0% { transform: translateX(-100%); } 75%, 100% { transform: translateX(460%); } }
  .nf__read { padding: 14px 4px 2px; }
  .nf__read-row { display: flex; flex-wrap: wrap; gap: 8px 22px; font-family: var(--font-mono); font-size: 11.5px; color: var(--color-smoke); }
  .nf__read-row b { color: var(--color-mist); font-weight: 400; }
  .nf__read-last { margin-left: auto; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) { .nf__led, .nf__rec i, .nf__caret { animation: none; } }
</style>
