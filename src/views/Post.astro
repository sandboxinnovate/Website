---
/**
 * Blog post template (routes: src/pages/blog/[slug].astro, src/pages/es/blog/[slug].astro).
 * header (crumbs, meta, title, dek, cover) → takeaways → TOC rail + prose + share rail → FAQ
 * → tags/share → newsletter → unit CTA → related posts.
 */
import '@/styles/prose.css';
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/ui/Icon.astro';
import PostCover from '@/components/blog/PostCover.astro';
import PostCard from '@/components/blog/PostCard.astro';
import ShareLinks from '@/components/blog/ShareLinks.astro';
import BlogNewsletter from '@/components/blog/BlogNewsletter.astro';
import { BLOG } from '@/i18n/blog';
import { UI } from '@/i18n/ui';
import { localize, type Lang } from '@/i18n';
import { SITE } from '@/data/site';
import {
  blogIndexHref, countWords, findTranslation, formatDate, isoDate, postHref, readingMinutes, relatedPosts, unitOf, type Post,
} from '@/lib/blog';
import { ogImagePath } from '@/lib/og';
import { coverFor } from '@/data/blog-covers';

interface Props { lang: Lang; post: Post }
const { lang, post } = Astro.props;
const t = <T,>(o: Record<Lang, T>) => o[lang];
const P = BLOG.post;
const d = post.data;
const unit = unitOf(post);
const other: Lang = lang === 'en' ? 'es' : 'en';

const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 && h.slug !== 'footnote-label');
const translation = await findTranslation(post);
const related = await relatedPosts(post, 3);

const href = postHref(post);
const url = new URL(href, SITE.url).href;
const blogUrl = new URL(blogIndexHref(lang), SITE.url).href;
const alternates: Partial<Record<Lang, string>> = { [lang]: href };
if (translation) alternates[other] = postHref(translation);
const langHref = translation ? postHref(translation) : blogIndexHref(other);
const minutes = readingMinutes(post);
const published = isoDate(d.date);
const og = ogImagePath(d.translationKey);
const cover = coverFor(d.translationKey);
const unitHref = localize(lang, `/services/${unit.slug}/`);
const cta = BLOG.cta[unit.slug];
const longTitle = d.title.length > 54;

const orgRef = { '@id': 'https://sandboxinnovate.com/#organization' };
const articleLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${url}#article`,
  headline: d.title,
  description: d.description,
  inLanguage: lang,
  datePublished: published,
  dateModified: published,
  url,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  image: new URL(og, SITE.url).href,
  author: { '@type': 'Organization', name: 'Sandbox', url: 'https://sandboxinnovate.com/' },
  publisher: orgRef,
  articleSection: unit.name[lang],
  keywords: d.tags.join(', '),
  wordCount: countWords(post.body),
  timeRequired: `PT${minutes}M`,
  isPartOf: { '@type': 'Blog', name: t(BLOG.name), url: blogUrl, publisher: orgRef },
};
if (translation) {
  const tUrl = `${new URL(postHref(translation), SITE.url).href}#article`;
  articleLd[lang === 'en' ? 'workTranslation' : 'translationOfWork'] = { '@id': tUrl };
}
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Sandbox', item: new URL(localize(lang, '/'), SITE.url).href },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: blogUrl },
    { '@type': 'ListItem', position: 3, name: d.title, item: url },
  ],
};
const faqLd = d.faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    }
  : null;
const jsonLd = [articleLd, breadcrumbLd, ...(faqLd ? [faqLd] : [])];
const tocItems = [
  ...toc.map((h, i) => ({ href: `#${h.slug}`, text: h.text, n: String(i + 1).padStart(2, '0') })),
  ...(d.faq?.length ? [{ href: '#faq', text: t(P.faqEyebrow), n: '?' }] : []),
];
---
<Base
  lang={lang}
  title={d.title}
  description={d.description}
  jsonLd={jsonLd}
  alternates={alternates}
  langHref={langHref}
  ogType="article"
  ogImage={og}
  ogImageAlt={cover ? cover.alt[lang] : d.title}
  article={{ published, section: unit.name[lang], tags: d.tags }}
>
  <div class="prog" aria-hidden="true"><span class="prog__bar" data-progress></span></div>

  <article class="post" data-post aria-labelledby="post-title">
    <header class="ph">
      <div class="ph__bg" aria-hidden="true">
        <div class="bg-grid ph__grid"></div>
        <div class="glow-ember ph__glow"></div>
      </div>
      <div class="container-x ph__inner">
        <div class="ph__head">
          <nav class="ph__crumbs" aria-label={t(P.breadcrumb)}>
            <ol>
              <li><a href={blogIndexHref(lang)}>Blog</a></li>
              <li class="ph__sep" aria-hidden="true">/</li>
              <li><a href={`${blogIndexHref(lang)}#${unit.slug}`}>{unit.name[lang]}</a></li>
            </ol>
          </nav>
          <h1 id="post-title" class:list={['ph__title', longTitle && 'ph__title--long']}>{d.title}</h1>
          <p class="lede ph__dek">{d.dek}</p>
          <ul class="ph__meta">
            <li><a class="ph__unit" href={unitHref}><Icon name={unit.icon} size={15} />{unit.code} · {unit.name[lang]}</a></li>
            <li><Icon name="calendar" size={15} /><time datetime={published}>{formatDate(d.date, lang)}</time></li>
            <li><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></svg>{P.minRead[lang](minutes)}</li>
            <li class="ph__by">{t(P.by)} <span>Sandbox</span></li>
          </ul>
        </div>
      </div>
      <div class="container-x">
        <figure class="ph__fig">
          <PostCover seed={d.translationKey} unit={d.unit} variant="hero" ratio="21 / 9" lang={lang} class="ph__cover" />
          {cover && (
            <figcaption class="ph__credit">
              {lang === 'es' ? 'Foto' : 'Photo'}: <a href={cover.credit.url} rel="noopener">{cover.credit.name}</a> / <a href={cover.credit.photoPage} rel="noopener">Unsplash</a>
            </figcaption>
          )}
        </figure>
      </div>
    </header>

    <div class="container-x pl">
      {tocItems.length > 1 && (
        <aside class="pl__toc" aria-labelledby="toc-rail-title">
          <nav class="toc" data-toc>
            <p id="toc-rail-title" class="mono-label toc__title">{t(P.toc)}</p>
            <ol class="toc__list">
              {tocItems.map((it) => (
                <li><a href={it.href} data-toc-link><span class="toc__n" aria-hidden="true">{it.n}</span><span class="toc__text">{it.text}</span></a></li>
              ))}
            </ol>
            <a class="toc__top" href="#main"><Icon name="arrow-up-right" size={14} class="toc__top-ico" />{lang === 'en' ? 'Back to top' : 'Volver arriba'}</a>
          </nav>
        </aside>
      )}

      <div class="pl__main">
        <section class="tk" aria-labelledby="tk-title">
          <h2 id="tk-title" class="mono-label tk__title"><Icon name="spark" size={15} />{t(P.takeaways)}</h2>
          <ul class="tk__list">
            {d.takeaways.map((k) => <li><Icon name="check" size={16} stroke={2} /><span>{k}</span></li>)}
          </ul>
        </section>

        {tocItems.length > 1 && (
          <details class="toc-m" data-toc-mobile>
            <summary>
              <span class="mono-label toc-m__label">{t(P.tocShort)}</span>
              <span class="toc-m__current" data-toc-current>{tocItems[0].text}</span>
              <Icon name="chevron-down" size={16} stroke={2} class="toc-m__chev" />
            </summary>
            <ol class="toc-m__list">
              {tocItems.map((it) => (
                <li><a href={it.href} data-toc-link><span class="toc__n" aria-hidden="true">{it.n}</span><span>{it.text}</span></a></li>
              ))}
            </ol>
          </details>
        )}

        <div class="prose" data-prose>
          <Content />
        </div>

        {d.faq?.length && (
          <section class="pfaq" id="faq" aria-labelledby="pfaq-title">
            <div class="pfaq__head">
              <span class="mono-label pfaq__eb">{t(P.faqEyebrow)}</span>
              <h2 id="pfaq-title" class="pfaq__title" set:html={t(P.faqTitle)} />
            </div>
            <div class="pfaq__list">
              {d.faq.map((f, i) => (
                <details class="pfaq__item" name="post-faq">
                  <summary>
                    <span class="pfaq__n mono-label">{String(i + 1).padStart(2, '0')}</span>
                    <span class="pfaq__q">{f.q}</span>
                    <span class="pfaq__icon" aria-hidden="true"><Icon name="plus" size={16} stroke={2} /></span>
                  </summary>
                  <div class="pfaq__a"><p>{f.a}</p></div>
                </details>
              ))}
            </div>
          </section>
        )}

        <footer class="pfoot">
          <div class="pfoot__tags">
            <span class="mono-label">{t(P.tags)}</span>
            <ul>{d.tags.map((tag) => <li>{tag}</li>)}</ul>
          </div>
          <ShareLinks lang={lang} url={url} title={d.title} dek={d.dek} variant="row" />
          {!translation && <p class="pfoot__note"><Icon name="globe" size={15} />{t(P.untranslated)}</p>}
        </footer>

        <BlogNewsletter lang={lang} variant="card" id="post-news" />
      </div>

      <aside class="pl__side" aria-label={t(P.shareTitle)}>
        <div class="pl__side-inner">
          <ShareLinks lang={lang} url={url} title={d.title} dek={d.dek} variant="rail" />
        </div>
      </aside>
    </div>
  </article>

  <section class="bcta" aria-labelledby="bcta-title">
    <div class="container-x">
      <div class="bcta__band" data-reveal>
        <div class="bcta__glow glow-ember" aria-hidden="true"></div>
        <div class="bg-grid bcta__grid" aria-hidden="true"></div>
        <div class="bcta__top">
          <span class="mono-label bcta__unit"><Icon name={unit.icon} size={15} />{unit.code} · {unit.name[lang]} — {unit.tagline[lang]}</span>
        </div>
        <h2 id="bcta-title" class="bcta__title" set:html={t(cta.title)} />
        <div class="bcta__row">
          <p class="lede bcta__lede">{t(cta.body)}</p>
          <div class="bcta__ctas">
            <a href={localize(lang, `/contact?service=${unit.slug}`)} class="btn btn-primary">
              <span>{t(UI.cta.primary)}</span><span class="btn-chip"><Icon name="arrow-up-right" size={16} stroke={1.8} /></span>
            </a>
            <a href={unitHref} class="btn btn-ghost">
              <span>{BLOG.cta.see[lang](unit.name[lang])}</span><span class="btn-chip"><Icon name="arrow-right" size={16} stroke={1.8} /></span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="prel" aria-labelledby="prel-title">
      <div class="container-x">
        <div class="prel__head">
          <div class="prel__titles">
            <span class="mono-label prel__eb">{t(P.relatedEyebrow)}</span>
            <h2 id="prel-title" class="prel__title" set:html={t(P.related)} />
          </div>
          <a href={blogIndexHref(lang)} class="prel__all">{t(P.all)}<Icon name="arrow-up-right" size={15} /></a>
        </div>
        <div class:list={['prel__grid', `prel__grid--${related.length}`]}>
          {related.map((p, i) => <PostCard post={p} lang={lang} style={`--reveal-delay:${i * 90}`} />)}
        </div>
      </div>
    </section>
  )}
</Base>

<script>
  const post = document.querySelector<HTMLElement>('[data-post]');
  const prose = document.querySelector<HTMLElement>('[data-prose]');
  if (post && prose) {
    const bar = document.querySelector<HTMLElement>('[data-progress]');
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
    const ids = [...new Set(links.map((a) => decodeURIComponent(a.hash.slice(1))))];
    const targets = ids.map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);
    const current = document.querySelector<HTMLElement>('[data-toc-current]');
    const mobileToc = document.querySelector<HTMLDetailsElement>('[data-toc-mobile]');
    let active = '';

    // Reading progress (over the article body) and the active TOC section, in one rAF per scroll.
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = prose.getBoundingClientRect();
      const vh = window.innerHeight;
      const p = Math.min(1, Math.max(0, (vh * 0.35 - r.top) / Math.max(1, r.height - vh * 0.35)));
      if (bar) bar.style.transform = `scaleX(${p})`;
      const line = vh * 0.3;
      let id = targets.length ? targets[0].id : '';
      for (const el of targets) { if (el.getBoundingClientRect().top <= line) id = el.id; else break; }
      if (id !== active) {
        active = id;
        links.forEach((a) => {
          const on = decodeURIComponent(a.hash.slice(1)) === id;
          a.classList.toggle('is-active', on);
          if (on) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current');
        });
        const link = links.find((a) => decodeURIComponent(a.hash.slice(1)) === id);
        if (current && link) current.textContent = link.querySelector('span:last-child')?.textContent || link.textContent || '';
      }
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    update();

    // Mobile TOC closes after a jump.
    mobileToc?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) mobileToc.open = false; });

    // Copy helpers
    const copy = async (text: string) => {
      try { await navigator.clipboard.writeText(text); return true; } catch {
        try {
          const ta = document.createElement('textarea');
          ta.value = text; ta.setAttribute('readonly', ''); ta.style.cssText = 'position:fixed;top:0;left:0;opacity:0';
          document.body.appendChild(ta); ta.select();
          const ok = (document as unknown as { execCommand(c: string): boolean }).execCommand('copy');
          ta.remove(); return ok;
        } catch { return false; }
      }
    };

    // Code blocks: Copy button
    prose.querySelectorAll<HTMLButtonElement>('[data-copy-code]').forEach((btn) => {
      const label = btn.dataset.label || btn.textContent || 'Copy';
      const done = document.documentElement.lang.startsWith('es') ? 'Copiado' : 'Copied';
      btn.addEventListener('click', async () => {
        const pre = btn.closest('.code-block')?.querySelector('pre');
        if (!pre) return;
        const ok = await copy(pre.innerText.replace(/\n$/, ''));
        btn.textContent = ok ? done : label;
        btn.classList.toggle('is-done', ok);
        window.setTimeout(() => { btn.textContent = label; btn.classList.remove('is-done'); }, 2000);
      });
    });

    // Share: copy link
    document.querySelectorAll<HTMLButtonElement>('[data-share-copy]').forEach((btn) => {
      const status = btn.closest('[data-share]')?.querySelector<HTMLElement>('[data-share-status]');
      btn.addEventListener('click', async () => {
        const ok = await copy(btn.dataset.url || location.href);
        btn.classList.toggle('is-done', ok);
        if (status) status.textContent = ok ? btn.dataset.ok || '' : btn.dataset.fail || '';
        window.setTimeout(() => { btn.classList.remove('is-done'); if (status) status.textContent = ''; }, 2400);
      });
    });

    // Tables: keep the wrapper focusable (keyboard scrolling) only when it actually scrolls.
    const tables = [...prose.querySelectorAll<HTMLElement>('[data-table-wrap]')];
    const fitTables = () => tables.forEach((w) => {
      if (w.scrollWidth > w.clientWidth + 1) w.setAttribute('tabindex', '0'); else w.removeAttribute('tabindex');
    });
    fitTables();
    addEventListener('resize', () => requestAnimationFrame(fitTables), { passive: true });
  }
</script>

<style>
  /* ---------- reading progress ---------- */
  .prog { position: fixed; inset: 0 0 auto 0; z-index: 55; height: 2px; pointer-events: none; }
  .prog__bar { display: block; height: 100%; background: var(--grad-cta); transform: scaleX(0); transform-origin: 0 50%; will-change: transform; }
  :global(.no-js) .prog { display: none; }

  /* ---------- header ---------- */
  .ph { position: relative; padding-top: calc(var(--nav-h) + clamp(32px, 5vw, 64px)); isolation: isolate; }
  .ph__bg { position: absolute; inset: 0 0 30% 0; z-index: -1; overflow: hidden; }
  .ph__grid { position: absolute; inset: 0; opacity: .55; }
  .ph__glow { width: 760px; height: 520px; right: -220px; top: -120px; opacity: .34; }
  .ph__inner { display: grid; }
  .ph__head { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; min-width: 0; }
  @media (min-width: 1200px) { .ph__inner { grid-template-columns: var(--rail) minmax(0, 1fr); column-gap: var(--rail-gap); } .ph__head { grid-column: 2; } }
  .ph__crumbs ol { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 11.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--color-smoke); }
  .ph__crumbs a { display: inline-block; padding-block: 12px; margin-block: -12px; color: var(--color-mist); text-decoration: underline; text-decoration-color: rgb(255 255 255 / .2); text-underline-offset: 4px; transition: color .2s; }
  .ph__crumbs a:hover { color: var(--color-flame-400); }
  .ph__sep { color: var(--color-ink-500); }
  /* H1 tier B (same scale as Unit, Contact and Diagnostic). */
  .ph__title { font-family: var(--font-display); font-weight: 500; font-size: clamp(2.3rem, 4.5vw, 4.25rem); line-height: 1.02; letter-spacing: -.05em; max-width: 18ch; }
  .ph__title--long { font-size: clamp(2rem, 3.7vw, 3.5rem); max-width: 22ch; line-height: 1.05; }
  :global(:lang(es)) .ph__title--long { font-size: clamp(1.9rem, 3.5vw, 3.3rem); }
  .ph__dek { max-width: 46em; }
  .ph__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .ph__meta li { display: inline-flex; align-items: center; gap: 8px; height: 34px; padding: 0 13px 0 11px; border-radius: 999px; border: 1px solid var(--line-strong); background: rgb(255 255 255 / .025);
    font-family: var(--font-mono); font-size: 11.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--color-mist); }
  .ph__meta li :global(svg) { color: var(--color-flame-400); flex: none; }
  .ph__meta li:has(.ph__unit) { padding: 0; border-color: rgb(245 131 39 / .4); background: rgb(245 131 39 / .08); }
  .ph__unit { display: inline-flex; align-items: center; gap: 8px; height: 100%; padding: 0 13px 0 11px; border-radius: inherit; color: var(--color-flame-400); transition: background-color .2s; }
  .ph__unit:hover { background: rgb(245 131 39 / .12); }
  .ph__by span { color: var(--color-bone); }
  .ph :global(.ph__cover) { margin-top: clamp(36px, 5vw, 56px); border-radius: var(--radius-xl2); box-shadow: 0 40px 80px -40px rgb(0 0 0 / .9); }
  @media (max-width: 719px) { .ph :global(.ph__cover) { --pcv-ratio: 16 / 10 !important; border-radius: 18px; } }
  .ph__fig { margin: 0; }
  .ph__credit { margin-top: 12px; text-align: right; font-family: var(--font-mono); font-size: 11px; letter-spacing: .06em; color: var(--color-smoke); }
  .ph__credit a { color: inherit; text-decoration: underline; text-decoration-color: rgb(150 141 135 / .45); text-underline-offset: 3px; transition: color .2s, text-decoration-color .2s; }
  .ph__credit a:hover { color: var(--color-flame-400); text-decoration-color: currentColor; }

  /* ---------- body layout ---------- */
  .post { --rail: 220px; --rail-gap: 56px; }
  @media (min-width: 1200px) and (max-width: 1365px) { .post { --rail: 196px; --rail-gap: 44px; } }
  .pl { display: grid; gap: 0; padding-top: clamp(40px, 6vw, 72px); }
  .pl__main { min-width: 0; width: 100%; max-width: 68ch; margin-inline: auto; display: flex; flex-direction: column; }
  .pl__toc, .pl__side { display: none; }
  @media (min-width: 1200px) {
    .pl { grid-template-columns: var(--rail) minmax(0, 68ch) minmax(0, 1fr); column-gap: var(--rail-gap); align-items: start; }
    .pl__main { grid-column: 2; margin-inline: 0; }
    .pl__toc { display: block; grid-column: 1; grid-row: 1; position: sticky; top: calc(var(--nav-h) + 32px); max-height: calc(100vh - var(--nav-h) - 64px); overflow-y: auto; scrollbar-width: none; }
    .pl__side { display: block; grid-column: 3; grid-row: 1; align-self: stretch; }
    .pl__side-inner { position: sticky; top: calc(var(--nav-h) + 32px); padding-top: 4px; }
    .toc-m { display: none; }
  }

  /* ---------- TOC (rail) ---------- */
  .toc { display: flex; flex-direction: column; gap: 16px; padding-bottom: 8px; }
  .toc__title { color: var(--color-flame-400); }
  .toc__list { display: flex; flex-direction: column; border-left: 1px solid var(--line); }
  .toc__list a { position: relative; display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 4px; padding: 8px 0 8px 14px; font-size: 14px; line-height: 1.4; color: var(--color-smoke); transition: color .2s; }
  .toc__list a::before { content: ''; position: absolute; left: -1px; top: 8px; bottom: 8px; width: 2px; border-radius: 2px; background: var(--color-flame-500); transform: scaleY(0); transition: transform .35s var(--ease-out-expo); }
  .toc__list a:hover { color: var(--color-bone); }
  .toc__list a.is-active { color: var(--color-bone); }
  .toc__list a.is-active::before { transform: scaleY(1); }
  .toc__n { font-family: var(--font-mono); font-size: 11px; letter-spacing: .04em; padding-top: 2px; color: var(--color-ink-500); transition: color .2s; }
  a.is-active .toc__n { color: var(--color-flame-400); }
  .toc__top { display: inline-flex; align-items: center; gap: 8px; margin-top: 6px; font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--color-smoke); }
  .toc__top:hover { color: var(--color-flame-400); }
  .toc__top :global(.toc__top-ico) { transform: rotate(-45deg); }

  /* ---------- TOC (mobile, sticky + collapsible) ---------- */
